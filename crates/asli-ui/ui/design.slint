// The whole look of Asli, built from primitives.
//
// Nothing here comes from a widget library. Every control is a Rectangle, a Text, an Image, a
// TouchArea or a TextInput, so every pixel is ours to shape and the application looks the same,
// and like itself, on all three desktops.
//
// The language: a near black violet ground lit by slow coloured light, surfaces that are white at a
// few percent with one pixel rings instead of fills, a two colour accent that runs as a gradient
// through everything that is on or current, coloured glows rather than grey shadows, and two
// typefaces: Figtree for words, Outfit for headings and numbers. Motion is quick and eased, never
// bouncy on navigation.
//
// Two rules hold this together. Colour never carries meaning on its own, because a state that
// reads only as a hue disappears for anyone who cannot separate those hues, so every state also
// changes a shape, an icon or a label. And every interactive element animates on the same few
// curves, because a control that moves at its own speed reads as a different control.

import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/Figtree-Regular.ttf";
import "fonts/Figtree-Medium.ttf";
import "fonts/Figtree-SemiBold.ttf";
import "fonts/Figtree-Bold.ttf";
import "fonts/Outfit-Regular.ttf";
import "fonts/Outfit-Medium.ttf";
import "fonts/Outfit-SemiBold.ttf";
import "fonts/Outfit-Bold.ttf";

// The palette. Surfaces are white at low alpha over the dark ground, so they pick up whatever
// light is behind them instead of sitting on it as flat grey.
export global Theme {
    // The ground: a vertical gradient from the first to the second.
    out property <color> bg-1: #1A1921;
    out property <color> bg-2: #0F0E14;
    out property <color> titlebar: #0F0E14;
    out property <color> canvas: #0F0E14;
    // A field, sunk into the surface around it.
    out property <color> input: #00000038;
    // Surfaces, lowest first: rest, raised, hover, pressed.
    out property <color> raised-1: #FFFFFF0B;
    out property <color> raised-2: #FFFFFF13;
    out property <color> raised-3: #FFFFFF17;
    out property <color> press: #FFFFFF21;
    out property <color> disabled-fill: #FFFFFF08;
    // Hairlines and rings.
    out property <color> hairline: #FFFFFF14;
    out property <color> border-subtle: #FFFFFF14;
    out property <color> border: #FFFFFF1C;
    out property <color> border-strong: #FFFFFF24;

    out property <color> text: #F3F2F7;
    out property <color> text-2: #A9A7B6;
    out property <color> text-3: #6E6C7B;
    out property <color> text-4: #4E4C5A;
    // Dark text on an accent gradient.
    out property <color> on-accent: #16131A;

    // The accent pair. Every gradient runs from the second to the first.
    out property <color> accent: #6D7CFF;
    out property <color> accent-2: #4FE3C1;
    out property <color> accent-deep: #5563E8;
    out property <color> accent-soft: #6D7CFF29;
    out property <color> accent-border: #6D7CFF73;
    out property <color> focus: #8F9BFF;
    out property <color> link: #A3ADFF;
    out property <brush> accent-fill: @linear-gradient(120deg, #4FE3C1 0%, #6D7CFF 100%);

    out property <color> success: #3DDC97;
    out property <color> success-border: #3DDC9766;
    out property <color> warning: #FFB55A;
    out property <color> warning-border: #FFB55A66;
    out property <color> error: #FF4D5E;
    out property <color> error-border: #FF4D5E66;
    out property <color> danger-soft: #FF8A8F;
    out property <color> danger-deep: #E0404F;

    // The content pane: a faint vertical sheen over the ground.
    out property <color> hero-from: #FFFFFF0E;
    out property <color> hero-to: #FFFFFF05;
    out property <brush> sidebar-fill: transparent;

    // Elevated surfaces: menus, toasts.
    out property <brush> menu-fill: @linear-gradient(180deg, #24222C 0%, #1C1A22 100%);

    // The faces. Figtree for words, Outfit for headings and numbers, JetBrains Mono for codes and
    // ids, so they look the same on every machine.
    out property <string> ui: "Figtree";
    out property <string> display: "Outfit";
    out property <string> mono: "JetBrains Mono";

    // The curves. Quick out for most things; a gentle spring for small presses and knobs.
    out property <duration> quick: 180ms;
}

// A device's operating system, for its mark.
export enum DeviceOs {
    unknown,
    linux,
    mac,
    windows,
}

// The icon set: 24 unit grid, 1.75 stroke, round caps, tinted at the point of use.
export global Icons {
    out property <image> alert: @image-url("icons/alert.svg");
    out property <image> back: @image-url("icons/back.svg");
    out property <image> check: @image-url("icons/check.svg");
    out property <image> chevron-down: @image-url("icons/chevron-down.svg");
    out property <image> copy: @image-url("icons/copy.svg");
    out property <image> device: @image-url("icons/device.svg");
    out property <image> download: @image-url("icons/download.svg");
    out property <image> file: @image-url("icons/file.svg");
    out property <image> bell: @image-url("icons/bell.svg");
    out property <image> network: @image-url("icons/network.svg");
    out property <image> power: @image-url("icons/power.svg");
    // Operating system marks, from Simple Icons (CC0), scaled and centred on the same grid.
    out property <image> os-linux: @image-url("icons/os-linux.svg");
    out property <image> os-apple: @image-url("icons/os-apple.svg");
    out property <image> os-windows: @image-url("icons/os-windows.svg");

    // The mark for a device's operating system, or a plain screen when it is not known.
    public pure function platform(p: DeviceOs) -> image {
        p == DeviceOs.windows ? self.os-windows
            : p == DeviceOs.mac ? self.os-apple
            : p == DeviceOs.linux ? self.os-linux
            : self.device
    }
    out property <image> send: @image-url("icons/send.svg");
    out property <image> history: @image-url("icons/history.svg");
    out property <image> image: @image-url("icons/image.svg");
    out property <image> key: @image-url("icons/key.svg");
    out property <image> offline: @image-url("icons/offline.svg");
    out property <image> paste: @image-url("icons/paste.svg");
    out property <image> pause: @image-url("icons/pause-bars.svg");
    out property <image> play: @image-url("icons/play.svg");
    out property <image> plus: @image-url("icons/plus.svg");
    out property <image> refresh: @image-url("icons/refresh.svg");
    out property <image> settings: @image-url("icons/settings.svg");
    out property <image> shield: @image-url("icons/shield.svg");
    out property <image> spinner: @image-url("icons/spinner.svg");
    out property <image> text: @image-url("icons/text.svg");
    out property <image> trash: @image-url("icons/trash.svg");
    out property <image> win-close: @image-url("icons/win-close.svg");
    out property <image> win-maximize: @image-url("icons/win-maximize.svg");
    out property <image> win-minimize: @image-url("icons/win-minimize.svg");
    out property <image> mark: @image-url("icons/mark.svg");
    out property <image> app-icon: @image-url("icons/app-icon.svg");
    // The soft accent light at the top of the content column. An image because the design's
    // wash is an ellipse, and the toolkit's own radial gradient only draws circles.
    out property <image> wash: @image-url("icons/wash.svg");
}

// The connection state, which drives the status hero, the sidebar footer and the tray together.
export enum SyncState {
    connected,
    connecting,
    offline,
    error,
}

export global States {
    public pure function tint(state: SyncState) -> color {
        if (state == SyncState.connected) {
            return Theme.success;
        }
        if (state == SyncState.connecting) {
            return Theme.accent;
        }
        if (state == SyncState.error) {
            return Theme.error;
        }
        return Theme.text-3;
    }

    public pure function edge(state: SyncState) -> color {
        if (state == SyncState.connected) {
            return Theme.success-border;
        }
        if (state == SyncState.error) {
            return Theme.error-border;
        }
        return Theme.border;
    }

    // Connecting and error breathe, so a state that is still changing never looks settled.
    public pure function pulses(state: SyncState) -> bool {
        return state == SyncState.connecting || state == SyncState.error;
    }
}

// An icon, tinted.
export component Icon inherits Image {
    in property <length> size: 16px;
    in property <color> tint: Theme.text-2;
    width: size;
    height: size;
    colorize: tint;
    image-fit: contain;
}

// A soft shadow or glow, drawn as stacked rounded rectangles.
//
// The software renderer this application uses draws no drop shadows of its own, and a rectangle
// given one loses its rounded corners there. So the shadow is built from layers instead: each a
// little larger and fainter than the last, which reads as a blur. It fills its parent's box and
// spills outside it, and has to come before the thing it shadows so it is drawn underneath.
export component SoftShadow {
    in property <length> radius;
    in property <length> blur: 12px;
    in property <length> spread: 0px;
    in property <length> offset-y: 0px;
    in property <color> tint: #000000;
    // Opacity where the shadow is darkest.
    in property <float> strength: 0.45;
    in property <int> steps: 8;
    width: 100%;
    height: 100%;

    for i in root.steps: Rectangle {
        // Where this layer sits across the blur, from -1 (innermost) to 1 (outermost).
        property <float> at: (i + 0.5) / root.steps * 2 - 1;
        // Spread over twice the blur radius, about where a Gaussian of that blur fades out.
        property <length> grow: root.spread + root.blur * self.at;
        x: -self.grow;
        y: root.offset-y - self.grow;
        width: max(0px, root.width + 2 * self.grow);
        height: max(0px, root.height + 2 * self.grow);
        border-radius: max(0px, root.radius + self.grow);
        // Each layer weighted by the Gaussian at its position, so the edge fades rather than
        // stepping. 0.598 is the mean of that curve over the range, which keeps the total at
        // the requested strength.
        background: root.tint.with-alpha(root.strength * pow(2.71828, -2 * self.at * self.at) / (0.598 * root.steps));
    }
}

// A rounded rectangle filled with a linear gradient. One rectangle on the GPU renderer, which
// rounds gradients itself; the software fallback draws it with square corners, which it accepts.
export component GradientFill {
    in property <color> from;
    in property <color> to;
    // As in CSS: 180deg runs top to bottom.
    in property <angle> angle: 180deg;
    in property <length> radius;

    Rectangle {
        border-radius: root.radius;
        background: @linear-gradient(root.angle, root.from 0%, root.to 100%);
    }
}

// The busy indicator: a quarter arc turning once every 900 ms. Only ever instantiated while
// something is actually busy, because the tick that turns it redraws the window every frame.
export component Spinner {
    in property <length> size: 14px;
    in property <color> tint: Theme.text;
    width: size;
    height: size;

    Image {
        width: root.size;
        height: root.size;
        source: Icons.spinner;
        colorize: root.tint;
        image-fit: contain;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-rotation: mod(animation-tick(), 900ms) / 900ms * 360deg;
    }
}

// The keyboard focus ring: 2 px, 2 px clear of the control, following its corners.
component FocusRing inherits Rectangle {
    in property <bool> shown;
    in property <length> radius;
    border-radius: radius + 4px;
    border-width: 2px;
    border-color: Theme.focus;
    opacity: shown ? 1 : 0;
    animate opacity { duration: 120ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
}

// A coloured glow behind something, pulled in under it so it reads as light the thing gives off
// rather than a shadow it casts. Fills its parent and must come before what it lights. The GPU
// renderer draws it; the software fallback draws nothing, which is the right failure.
export component Glow {
    in property <color> tint: Theme.accent;
    in property <length> radius: 12px;
    in property <length> blur: 24px;
    in property <length> lift: 8px;
    in property <length> inset: 6px;

    Rectangle {
        x: root.inset;
        y: root.inset;
        width: root.width - 2 * root.inset;
        height: root.height - 2 * root.inset;
        border-radius: root.radius;
        background: root.tint.with-alpha(0.01);
        drop-shadow-color: root.tint;
        drop-shadow-blur: root.blur;
        drop-shadow-offset-y: root.lift;
    }
}

export enum ButtonKind {
    primary,
    secondary,
    ghost,
    danger,
    // Secondary at rest, turning red under the pointer. For actions that destroy but are not the
    // point of their screen.
    destructive,
}

// The button. Primary is the accent gradient with dark text and a coloured glow; secondary is a
// soft surface with a hairline ring; ghost is text that gains a surface under the pointer.
export component Button {
    in property <string> text;
    in property <image> icon;
    in property <bool> show-icon: false;
    in property <ButtonKind> kind: ButtonKind.secondary;
    in property <bool> small: false;
    in property <bool> enabled: true;
    in property <bool> busy: false;
    // Holds the pressed look, for "Copied" after a copy.
    in property <bool> latched: false;
    in property <length> pad-x: small ? 12px : 16px;
    callback clicked();

    property <bool> live: enabled && !busy;
    property <bool> hover: touch.has-hover && live;
    property <bool> down: touch.pressed && live;
    property <bool> filled: kind == ButtonKind.primary || kind == ButtonKind.danger;
    property <length> r: small ? 9px : 11px;
    property <color> fg: !enabled
        ? Theme.text-4
        : kind == ButtonKind.primary ? Theme.on-accent
        : kind == ButtonKind.danger ? #FFFFFF
        : kind == ButtonKind.destructive && hover ? Theme.danger-soft
        : kind == ButtonKind.ghost && !hover ? Theme.text-2
        : kind == ButtonKind.destructive ? Theme.text-2
        : hover ? Theme.text : #E4E2EC;

    height: small ? 30px : 36px;
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { if (live) { clicked(); } }

    if root.filled && root.enabled: Glow {
        tint: root.kind == ButtonKind.danger ? Theme.error.with-alpha(0.55) : Theme.accent.with-alpha(root.hover ? 0.75 : 0.55);
        radius: root.r;
        blur: root.hover ? 26px : 20px;
        lift: root.down ? 3px : root.hover ? 8px : 6px;
        inset: root.small ? 4px : 6px;
        animate blur, lift { duration: 220ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    }

    frame := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.r;
        border-width: root.filled && root.enabled ? 0px : 1px;
        background: !enabled
            ? (kind == ButtonKind.ghost ? transparent : Theme.disabled-fill)
            : kind == ButtonKind.primary ? Theme.accent-fill
            : kind == ButtonKind.danger ? @linear-gradient(120deg, #FF7A6A 0%, #FF4D5E 100%)
            : kind == ButtonKind.ghost ? (down ? Theme.press : hover ? Theme.raised-1 : transparent)
            : kind == ButtonKind.destructive ? (down ? #FF4D5E40 : hover ? #FF4D5E2E : Theme.raised-1)
            : (down ? Theme.press : hover ? Theme.raised-3 : Theme.raised-1);
        border-color: !enabled ? Theme.border-subtle
            : kind == ButtonKind.ghost ? transparent
            : kind == ButtonKind.destructive && hover ? Theme.error-border
            : hover ? Theme.border-strong : Theme.border-subtle;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale-x: down && !busy ? 96% : 100%;
        transform-scale-y: down && !busy ? 96% : 100%;
        animate border-color { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate transform-scale-x, transform-scale-y { duration: 200ms; easing: cubic-bezier(0.34, 1.32, 0.5, 1); }

        // The top edge catches the light on a filled button.
        if root.filled && root.enabled: Rectangle {
            x: root.r;
            y: 0px;
            width: parent.width - 2 * root.r;
            height: 1px;
            background: #FFFFFF59;
        }
        // Brighter under the pointer.
        if root.filled && root.enabled: Rectangle {
            border-radius: root.r;
            background: #FFFFFF;
            opacity: root.hover ? 0.08 : 0;
            animate opacity { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        }
        if root.latched: Rectangle {
            border-radius: root.r;
            background: #00000026;
        }

        row := HorizontalLayout {
            padding-left: root.pad-x;
            padding-right: root.pad-x;
            spacing: root.small ? 6px : 8px;
            alignment: center;

            if root.busy: VerticalLayout {
                alignment: center;
                Spinner {
                    size: 14px;
                    tint: root.fg;
                }
            }
            if root.show-icon && !root.busy: VerticalLayout {
                alignment: center;
                Icon {
                    source: root.icon;
                    size: root.small ? 14px : 15px;
                    tint: root.fg;
                }
            }
            Text {
                text: root.text;
                color: root.fg;
                font-size: root.small ? 12px : 13px;
                font-weight: root.filled ? 700 : 600;
                vertical-alignment: center;
                animate color { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
            }
        }
    }

    FocusRing {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        // A click never moves focus here, so the ring appears only for the keyboard.
        shown: focus.has-focus;
        radius: root.r;
    }

    focus := FocusScope {
        enabled: root.live;
        key-pressed(event) => {
            if (root.live && (event.text == " " || event.text == "\n")) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.live;
        mouse-cursor: root.live ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// A 30 by 30 button holding only an icon.
export component IconButton {
    in property <image> icon;
    in property <bool> destructive: false;
    in property <string> label;
    callback clicked();

    width: 30px;
    height: 30px;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }

    Rectangle {
        border-radius: 9px;
        background: touch.pressed ? Theme.press
            : touch.has-hover ? (root.destructive ? #FF4D5E26 : Theme.raised-3) : transparent;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale-x: touch.pressed ? 92% : 100%;
        transform-scale-y: touch.pressed ? 92% : 100%;
        animate background { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate transform-scale-x, transform-scale-y { duration: 200ms; easing: cubic-bezier(0.34, 1.32, 0.5, 1); }

        Icon {
            source: root.icon;
            size: 15px;
            tint: touch.has-hover ? (root.destructive ? Theme.danger-soft : Theme.text) : Theme.text-3;
            animate colorize { duration: 180ms; }
        }
    }

    FocusRing {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        shown: focus.has-focus;
        radius: 9px;
    }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A section label: small, bold, widely tracked capitals. Written in capitals at the call site,
// since text has no transform of its own here.
export component Overline inherits Text {
    in property <bool> danger: false;
    color: danger ? Theme.danger-soft : Theme.text-3;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
}

// A screen title, in the display face.
export component Title inherits Text {
    color: Theme.text;
    font-family: Theme.display;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.6px;
}

// Body copy under a title.
export component Subtitle inherits Text {
    color: Theme.text-2;
    font-size: 13.5px;
    wrap: word-wrap;
}

// Helper text.
export component Caption inherits Text {
    color: Theme.text-3;
    font-size: 12px;
    wrap: word-wrap;
}

// A field label.
export component Label inherits Text {
    color: Theme.text-2;
    font-size: 12.5px;
    font-weight: 600;
}

// The standard card: a faint surface with a hairline ring.
export component Card inherits Rectangle {
    vertical-stretch: 0;
    background: Theme.raised-1;
    border-radius: 18px;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;
}

// A one pixel rule inside a card.
export component Divider inherits Rectangle {
    height: 1px;
    vertical-stretch: 0;
    background: Theme.border-subtle;
}

export enum BannerKind {
    warning,
    error,
    info,
}

// A banner: an icon in a tinted tile, a title and an optional line of explanation, in one of three
// tones. Anything placed inside it sits at its right.
export component Banner inherits Rectangle {
    in property <BannerKind> kind: BannerKind.info;
    in property <string> title;
    in property <string> body;
    in property <image> icon: Icons.alert;
    property <color> tone: kind == BannerKind.warning
        ? Theme.warning
        : kind == BannerKind.error ? Theme.error : Theme.accent;
    property <color> ink: kind == BannerKind.warning
        ? #FFE3BF
        : kind == BannerKind.error ? #FFD0D4 : #DADDFF;

    vertical-stretch: 0;
    border-radius: 16px;
    border-width: 1px;
    background: tone.with-alpha(0.1);
    border-color: tone.with-alpha(0.32);

    HorizontalLayout {
        padding: 12px;
        padding-right: 14px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 10px;
                background: root.tone.with-alpha(0.16);
                Icon {
                    source: root.icon;
                    size: 16px;
                    tint: root.tone;
                }
            }
        }

        VerticalLayout {
            spacing: 2px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: root.ink;
                font-size: 13px;
                font-weight: 700;
                wrap: word-wrap;
            }
            if root.body != "": Text {
                text: root.body;
                color: Theme.text-2;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        @children
    }
}

// The single line field, sunk into its surface.
export component TextField {
    in property <string> placeholder;
    in property <bool> invalid: false;
    in property <bool> monospace: false;
    in property <bool> enabled: true;
    in-out property <string> text;
    callback edited(string);
    callback accepted(string);

    height: 38px;
    vertical-stretch: 0;
    forward-focus: input;

    // A soft halo in the accent while typing.
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 14px;
        border-width: 3px;
        border-color: root.invalid ? #FF4D5E33 : input.has-focus ? #6D7CFF33 : transparent;
        animate border-color { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    }

    frame := Rectangle {
        border-radius: 11px;
        border-width: 1px;
        background: root.enabled ? Theme.input : Theme.disabled-fill;
        border-color: !root.enabled ? Theme.border-subtle
            : root.invalid ? Theme.error
            : input.has-focus ? Theme.accent
            : hover.has-hover ? Theme.border-strong : Theme.border;
        animate border-color { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

        hover := TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => { input.focus(); }
        }

        Text {
            x: 12px;
            width: parent.width - 24px;
            height: 100%;
            vertical-alignment: center;
            text: root.placeholder;
            color: Theme.text-4;
            font-size: root.monospace ? 12px : 13px;
            font-family: root.monospace ? Theme.mono : Theme.ui;
            visible: root.text == "";
            overflow: elide;
        }

        input := TextInput {
            x: 12px;
            width: parent.width - 24px;
            height: 100%;
            vertical-alignment: center;
            text <=> root.text;
            enabled: root.enabled;
            color: root.enabled ? Theme.text : Theme.text-4;
            font-size: root.monospace ? 12px : 13px;
            font-family: root.monospace ? Theme.mono : Theme.ui;
            selection-background-color: #6D7CFF66;
            selection-foreground-color: Theme.text;
            single-line: true;
            wrap: no-wrap;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
        }
    }
}

// The join code field: several lines, monospaced, breaking anywhere.
export component JoinArea {
    in property <string> placeholder;
    in property <bool> invalid: false;
    in property <bool> read-only: false;
    in-out property <string> text;
    callback edited(string);
    callback accepted(string);

    min-height: 72px;
    preferred-height: max(72px, input.preferred-height + 24px);
    vertical-stretch: 0;
    forward-focus: input;

    public function focus-input() {
        input.focus();
    }

    // Replaces whatever is in the field with the clipboard, for the Paste button.
    public function paste-over() {
        input.focus();
        input.select-all();
        input.paste();
    }

    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 17px;
        border-width: 3px;
        border-color: root.invalid ? #FF4D5E33 : input.has-focus && !root.read-only ? #6D7CFF33 : transparent;
        animate border-color { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    }

    Rectangle {
        border-radius: 14px;
        border-width: 1px;
        background: Theme.input;
        border-color: root.invalid ? Theme.error
            : input.has-focus && !root.read-only ? Theme.accent
            : hover.has-hover ? Theme.border-strong : Theme.border;
        opacity: root.read-only ? 0.45 : 1;
        animate border-color { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

        hover := TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => { input.focus(); }
        }

        Text {
            x: 14px;
            y: 12px;
            width: parent.width - 28px;
            text: root.placeholder;
            color: Theme.text-4;
            font-size: 12.5px;
            font-family: Theme.mono;
            letter-spacing: 0.2px;
            visible: root.text == "";
        }

        input := TextInput {
            x: 14px;
            y: 12px;
            width: parent.width - 28px;
            height: parent.height - 24px;
            text <=> root.text;
            read-only: root.read-only;
            color: Theme.text;
            font-size: 12.5px;
            font-family: Theme.mono;
            letter-spacing: 0.2px;
            selection-background-color: #6D7CFF66;
            selection-foreground-color: Theme.text;
            single-line: false;
            wrap: char-wrap;
            edited => { root.edited(self.text); }
            key-pressed(event) => {
                // Enter joins rather than adding a line break nobody wants in a code.
                if (event.text == "\n") {
                    root.accepted(self.text);
                    return accept;
                }
                return reject;
            }
        }
    }
}

// The switch. The knob moves, so the state reads as position and not only as colour, and it
// stretches a little while pressed.
export component Toggle {
    in property <bool> enabled: true;
    in property <string> label;
    in-out property <bool> checked;
    callback toggled(bool);

    width: 40px;
    height: 24px;
    forward-focus: focus;
    accessible-role: switch;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { flip(); }

    function flip() {
        if (root.enabled) {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    if root.checked && root.enabled: Glow {
        tint: Theme.accent.with-alpha(0.7);
        radius: 12px;
        blur: 14px;
        lift: 0px;
        inset: 3px;
    }

    track := Rectangle {
        border-radius: 12px;
        border-width: root.checked ? 0px : 1px;
        background: root.checked ? @linear-gradient(120deg, #6D7CFF 0%, #4FE3C1 100%) : #FFFFFF1A;
        border-color: Theme.border-strong;
        opacity: root.enabled ? 1 : 0.45;

        knob := Rectangle {
            property <length> stretch: touch.pressed ? 5px : 0px;
            width: 18px + self.stretch;
            height: 18px;
            y: 3px;
            x: root.checked ? parent.width - self.width - 3px : 3px;
            border-radius: 9px;
            background: root.checked ? #FFFFFF : #D9D7E3;
            drop-shadow-color: #00000066;
            drop-shadow-blur: 4px;
            drop-shadow-offset-y: 1px;
            animate x { duration: 420ms; easing: cubic-bezier(0.34, 1.32, 0.5, 1); }
            animate stretch { duration: 200ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        }
    }

    FocusRing {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        shown: focus.has-focus;
        radius: 12px;
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.flip();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.flip(); }
    }
}

// The dropdown. A popup holding rows we draw, rather than a native menu, so the list matches the
// rest of the application on every desktop.
export component Select {
    in property <[string]> options;
    in property <bool> enabled: true;
    in-out property <int> current: 0;
    callback changed(int);

    height: 38px;
    vertical-stretch: 0;
    forward-focus: focus;
    accessible-role: combobox;
    accessible-value: current >= 0 && current < options.length ? options[current] : "";

    property <bool> open: false;

    Rectangle {
        border-radius: 11px;
        border-width: 1px;
        background: Theme.input;
        border-color: root.open ? Theme.accent : touch.has-hover && root.enabled ? Theme.border-strong : Theme.border;
        opacity: root.enabled ? 1 : 0.45;
        animate border-color { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;

            Text {
                text: root.current >= 0 && root.current < root.options.length
                    ? root.options[root.current]
                    : "";
                color: root.enabled ? Theme.text : Theme.text-4;
                font-size: 13px;
                font-weight: 500;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            VerticalLayout {
                alignment: center;
                Icon {
                    source: Icons.chevron-down;
                    size: 15px;
                    tint: Theme.text-3;
                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                    transform-rotation: root.open ? 180deg : 0deg;
                    animate transform-rotation { duration: 350ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                }
            }
        }
    }

    FocusRing {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        shown: focus.has-focus && !root.open;
        radius: 11px;
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 6px;
        width: root.width;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.menu-fill;
            border-radius: 14px;
            border-width: 1px;
            border-color: #FFFFFF17;
            drop-shadow-color: #0000008C;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;

            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                for option[index] in root.options: Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    background: index == root.current ? Theme.accent-soft
                        : row-touch.has-hover ? #FFFFFF14 : transparent;
                    animate background { duration: 120ms; }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        spacing: 6px;

                        Text {
                            text: option;
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: index == root.current ? 600 : 400;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        // The current row carries a check as well as a tint, so the selection is
                        // not carried by a hue alone.
                        if index == root.current: VerticalLayout {
                            alignment: center;
                            Icon {
                                source: Icons.check;
                                size: 14px;
                                tint: Theme.accent-2;
                            }
                        }
                    }

                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current = index;
                            root.changed(index);
                            root.open = false;
                            popup.close();
                        }
                    }
                }
            }
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.open = true;
                popup.show();
                return accept;
            }
            if (event.text == Key.DownArrow && root.current < root.options.length - 1) {
                root.current += 1;
                root.changed(root.current);
                return accept;
            }
            if (event.text == Key.UpArrow && root.current > 0) {
                root.current -= 1;
                root.changed(root.current);
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.open = true;
            popup.show();
        }
    }
}

// A state dot with its glow. Never shown alone: a label always sits beside it.
export component StateDot {
    in property <SyncState> state;
    // The hero's larger dot glows more.
    in property <bool> hero: false;
    property <length> dot: hero ? 10px : 8px;
    property <color> tint: States.tint(state);

    width: dot + 6px;
    height: dot + 6px;

    property <float> pulse: States.pulses(root.state)
        ? 0.675 + 0.325 * cos(animation-tick() / 1800ms * 360deg)
        : 1;

    Rectangle {
        width: root.dot;
        height: root.dot;
        border-radius: root.dot / 2;
        background: root.tint;
        opacity: root.pulse;
        drop-shadow-color: root.tint.with-alpha(root.hero ? 0.9 : 0.7);
        drop-shadow-blur: root.hero ? 14px : 8px;
        animate background { duration: 180ms; }
    }
}

// A small badge. "THIS DEVICE", "EXPIRED".
export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.link;
    in property <color> fill: Theme.accent-soft;
    in property <color> edge: transparent;

    height: 18px;
    width: label.preferred-width + 14px;
    border-radius: 9px;
    border-width: 1px;
    background: fill;
    border-color: edge;

    label := Text {
        text: root.text;
        color: root.tone;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.6px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// A thin progress bar in the accent gradient, with a glow on the part that is done.
export component ProgressBar inherits Rectangle {
    in property <float> progress;
    in property <length> thickness: 4px;
    height: thickness;
    vertical-stretch: 0;
    border-radius: thickness / 2;
    background: Theme.hairline;

    Rectangle {
        x: 0px;
        width: max(parent.height, parent.width * clamp(root.progress, 0, 1));
        border-radius: parent.border-radius;
        background: @linear-gradient(90deg, #4FE3C1 0%, #6D7CFF 100%);
        drop-shadow-color: #6D7CFFAA;
        drop-shadow-blur: 8px;
        animate width { duration: 400ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    }
}

// A square tile holding an icon: flat at rest, the accent gradient with a glow when on.
export component Tile inherits Rectangle {
    in property <image> icon;
    in property <bool> on: false;
    in property <length> size: 34px;
    in property <color> tint: Theme.text-2;
    width: size;
    height: size;
    border-radius: size * 0.3;

    if root.on: Glow {
        tint: Theme.accent.with-alpha(0.6);
        radius: root.border-radius;
        blur: 16px;
        lift: 2px;
        inset: 3px;
    }
    Rectangle {
        border-radius: root.border-radius;
        background: root.on ? @linear-gradient(135deg, #4FE3C1 0%, #6D7CFF 100%) : #18171F;
        border-width: root.on ? 0px : 1px;
        border-color: Theme.border-strong;
        Icon {
            source: root.icon;
            // About half the tile, rounded to an even number of pixels so that, in a tile of even
            // size, it sits on whole pixels rather than straddling them.
            size: round(root.size * 0.47 / 2px) * 2px;
            tint: root.on ? Theme.on-accent : root.tint;
        }
    }
}

// A placeholder bar that breathes while something loads. Opacity only, so it stays cheap.
export component Skeleton inherits Rectangle {
    in property <bool> animated: true;
    background: Theme.raised-2;
    border-radius: 6px;
    opacity: animated ? 0.75 + 0.25 * cos(animation-tick() / 1400ms * 360deg) : 1;
}

// A short confirmation near the bottom edge of the window. Rises in from below.
export component Toast {
    in property <string> text;
    in property <bool> shown;
    in property <bool> good: true;

    height: 40px;
    width: row.preferred-width;
    opacity: shown ? 1 : 0;
    animate opacity { duration: shown ? 200ms : 140ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

    Rectangle {
        y: root.shown ? 0px : 14px;
        border-radius: 12px;
        border-width: 1px;
        background: #26242E;
        border-color: #FFFFFF17;
        drop-shadow-color: #00000080;
        drop-shadow-blur: 30px;
        drop-shadow-offset-y: 12px;
        animate y { duration: 450ms; easing: cubic-bezier(0.34, 1.32, 0.5, 1); }

        row := HorizontalLayout {
            padding-left: 12px;
            padding-right: 16px;
            spacing: 9px;
            alignment: center;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: (root.good ? Theme.success : Theme.error).with-alpha(0.16);
                    Icon {
                        source: root.good ? Icons.check : Icons.alert;
                        size: 12px;
                        tint: root.good ? Theme.success : Theme.error;
                    }
                }
            }
            Text {
                text: root.text;
                color: Theme.text;
                font-size: 12.5px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}
