// The Asli window.
//
// One window, six screens, created only when somebody asks for it. The tray is still the front
// door: nothing here runs at startup, so an idle device pays for a tray icon and a socket and
// not for a user interface.
//
// The screens replaced three improvised mechanisms. The join string used to be written to an
// HTML file and opened in a browser, joining used to be a zenity prompt, and settings used to be
// a JSON file opened in whatever editor the desktop had registered. Each of those was a different
// application appearing on screen, which is why this exists.

import {
    Palette, Metrics, Heading, Body, Card, Button, Field, Switch, Select, Row, StatusDot
} from "design.slint";

// Which screen is showing. Held on the window so the tray can open any of them directly.
export enum Screen {
    FirstRun,
    Join,
    Token,
    History,
    Settings,
    Status,
}

// One history entry, flattened for drawing. The identifier stays on the Rust side and is looked
// up by row index, so nothing here ever holds a key or a full clipboard payload.
export struct HistoryRow {
    preview: string,
    kind: string,
    age: string,
    size: string,
    is-image: bool,
}

// How the join field feels about what has been typed into it so far.
export struct TokenCheck {
    valid: bool,
    invalid: bool,
    message: string,
}

// The navigation rail down the left side.
component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked();

    height: 36px;
    border-radius: Metrics.radius-small;
    background: selected
        ? Palette.raised
        : touch.has-hover ? Palette.raised.darker(0.35) : transparent;
    animate background { duration: Metrics.quick; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 9px;

        // The selected item carries a bar as well as a fill, so the current screen is not
        // indicated by background colour alone.
        Rectangle {
            width: 3px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 1.5px;
            background: root.selected ? Palette.accent : transparent;
        }

        Text {
            text: root.text;
            color: root.selected ? Palette.text : Palette.text-dim;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "Asli";
    background: Palette.bg;
    min-width: 720px;
    min-height: 460px;
    // Landscape. A list of clipboard entries is read across, not down: a portrait window made
    // every row short and left the screen half empty under a single card.
    preferred-width: 980px;
    preferred-height: 620px;

    // Which screen is showing, and whether this device has an account at all. With no account
    // there is nothing to navigate between, so the rail is hidden and first run takes the window.
    in-out property <Screen> screen: Screen.Status;
    in property <bool> has-account: false;

    // Status screen.
    in property <string> connection: "Offline";
    in property <int> peers: 0;
    in property <string> last-sync: "never";
    in property <string> skipped: "0";
    in property <bool> paused: false;
    in property <bool> has-retained: false;
    in property <string> last-error: "";
    in property <string> relay-host: "";
    in property <string> device-id: "";
    in property <string> room-id: "";
    in property <string> clipboard-backend: "";

    // Join string screen.
    in property <image> qr;
    in property <string> token: "";

    // Join screen.
    in-out property <string> join-input: "";
    in property <TokenCheck> join-check: { valid: false, invalid: false, message: "" };
    in property <bool> join-busy: false;

    // History screen.
    in property <[HistoryRow]> history: [];
    in property <bool> history-enabled: true;
    in property <string> history-note: "";

    // Settings screen. Edited in place and applied by the Save button, except the switches, which
    // take effect immediately because a switch that needs saving does not feel like a switch.
    in-out property <string> relay-url: "";
    in-out property <int> size-cap-index: 1;
    in-out property <int> retention-index: 2;
    in-out property <bool> notifications: true;
    in-out property <bool> autostart: false;
    in-out property <bool> keep-history: true;
    in property <bool> settings-dirty: false;
    in property <string> settings-note: "";
    in property <string> autostart-detail: "";

    callback open-screen(Screen);
    callback create-account();
    callback join-account(string);
    callback check-token(string);
    callback copy-token();
    callback restore-entry(int);
    callback forget-entry(int);
    callback clear-history();
    callback set-paused(bool);
    callback request-retained();
    callback copy-diagnostics();
    callback save-settings();
    callback revert-settings();
    callback set-notifications(bool);
    callback set-autostart(bool);
    callback set-keep-history(bool);
    callback hide-window();

    // Escape closes the window rather than quitting, because the daemon outlives the window and
    // a person closing a tray window means "go away", never "stop syncing".
    forward-focus: shortcuts;
    shortcuts := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.hide-window();
                return accept;
            }
            return reject;
        }

        // The content sits inside the scope rather than beside it. A scope with no children only
        // sees keys while it personally holds focus, so Escape would stop working the moment
        // somebody clicked into the join field, which is exactly when they most want a way out.
        // Key events bubble up from the focused item, so wrapping catches them everywhere.
        HorizontalLayout {
        // The rail. Absent during first run, when there is nowhere else to go.
        if root.has-account: Rectangle {
            width: 168px;
            background: Palette.surface;

            VerticalLayout {
                padding: 10px;
                spacing: 4px;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-bottom: 8px;
                    padding-top: 6px;
                    spacing: 8px;

                    // The mark: two offset sheets, the same shape the tray icon draws.
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        Rectangle {
                            x: 0px; y: 0px; width: 12px; height: 14px;
                            border-radius: 3px;
                            background: Palette.accent.darker(0.25);
                        }
                        Rectangle {
                            x: 5px; y: 4px; width: 12px; height: 14px;
                            border-radius: 3px;
                            background: Palette.accent;
                        }
                    }

                    Text {
                        text: "Asli";
                        color: Palette.text;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                NavItem {
                    text: "Status";
                    selected: root.screen == Screen.Status;
                    clicked => { root.open-screen(Screen.Status); }
                }
                NavItem {
                    text: "History";
                    selected: root.screen == Screen.History;
                    clicked => { root.open-screen(Screen.History); }
                }
                NavItem {
                    text: "Join String";
                    selected: root.screen == Screen.Token;
                    clicked => { root.open-screen(Screen.Token); }
                }
                NavItem {
                    text: "Settings";
                    selected: root.screen == Screen.Settings;
                    clicked => { root.open-screen(Screen.Settings); }
                }

                Rectangle { vertical-stretch: 1; }

                // Sync state repeated at the foot of the rail, so it is visible from every
                // screen without having to go back to Status to check.
                Rectangle {
                    height: 1px;
                    background: Palette.line;
                }
                HorizontalLayout {
                    padding: 10px;
                    StatusDot {
                        tint: root.paused
                            ? Palette.warn
                            : root.connection == "Synced" ? Palette.good : Palette.bad;
                        text: root.paused ? "Paused" : root.connection;
                    }
                }
            }
        }

        // The screen itself.
        Rectangle {
            background: Palette.bg;
            horizontal-stretch: 1;

            if root.screen == Screen.FirstRun: first-run := VerticalLayout {
                padding: 28px;
                spacing: Metrics.gap;
                alignment: start;

                Heading { text: "One clipboard, every machine."; }
                Body {
                    text: "Copy on one device, paste on another. Everything is encrypted on this "
                        + "machine before it leaves, and the relay only ever sees sealed bytes.";
                }

                Rectangle { height: 8px; }

                Card {
                    VerticalLayout {
                        padding: Metrics.pad;
                        spacing: 8px;
                        Heading { text: "Start Here"; }
                        Body { text: "Create an account on this device. You get one join string to paste on your other machines."; }
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Create Account";
                                primary: true;
                                clicked => { root.create-account(); }
                            }
                        }
                    }
                }

                Card {
                    VerticalLayout {
                        padding: Metrics.pad;
                        spacing: 8px;
                        Heading { text: "Already Have One"; }
                        Body { text: "Open Asli on the device that has the account, choose Join String, and paste it here."; }
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Join Existing";
                                clicked => { root.open-screen(Screen.Join); }
                            }
                        }
                    }
                }
            }

            if root.screen == Screen.Join: VerticalLayout {
                padding: 28px;
                spacing: Metrics.gap;

                Heading { text: "Join Another Account"; }
                Body {
                    text: "Paste the join string from your other device with Ctrl+V. It starts "
                        + "with asli1_ and is shown there under Join string.";
                }

                Card {
                    VerticalLayout {
                        padding: Metrics.pad;
                        spacing: 10px;

                        Row {
                            label: "Join String";
                            join-field := Field {
                                placeholder: "asli1_...";
                                monospace: true;
                                text <=> root.join-input;
                                valid: root.join-check.valid;
                                invalid: root.join-check.invalid;
                                edited(value) => { root.check-token(value); }
                                accepted(value) => {
                                    if (root.join-check.valid) { root.join-account(value); }
                                }
                            }
                        }

                        // The verdict sits under the field and names the specific mistake: a
                        // wrong prefix, a bad checksum and a truncated string are three different
                        // problems and only one of them means "you were given the wrong string".
                        if root.join-check.message != "": Text {
                            text: root.join-check.message;
                            color: root.join-check.invalid ? Palette.bad : Palette.good;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Button {
                                text: root.join-busy ? "Joining..." : "Join";
                                primary: true;
                                enabled: root.join-check.valid && !root.join-busy;
                                clicked => { root.join-account(root.join-input); }
                            }
                        }
                    }
                }

                if root.has-account: Card {
                    background: Palette.surface;
                    border-color: Palette.warn;
                    VerticalLayout {
                        padding: Metrics.pad;
                        spacing: 6px;
                        Heading { text: "This replaces the account on this device"; }
                        Body {
                            text: "Any device still using the current join string stops syncing with "
                                + "this machine, and the current account cannot be recovered unless "
                                + "you saved its join string somewhere.";
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }

            // Two columns, because the window is wider than it is tall. Stacked down the middle
            // the symbol pushed its own explanation off the bottom of the screen.
            if root.screen == Screen.Token: HorizontalLayout {
                padding: 28px;
                spacing: 24px;
                alignment: start;

                VerticalLayout {
                    // A white plate under the symbol, because a QR inverted by a dark theme is
                    // unreadable to roughly every camera.
                    Rectangle {
                        width: 232px;
                        height: 232px;
                        background: #ffffff;
                        border-radius: Metrics.radius;
                        Image {
                            width: 200px;
                            height: 200px;
                            x: 16px;
                            y: 16px;
                            source: root.qr;
                            image-rendering: pixelated;
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                VerticalLayout {
                    spacing: Metrics.gap;
                    horizontal-stretch: 1;

                    Heading { text: "Scan this on your other device"; }

                    Card {
                        vertical-stretch: 0;
                        VerticalLayout {
                            padding: 14px;
                            Text {
                                text: root.token;
                                color: Palette.text;
                                font-size: 12px;
                                font-family: "monospace";
                                wrap: char-wrap;
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        Button {
                            text: "Copy Join String";
                            primary: true;
                            clicked => { root.copy-token(); }
                        }
                    }

                    Body {
                        text: "Anyone who has this has your clipboard. Do not send it over chat or "
                            + "email. Scanning the QR is safest. Copying it marks it so clipboard "
                            + "history and cloud sync skip it, and clears it after 90 seconds, but "
                            + "software that ignores those markers can still read it.";
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            if root.screen == Screen.History: VerticalLayout {
                padding: 28px;
                spacing: Metrics.gap;

                HorizontalLayout {
                    spacing: Metrics.gap;
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Heading { text: "History"; }
                        Body { text: "Click an entry to put it back on the clipboard of every device."; }
                    }
                    if root.history.length > 0: Button {
                        text: "Clear All";
                        danger: true;
                        clicked => { root.clear-history(); }
                    }
                }

                // Pinned to its own height. A card left to stretch shares out the leftover space
                // and drifts into the middle of the screen, taking its own contents apart as it
                // goes, which is what happened to the empty state here.
                if !root.history-enabled: Card {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: Metrics.pad;
                        spacing: 8px;
                        Heading { text: "History is Off"; }
                        Body { text: "Turn it on in Settings to keep a local, encrypted list of what you copied."; }
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Open Settings";
                                clicked => { root.open-screen(Screen.Settings); }
                            }
                        }
                    }
                }

                if root.history-enabled && root.history.length == 0: Card {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: Metrics.pad;
                        spacing: 6px;
                        Heading { text: "Nothing Yet"; }
                        Body { text: "Copy something and it appears here."; }
                    }
                }

                if root.history-enabled && root.history.length > 0: Flickable {
                    vertical-stretch: 1;
                    content-height: rows.preferred-height;

                    rows := VerticalLayout {
                        spacing: 6px;
                        for entry[index] in root.history: Rectangle {
                            height: max(58px, entry-layout.preferred-height);
                            border-radius: Metrics.radius-small;
                            background: entry-touch.has-hover ? Palette.raised : Palette.surface;
                            border-width: 1px;
                            border-color: Palette.line;
                            animate background { duration: Metrics.quick; }

                            entry-layout := HorizontalLayout {
                                padding: 12px;
                                spacing: 10px;

                                // Type badge, drawn rather than coloured, so text and image are
                                // told apart by the word and not by the shade.
                                Rectangle {
                                    width: 42px;
                                    height: 20px;
                                    y: 2px;
                                    border-radius: 5px;
                                    background: Palette.raised.darker(0.15);
                                    Text {
                                        text: entry.kind;
                                        color: Palette.text-dim;
                                        font-size: 10px;
                                        font-weight: 600;
                                        width: 100%;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: entry.is-image ? "Image" : entry.preview;
                                        color: Palette.text;
                                        font-size: 13px;
                                        font-family: entry.is-image ? "" : "monospace";
                                        wrap: no-wrap;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: entry.age + "  ·  " + entry.size;
                                        color: Palette.text-faint;
                                        font-size: 11px;
                                    }
                                }

                                // Revealed on hover, so the list stays quiet until pointed at.
                                // No width of its own: the component measures its own label, and
                                // pinning a number here is what squeezed the text against the edges.
                                Button {
                                    text: "Forget";
                                    h-pad: 12px;
                                    height: 30px;
                                    y: (parent.height - self.height) / 2;
                                    visible: entry-touch.has-hover;
                                    clicked => { root.forget-entry(index); }
                                }
                            }

                            entry-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.restore-entry(index); }
                            }
                        }
                    }
                }

                if root.history-note != "": Body { text: root.history-note; }

                // Takes the leftover height so nothing else has to. Only when the list is empty:
                // with rows present the Flickable already absorbs it, and two stretching children
                // would split the space and shrink the list for no reason.
                if root.history.length == 0: Rectangle { vertical-stretch: 1; }
            }

            if root.screen == Screen.Settings: Flickable {
                content-height: settings.preferred-height;

                settings := VerticalLayout {
                    padding: 28px;
                    spacing: Metrics.gap;

                    Heading { text: "Settings"; }

                    Card {
                        VerticalLayout {
                            padding: Metrics.pad;
                            spacing: 14px;

                            Row {
                                label: "Relay";
                                detail: "The server that passes sealed bytes between your devices. It cannot read them.";
                                Field {
                                    placeholder: "wss://asli.vnat.dev/v1";
                                    text <=> root.relay-url;
                                }
                            }

                            Row {
                                label: "Largest Clip to Sync";
                                detail: "Anything bigger is skipped rather than sent.";
                                Select {
                                    options: ["256 KB", "700 KB", "1 MB", "4 MB"];
                                    current <=> root.size-cap-index;
                                }
                            }
                        }
                    }

                    Card {
                        VerticalLayout {
                            padding: Metrics.pad;
                            spacing: 14px;

                            Switch {
                                text: "Notifications";
                                detail: "A short message when a clip arrives or something goes wrong.";
                                checked <=> root.notifications;
                                toggled(on) => { root.set-notifications(on); }
                            }

                            Rectangle { height: 1px; background: Palette.line; }

                            Switch {
                                text: "Start at Login";
                                detail: root.autostart-detail;
                                checked <=> root.autostart;
                                toggled(on) => { root.set-autostart(on); }
                            }
                        }
                    }

                    Card {
                        VerticalLayout {
                            padding: Metrics.pad;
                            spacing: 14px;

                            Switch {
                                text: "Keep History";
                                detail: "Stored on this device only, encrypted with your account key. Anything marked as a password is never recorded.";
                                checked <=> root.keep-history;
                                toggled(on) => { root.set-keep-history(on); }
                            }

                            Row {
                                label: "Keep at Most";
                                detail: "Older entries are dropped first.";
                                Select {
                                    options: ["25 entries", "50 entries", "100 entries", "250 entries"];
                                    enabled: root.keep-history;
                                    current <=> root.retention-index;
                                }
                            }
                        }
                    }

                    if root.settings-note != "": Body { text: root.settings-note; }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button {
                            text: "Save";
                            primary: true;
                            enabled: root.settings-dirty;
                            clicked => { root.save-settings(); }
                        }
                        Button {
                            text: "Revert";
                            enabled: root.settings-dirty;
                            clicked => { root.revert-settings(); }
                        }
                    }

                    Rectangle { height: 1px; background: Palette.line; }

                    Card {
                        VerticalLayout {
                            padding: Metrics.pad;
                            spacing: 10px;
                            Heading { text: "Danger"; secondary: true; }
                            Body {
                                text: "Joining another account replaces the one on this device. There "
                                    + "is no way to remove a single device from an account, so if a "
                                    + "join string leaked, create a new account and re-join your "
                                    + "other devices.";
                            }
                            HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: "Join Another Account";
                                    danger: true;
                                    clicked => { root.open-screen(Screen.Join); }
                                }
                            }
                        }
                    }

                }
            }

            if root.screen == Screen.Status: VerticalLayout {
                padding: 28px;
                spacing: Metrics.gap;

                Heading { text: "Status"; }

                Card {
                    VerticalLayout {
                        padding: Metrics.pad;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: Metrics.gap;
                            StatusDot {
                                tint: root.paused
                                    ? Palette.warn
                                    : root.connection == "Synced" ? Palette.good : Palette.bad;
                                text: root.paused ? "Paused" : root.connection;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: root.paused ? "Resume" : "Pause";
                                primary: root.paused;
                                clicked => { root.set-paused(!root.paused); }
                            }
                        }

                        Rectangle { height: 1px; background: Palette.line; }

                        // Each column packs to the top. Left to fill the row's height instead, a
                        // label and its own value drifted a hundred pixels apart and stopped
                        // reading as a pair.
                        HorizontalLayout {
                            spacing: Metrics.gap;
                            VerticalLayout {
                                spacing: 3px;
                                alignment: start;
                                horizontal-stretch: 1;
                                Body { text: "Connected"; }
                                Text {
                                    // Connections, not devices: the relay cannot see devices, and
                                    // saying otherwise would be a number we cannot stand behind.
                                    text: root.peers == 1 ? "1 connection" : root.peers + " connections";
                                    color: Palette.text;
                                    font-size: 13px;
                                    font-weight: 500;
                                }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                alignment: start;
                                horizontal-stretch: 1;
                                Body { text: "Last Sync"; }
                                Text {
                                    text: root.last-sync;
                                    color: Palette.text;
                                    font-size: 13px;
                                    font-weight: 500;
                                }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                alignment: start;
                                horizontal-stretch: 1;
                                Body { text: "Skipped"; }
                                Text {
                                    text: root.skipped;
                                    color: Palette.text;
                                    font-size: 13px;
                                    font-weight: 500;
                                }
                            }
                        }
                    }
                }

                if root.has-retained: Card {
                    VerticalLayout {
                        padding: Metrics.pad;
                        spacing: 8px;
                        Heading { text: "The relay is holding a clip"; }
                        Body {
                            text: "Something was copied while this device was away. It is not "
                                + "written automatically, because that would overwrite whatever you "
                                + "copied here since.";
                        }
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Paste It Here";
                                primary: true;
                                clicked => { root.request-retained(); }
                            }
                        }
                    }
                }

                if root.last-error != "": Card {
                    border-color: Palette.bad;
                    VerticalLayout {
                        padding: Metrics.pad;
                        spacing: 6px;
                        Heading { text: "Last Problem"; secondary: true; }
                        Body { text: root.last-error; strong: true; }
                    }
                }

                Card {
                    VerticalLayout {
                        padding: Metrics.pad;
                        spacing: 10px;
                        Heading { text: "This Device"; secondary: true; }

                        // The label column has a fixed width and the value starts immediately
                        // after it. Pushing the value to the right edge instead put a whole
                        // screen of empty between a label and the thing it names once the
                        // window went landscape.
                        HorizontalLayout {
                            spacing: Metrics.gap;
                            Body { text: "Relay"; width: 110px; }
                            Body { text: root.relay-host; strong: true; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: Metrics.gap;
                            Body { text: "Room"; width: 110px; }
                            Body { text: root.room-id; strong: true; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: Metrics.gap;
                            Body { text: "Device"; width: 110px; }
                            Body { text: root.device-id; strong: true; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: Metrics.gap;
                            Body { text: "Clipboard"; width: 110px; }
                            Body { text: root.clipboard-backend; strong: true; horizontal-stretch: 1; }
                        }

                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Copy Diagnostics";
                                clicked => { root.copy-diagnostics(); }
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}
}
