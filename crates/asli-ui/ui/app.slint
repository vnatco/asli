// The Asli window.
//
// One window, six screens, created only when somebody asks for it. The tray is still the front
// door: nothing here runs at startup, so an idle device pays for a tray icon and a socket and
// not for a user interface.
//
// The window draws its own frame. The title bar, the sidebar and the six screens are laid out to
// the redesign's measurements, and a frame supplied by the desktop would have put a second, foreign
// title bar above ours, different on every desktop it ran on.

import {
    SoftShadow, GradientFill, Theme, Icons, SyncState, States, Icon, Spinner, ButtonKind, Button, IconButton, Overline,
    Title, Subtitle, Caption, Label, Card, Divider, BannerKind, Banner, TextField, JoinArea,
    Toggle, Select, StateDot, Pill, Skeleton, Toast
} from "design.slint";

export { SyncState }

// Which screen is showing. Held on the window so the tray can open any of them directly.
export enum Screen {
    FirstRun,
    Join,
    Token,
    History,
    Settings,
    Status,
    Shelf,
}

// One file on a shelf, flattened for drawing.
export struct ShelfRow {
    name: string,
    // The device it is on, its size, and how long it stays.
    detail: string,
}

// One history entry, flattened for drawing. The identifier stays on the Rust side and is looked
// up by row index, so nothing here ever holds a key or a full clipboard payload.
export struct HistoryRow {
    preview: string,
    meta: string,
    is-image: bool,
    // URLs and code read better in the monospaced face.
    mono: bool,
    thumb: image,
    has-thumb: bool,
}

// One device on the account, as the Status screen lists it.
export struct DeviceRow {
    name: string,
    os: string,
    id: string,
    seen: string,
    online: bool,
    this-device: bool,
    // Whether it can be removed from here: another device, which has sent a signed card, so the
    // new account key can be sealed to the ones that stay.
    removable: bool,
    // Whether a file can be sent to it now: removable, and connected.
    can-send: bool,
    // Which Asli it runs, or that it is too old to say.
    version: string,
    // Whether it runs an older Asli than the newest on the account.
    outdated: bool,
    // Whether it can only be taken off this list: it has no key of its own to remove it with.
    forgettable: bool,
}

// A file on its way to or from this device.
export struct FileRow {
    name: string,
    // "To MacBook" or "From MacBook".
    peer: string,
    // Size, and how far it has got or how it ended.
    detail: string,
    // 0 to 1 while it moves.
    progress: float,
    // Still under way, so it can be called off.
    live: bool,
    // Over, and it went well.
    good: bool,
}

// A device asking to join, on the device that approves it.
export struct AskRow {
    name: string,
    os: string,
    // The six digits the asking device shows, for a person to compare.
    comparison: string,
}

// Where adding a device has got to, on the device already on the account.
export enum InviteState {
    // No code made yet.
    idle,
    // A code is showing and requests can arrive.
    waiting,
    // Over: approved, turned down, expired or failed. invite-message says which.
    finished,
}

// How the join field feels about what has been typed into it so far.
export struct TokenCheck {
    valid: bool,
    invalid: bool,
    message: string,
}

// A screen fades in over 200 ms with a 6 px rise. The outgoing screen is cut, not cross faded.
component ScreenFrame inherits Rectangle {
    property <bool> entered: false;
    init => { entered = true; }
    opacity: entered ? 1 : 0;
    y: entered ? 0px : 6px;
    animate opacity, y { duration: 200ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
}

// A scrolling column with the design's overlay scrollbar: a 4 px thumb inset 3 px from the edge,
// laid over the content rather than taking width from it.
component Scroller inherits Rectangle {
    in property <length> content-height;
    out property <length> scroll-y: -flick.content-y;

    flick := Flickable {
        width: 100%;
        height: 100%;
        content-height: max(root.content-height, self.height);
        @children
    }

    if flick.content-height > flick.height + 1px: Rectangle {
        property <length> track: flick.height - 6px;
        property <length> span: max(28px, self.track * flick.height / flick.content-height);
        x: parent.width - 7px;
        width: 4px;
        height: self.span;
        y: 3px + (self.track - self.span) * (-flick.content-y) / (flick.content-height - flick.height);
        border-radius: 2px;
        background: thumb-touch.has-hover || thumb-touch.pressed ? Theme.border-strong : Theme.border;

        thumb-touch := TouchArea {
            property <length> start;
            moved => {
                if (self.pressed) {
                    flick.content-y = max(flick.height - flick.content-height, min(0px,
                        flick.content-y - (self.mouse-y - self.pressed-y) * flick.content-height / flick.height));
                }
            }
        }
    }
}

// An item in the sidebar.
component NavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected: false;
    callback clicked();

    height: 34px;
    border-radius: 8px;
    background: selected ? Theme.accent-soft : touch.has-hover ? Theme.hairline : transparent;
    animate background { duration: 120ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    accessible-role: tab;
    accessible-label: text;
    accessible-item-selected: selected;
    accessible-action-default => { clicked(); }

    // The selected item carries a bar at the sidebar's edge as well as a fill, so the current
    // screen is not indicated by background colour alone.
    Rectangle {
        x: -10px;
        y: 8px;
        width: 3px;
        height: 18px;
        border-top-right-radius: 3px;
        border-bottom-right-radius: 3px;
        background: Theme.accent;
        opacity: root.selected ? 1 : 0;
        animate opacity { duration: 120ms; }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        Icon {
            source: root.icon;
            size: 16px;
            tint: root.selected || touch.has-hover ? Theme.text : Theme.text-2;
            opacity: 0.9;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            color: root.selected || touch.has-hover ? Theme.text : Theme.text-2;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            letter-spacing: -0.05px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            animate color { duration: 120ms; }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// One of the three caption buttons at the right of the title bar.
component CaptionButton inherits Rectangle {
    in property <image> icon;
    in property <bool> close: false;
    in property <string> label;
    callback clicked();

    width: 46px;
    height: 36px;
    background: touch.has-hover ? (close ? Theme.danger-deep : Theme.hairline) : transparent;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }

    Icon {
        source: root.icon;
        size: 11px;
        tint: touch.has-hover ? (root.close ? #FFFFFF : Theme.text) : Theme.text-3;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A card on the first run screen: one of the two ways in.
component ChoiceCard {
    in property <bool> primary: false;
    in property <string> title;
    in property <string> body;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> busy: false;
    callback clicked();

    min-height: card.min-height;
    preferred-height: card.preferred-height;
    horizontal-stretch: 1;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: title;
    accessible-description: body;
    accessible-action-default => { clicked(); }

    property <bool> hover: touch.has-hover && enabled;

    if root.primary: SoftShadow {
        y: card.y;
        radius: 14px;
        offset-y: 4px;
        blur: 12px;
        spread: -2px;
        strength: 0.45;
    }

    card := Rectangle {
        // Lifts a pixel under the pointer and settles back when pressed.
        y: root.hover && !touch.pressed ? -1px : 0px;
        width: 100%;
        height: 100%;
        border-radius: 14px;
        border-width: root.primary ? 0px : 1px;
        background: root.primary ? transparent : Theme.raised-1;
        border-color: root.hover ? Theme.border-strong : Theme.border-subtle;
        animate border-color { duration: 120ms; easing: cubic-bezier(0.2, 0, 0, 1); }
        animate y { duration: 80ms; easing: cubic-bezier(0.2, 0, 0, 1); }

        if root.primary: GradientFill {
            radius: 14px;
            angle: 145deg;
            from: Theme.hero-from;
            to: Theme.hero-to;
        }
        if root.primary: Rectangle {
            border-radius: 14px;
            border-width: 1px;
            border-color: root.hover ? Theme.accent : Theme.accent-border;
            animate border-color { duration: 120ms; easing: cubic-bezier(0.2, 0, 0, 1); }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 0px;

            HorizontalLayout {
                alignment: start;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: 9px;
                    border-width: 1px;
                    background: root.primary ? Theme.accent-soft : Theme.raised-2;
                    border-color: root.primary ? Theme.accent-border : Theme.border;

                    if !root.busy: Icon {
                        source: root.icon;
                        size: 16px;
                        tint: root.primary ? Theme.link : Theme.text-2;
                    }
                    if root.busy: Spinner {
                        size: 16px;
                        tint: Theme.link;
                    }
                }
            }
            Rectangle { height: 12px; }
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
            }
            Rectangle { height: 3px; }
            Caption {
                text: root.body;
            }
        }
    }

    Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: 18px;
        border-width: 2px;
        border-color: Theme.focus;
        opacity: focus.has-focus ? 1 : 0;
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// A key and its value, in the Connection card.
component DetailRow inherits HorizontalLayout {
    in property <string> key;
    in property <string> value;
    spacing: 16px;
    padding-top: 5px;
    padding-bottom: 5px;

    Text {
        width: 96px;
        text: root.key;
        color: Theme.text-3;
        font-size: 12px;
    }
    TextInput {
        horizontal-stretch: 1;
        text: root.value;
        read-only: true;
        color: Theme.text;
        font-size: 12px;
        font-family: Theme.mono;
        wrap: char-wrap;
        single-line: false;
        selection-background-color: #4C8DFF66;
        selection-foreground-color: Theme.text;
    }
}

// A switch with its title and explanation, in the This Device card.
component SettingRow inherits VerticalLayout {
    in property <string> title;
    in property <string> detail;
    in property <bool> mono-detail: false;
    in property <bool> last: false;
    in-out property <bool> checked;
    callback toggled(bool);

    HorizontalLayout {
        padding-top: 13px;
        padding-bottom: 13px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;

        VerticalLayout {
            spacing: 2px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 500;
            }
            Caption {
                text: root.detail;
                font-family: root.mono-detail ? Theme.mono : "";
                wrap: root.mono-detail ? char-wrap : word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            Toggle {
                label: root.title;
                checked <=> root.checked;
                toggled(on) => { root.toggled(on); }
            }
        }
    }
    if !root.last: Divider { }
}

export component AppWindow inherits Window {
    title: "Asli";
    // The title bar and taskbar icon on Windows and X11. Wayland takes it from the desktop entry
    // named by the app id instead. Rendered from packaging/linux/asli.svg, the one source of the
    // mark, and embedded at build time.
    icon: @image-url("../../../packaging/icons/asli-256.png");
    no-frame: true;
    // A frameless window still resizes from its edges, within this many pixels of them.
    resize-border-width: 6px;
    // Square, with the design's one pixel edge. The design rounds the window's corners, but the
    // software renderer hands the desktop an opaque surface, so a transparent corner comes out
    // black on every platform. Square is the better of the two.
    background: Theme.canvas;
    min-width: 720px;
    min-height: 520px;
    preferred-width: 880px;
    preferred-height: 600px;
    default-font-size: 13px;
    default-font-family: root.ui-font;

    // Set by the application before the window is shown.
    in property <string> ui-font: "";
    in property <bool> is-maximized: false;

    // Which screen is showing, and whether this device has an account at all. With no account
    // there is nothing to navigate between, so the sidebar is hidden and first run takes the window.
    in-out property <Screen> screen: Screen.Status;
    in property <bool> has-account: false;
    property <bool> chrome: screen != Screen.FirstRun && screen != Screen.Join;

    // The connection, shared by the Status hero, the sidebar footer and the History banner.
    in property <SyncState> sync-state: SyncState.connecting;
    in property <string> state-label: "Connecting…";
    in property <string> state-detail: "";
    in property <bool> paused: false;
    in property <bool> loading: false;

    // Status screen.
    in property <string> stat-connections: "";
    in property <string> stat-last-sync: "";
    in property <string> stat-skipped: "0";
    in property <bool> has-retained: false;
    in property <[DeviceRow]> devices: [];
    in property <string> relay-url-live: "";
    in property <string> room-id: "";
    in property <string> device-id: "";
    in property <string> clipboard-backend: "";

    // Join String screen.
    // Adding a device: the join code, its QR, how long it has left, and who is asking.
    in property <image> qr;
    in property <string> invite-code: "";
    in property <string> invite-remaining: "";
    in property <bool> invite-nearby-only: false;
    in property <InviteState> invite-state: InviteState.idle;
    in property <[AskRow]> invite-asking: [];
    in property <string> invite-message: "";
    in property <bool> invite-good: true;
    // Account security, on Status: whether the key was ever shown as an old style join string,
    // whether a key change is under way, and a question waiting for an answer.
    in property <bool> key-exposed: false;
    in property <bool> rekey-busy: false;
    in property <string> rekey-note: "";
    in property <string> confirm-title: "";
    in property <string> confirm-body: "";
    in property <string> confirm-action: "";
    // Files: what is moving, a file offered to this device, and a file dropped on the window.
    in property <[FileRow]> files: [];
    in property <bool> offer-waiting: false;
    in property <string> offer-from: "";
    in property <string> offer-name: "";
    in property <string> offer-size: "";
    in property <string> offer-folder: "";
    in property <string> drop-name: "";
    in property <[string]> drop-targets: [];
    in property <bool> drop-hover: false;
    in property <string> update-note: "";
    in property <string> drop-note: "";
    in property <[ShelfRow]> shelf-mine: [];
    in property <[ShelfRow]> shelf-theirs: [];

    // First run.
    in property <bool> creating: false;
    in property <string> create-error: "";

    // Join screen.
    in-out property <string> join-input: "";
    in property <TokenCheck> join-check: { valid: false, invalid: false, message: "" };
    in property <bool> join-busy: false;
    in property <string> join-error: "";
    // Waiting for the other device to approve this one, and the digits to compare meanwhile.
    in property <bool> join-waiting: false;
    in property <string> join-comparison: "";

    // History screen.
    in property <[HistoryRow]> history: [];
    in property <bool> history-enabled: true;
    in property <string> history-note: "";

    // Settings screen. The fields are applied by Save; the switches take effect immediately,
    // because a switch that needs saving does not feel like a switch.
    in-out property <string> relay-url: "";
    in-out property <string> device-name: "";
    in-out property <int> size-cap-index: 1;
    in-out property <int> retention-index: 2;
    in-out property <bool> notifications: true;
    in-out property <bool> autostart: false;
    in-out property <bool> keep-history: true;
    in-out property <bool> same-network-only: false;
    in property <string> saved-relay-url: "";
    in property <string> saved-device-name: "";
    in property <int> saved-size-cap-index: 1;
    in property <int> saved-retention-index: 2;
    in property <string> settings-note: "";
    in property <bool> settings-saving: false;
    in property <string> autostart-detail: "";
    property <string> relay-lower: root.relay-url.to-lowercase();
    property <bool> relay-invalid: !(relay-lower.starts-with("wss://") || relay-lower.starts-with("ws://"))
        || relay-lower.character-count < 7;
    property <bool> settings-dirty: relay-url != saved-relay-url || device-name != saved-device-name
        || size-cap-index != saved-size-cap-index || retention-index != saved-retention-index;
    property <bool> settings-saved-flash: false;

    // Transient state owned by the markup.
    property <string> toast-text;
    property <bool> toast-good: true;
    property <bool> toast-shown: false;
    property <bool> confirm-clear: false;
    property <bool> confirm-join-other: false;

    callback open-screen(Screen);
    callback create-account();
    callback join-account(string);
    callback check-token(string);
    callback cancel-join();
    callback open-invite();
    callback close-invite();
    callback approve-request(int);
    callback decline-request(int);
    callback ask-remove(int);
    callback forget-device(int);
    callback ask-replace-key();
    callback confirm-yes();
    callback confirm-no();
    callback send-file(int);
    callback accept-offer();
    callback decline-offer();
    callback change-offer-folder();
    callback cancel-file(int);
    callback clear-files();
    callback send-dropped(int);
    callback cancel-drop();
    callback shelve-dropped();
    callback add-to-shelf();
    callback unshelve(int);
    callback take-shelved(int);
    callback remove-shelved(int);
    callback restore-entry(int);
    callback copy-entry(int);
    callback forget-entry(int);
    callback clear-history();
    callback set-paused(bool);
    callback retry-now();
    callback request-retained();
    callback copy-diagnostics();
    callback save-settings();
    callback revert-settings();
    callback set-notifications(bool);
    callback set-autostart(bool);
    callback set-keep-history(bool);
    callback set-same-network-only(bool);
    callback hide-window();
    // Where the pointer is, in window coordinates, so the release can be handed back.
    callback start-drag(length, length);
    callback minimize-window();
    callback toggle-maximize();

    // Shows a short confirmation near the bottom of the window for 2.4 seconds.
    public function show-toast(text: string, good: bool) {
        root.toast-text = text;
        root.toast-good = good;
        root.toast-shown = true;
        toast-timer.running = false;
        toast-timer.running = true;
    }

    // Called once a save has gone through.
    public function settings-saved() {
        root.settings-saved-flash = true;
        saved-timer.running = false;
        saved-timer.running = true;
    }


    toast-timer := Timer {
        interval: 2400ms;
        running: false;
        triggered => {
            root.toast-shown = false;
            self.running = false;
        }
    }
    saved-timer := Timer {
        interval: 2000ms;
        running: false;
        triggered => {
            root.settings-saved-flash = false;
            self.running = false;
        }
    }

    clear-timer := Timer {
        interval: 4000ms;
        running: root.confirm-clear;
        triggered => { root.confirm-clear = false; }
    }

    // Escape closes a dialog first, then the window, rather than quitting: the daemon outlives
    // the window, and a person closing a tray window means "go away", never "stop syncing".
    forward-focus: shortcuts;
    shortcuts := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.confirm-join-other) {
                    root.confirm-join-other = false;
                } else {
                    root.hide-window();
                }
                return accept;
            }
            if (event.modifiers.control && root.chrome) {
                if (event.text == "1") { root.open-screen(Screen.Status); return accept; }
                if (event.text == "2") { root.open-screen(Screen.History); return accept; }
                if (event.text == "3") { root.open-screen(Screen.Shelf); return accept; }
                if (event.text == "4") { root.open-screen(Screen.Token); return accept; }
                if (event.text == "5") { root.open-screen(Screen.Settings); return accept; }
            }
            return reject;
        }

        // The whole window, with its own one pixel edge, which a maximised window does without.
        frame := Rectangle {
            border-width: root.is-maximized ? 0px : 1px;
            border-color: Theme.border;
            background: Theme.canvas;
            clip: true;

            VerticalLayout {
                padding: frame.border-width;

                // The title bar. All of it drags the window except the three buttons.
                Rectangle {
                    height: 36px;
                    background: Theme.titlebar;

                    // The move starts once the pointer moves with the button held, not on the
                    // press, so a double click still reaches the maximise below.
                    drag := TouchArea {
                        moved => {
                            if (self.pressed) {
                                root.start-drag(self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                            }
                        }
                        double-clicked => { root.toggle-maximize(); }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        spacing: 8px;

                        Image {
                            source: Icons.mark;
                            width: 15px;
                            height: 15px;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: "Asli";
                            color: Theme.text-2;
                            font-size: 12px;
                            font-weight: 500;
                            letter-spacing: 0.1px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        HorizontalLayout {
                            spacing: 0px;
                            CaptionButton {
                                icon: Icons.win-minimize;
                                label: "Minimize to tray";
                                clicked => { root.minimize-window(); }
                            }
                            CaptionButton {
                                icon: Icons.win-maximize;
                                label: root.is-maximized ? "Restore" : "Maximize";
                                clicked => { root.toggle-maximize(); }
                            }
                            CaptionButton {
                                icon: Icons.win-close;
                                close: true;
                                label: "Close";
                                clicked => { root.hide-window(); }
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.hairline;
                    }
                }

                HorizontalLayout {
                    // The sidebar. Absent on first run and join, which take the whole window.
                    if root.chrome: Rectangle {
                        width: 212px;
                        background: Theme.sidebar-fill;

                        VerticalLayout {
                            padding-top: 18px;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-bottom: 14px;
                                spacing: 10px;

                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    // The glow under the mark, cast by the front sheet.
                                    Rectangle {
                                        x: 6.75px;
                                        y: 6.75px;
                                        width: 13.5px;
                                        height: 13.5px;
                                        SoftShadow {
                                            radius: 3.75px;
                                            offset-y: 2px;
                                            blur: 6px;
                                            tint: #2F73F0;
                                            strength: 0.45;
                                            steps: 4;
                                        }
                                    }
                                    Image {
                                        source: Icons.mark;
                                        width: 24px;
                                        height: 24px;
                                    }
                                }
                                Text {
                                    text: "Asli";
                                    color: Theme.text;
                                    font-size: 15px;
                                    font-weight: 640;
                                    letter-spacing: -0.1px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }

                            VerticalLayout {
                                padding-top: 6px;
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 2px;

                                NavItem {
                                    text: "Status";
                                    icon: Icons.shield;
                                    selected: root.screen == Screen.Status;
                                    clicked => { root.open-screen(Screen.Status); }
                                }
                                NavItem {
                                    text: "History";
                                    icon: Icons.history;
                                    selected: root.screen == Screen.History;
                                    clicked => { root.open-screen(Screen.History); }
                                }
                                NavItem {
                                    text: "Shelf";
                                    icon: Icons.shelf;
                                    selected: root.screen == Screen.Shelf;
                                    clicked => { root.open-screen(Screen.Shelf); }
                                }
                                NavItem {
                                    text: "Add a device";
                                    icon: Icons.key;
                                    selected: root.screen == Screen.Token;
                                    clicked => { root.open-screen(Screen.Token); }
                                }
                                NavItem {
                                    text: "Settings";
                                    icon: Icons.settings;
                                    selected: root.screen == Screen.Settings;
                                    clicked => { root.open-screen(Screen.Settings); }
                                }
                            }

                            Rectangle { vertical-stretch: 1; }

                            // The state repeated at the foot of the sidebar, so it is visible from
                            // every screen without going back to Status to check.
                            Rectangle {
                                height: 48px;
                                Rectangle {
                                    y: 0px;
                                    height: 1px;
                                    background: Theme.hairline;
                                }
                                HorizontalLayout {
                                    padding-left: 13px;
                                    padding-right: 16px;
                                    spacing: 6px;
                                    StateDot {
                                        state: root.sync-state;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: root.state-label;
                                        color: Theme.text-2;
                                        font-size: 12px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            x: parent.width - 1px;
                            width: 1px;
                            background: Theme.hairline;
                        }
                    }

                    // The content column.
                    content := Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.canvas;
                        clip: true;

                        Image {
                            source: Icons.wash;
                            width: 100%;
                            height: 100%;
                            image-fit: fill;
                        }

                        // ─────────────────────────── First run ───────────────────────────
                        if root.screen == Screen.FirstRun: ScreenFrame {
                            VerticalLayout {
                                padding-left: 64px;
                                padding-right: 64px;
                                alignment: center;

                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 72px;
                                        height: 72px;
                                        SoftShadow {
                                            radius: 17px;
                                            // Wider than the design's 28 px on paper: CSS
                                            // filter shadows take that as a deviation, not a
                                            // radius, and this matches what it renders.
                                            offset-y: 12px;
                                            blur: 44px;
                                            tint: #2F73F0;
                                            strength: 0.42;
                                            steps: 20;
                                        }
                                        Image {
                                            source: Icons.app-icon;
                                            width: 72px;
                                            height: 72px;
                                        }
                                    }
                                }
                                Rectangle { height: 20px; }
                                Text {
                                    text: "Welcome to Asli";
                                    color: Theme.text;
                                    font-size: 24px;
                                    font-weight: 650;
                                    letter-spacing: -0.3px;
                                    horizontal-alignment: center;
                                }
                                Rectangle { height: 6px; }
                                HorizontalLayout {
                                    alignment: center;
                                    Subtitle {
                                        width: min(380px, parent.width);
                                        text: "One clipboard across your computers. Copy here, paste there, sealed end to end, so the relay only ever sees noise.";
                                        horizontal-alignment: center;
                                    }
                                }
                                Rectangle { height: 28px; }

                                if root.create-error != "": HorizontalLayout {
                                    alignment: center;
                                    padding-bottom: 12px;
                                    Banner {
                                        width: min(480px, parent.width);
                                        kind: BannerKind.error;
                                        title: "Couldn't create the account";
                                        body: root.create-error;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        width: min(480px, parent.width);
                                        spacing: 12px;
                                        opacity: root.creating ? 0.45 : 1;
                                        ChoiceCard {
                                            primary: true;
                                            icon: Icons.plus;
                                            title: "Create a new account";
                                            body: "Start fresh on this device and invite the others.";
                                            enabled: !root.creating;
                                            busy: root.creating;
                                            clicked => { root.create-account(); }
                                        }
                                        ChoiceCard {
                                            icon: Icons.key;
                                            title: "Join an existing account";
                                            body: "Paste a join string from another device.";
                                            enabled: !root.creating;
                                            clicked => { root.open-screen(Screen.Join); }
                                        }
                                    }
                                }
                                Rectangle { height: 24px; }
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 7px;
                                    Icon {
                                        source: Icons.shield;
                                        size: 13px;
                                        tint: Theme.text-4;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Keys never leave your devices";
                                        color: Theme.text-4;
                                        font-size: 11.5px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // ───────────────────────────── Join ──────────────────────────────
                        if root.screen == Screen.Join: ScreenFrame {
                            VerticalLayout {
                                padding-top: 20px;
                                padding-bottom: 20px;
                                padding-left: 24px;
                                padding-right: 24px;

                                HorizontalLayout {
                                    alignment: start;
                                    back := Rectangle {
                                        height: 28px;
                                        width: back-row.preferred-width;
                                        border-radius: 8px;
                                        background: back-touch.has-hover ? Theme.hairline : transparent;
                                        animate background { duration: 120ms; }
                                        accessible-role: button;
                                        accessible-label: "Back";
                                        accessible-action-default => { back-touch.clicked(); }

                                        back-row := HorizontalLayout {
                                            padding-left: 7px;
                                            padding-right: 10px;
                                            spacing: 5px;
                                            Icon {
                                                source: Icons.back;
                                                size: 14px;
                                                tint: back-touch.has-hover ? Theme.text : Theme.text-2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                text: "Back";
                                                color: back-touch.has-hover ? Theme.text : Theme.text-2;
                                                font-size: 12px;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                        back-touch := TouchArea {
                                            clicked => {
                                                root.open-screen(root.has-account ? Screen.Settings : Screen.FirstRun);
                                            }
                                        }
                                    }
                                }

                                // The form, centred with a 28 px optical lift.
                                VerticalLayout {
                                    alignment: center;
                                    vertical-stretch: 1;
                                    padding-bottom: 28px;

                                    HorizontalLayout {
                                        alignment: center;
                                        VerticalLayout {
                                            width: min(440px, parent.width);
                                            spacing: 0px;

                                            Title { text: root.join-waiting ? "Approve this device" : "Join an existing account"; }
                                            Rectangle { height: 5px; }
                                            if !root.join-waiting: StyledText {
                                                text: @markdown("On a device that is already set up, open <font color=\"#E9EDF6\">Add a device</font> and make a join code, then type it here.");
                                                default-color: Theme.text-2;
                                                default-font-size: 13px;
                                            }
                                            if root.join-waiting: VerticalLayout {
                                                spacing: 0px;
                                                Caption {
                                                    text: "Your other device is asking whether to let this one in. Approve it there only if it shows the same six digits as here.";
                                                    color: Theme.text-2;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                }
                                                Rectangle { height: 22px; }
                                                Overline { text: "THIS DEVICE SHOWS"; }
                                                Rectangle { height: 8px; }
                                                Text {
                                                    text: root.join-comparison;
                                                    color: Theme.text;
                                                    font-size: 34px;
                                                    font-weight: 600;
                                                    font-family: Theme.mono;
                                                    letter-spacing: 2px;
                                                }
                                                Rectangle { height: 18px; }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text {
                                                        text: "Waiting for approval…";
                                                        color: Theme.text-3;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                    Button {
                                                        text: "Cancel";
                                                        clicked => { root.cancel-join(); }
                                                    }
                                                }
                                            }
                                            if !root.join-waiting: Rectangle { height: 20px; }
                                            if !root.join-waiting: Label { text: "Join code"; }
                                            if !root.join-waiting: Rectangle { height: 6px; }
                                            join-field := JoinArea {
                                                visible: !root.join-waiting;
                                                height: root.join-waiting ? 0px : self.preferred-height;
                                                placeholder: "asli2_…";
                                                text <=> root.join-input;
                                                invalid: root.join-check.invalid;
                                                read-only: root.join-busy;
                                                edited(value) => { root.check-token(value); }
                                                accepted(value) => {
                                                    if (root.join-check.valid && !root.join-busy) {
                                                        root.join-account(value);
                                                    }
                                                }
                                            }

                                            // The verdict names the specific mistake: a wrong prefix,
                                            // a bad checksum and a truncated string are different
                                            // problems and only one means "the wrong string".
                                            if root.join-check.invalid && !root.join-waiting: HorizontalLayout {
                                                padding-top: 7px;
                                                spacing: 6px;
                                                VerticalLayout {
                                                    padding-top: 1px;
                                                    alignment: start;
                                                    Icon {
                                                        source: Icons.alert;
                                                        size: 14px;
                                                        tint: Theme.error;
                                                    }
                                                }
                                                Caption {
                                                    text: root.join-check.message;
                                                    color: Theme.error;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                            if !root.join-check.invalid && !root.join-waiting: VerticalLayout {
                                                padding-top: 7px;
                                                Caption {
                                                    text: root.has-account
                                                        ? "Joining replaces the account on this device."
                                                        : "A code works once, for ten minutes, and only when the other device approves this one.";
                                                }
                                            }

                                            Rectangle { height: 16px; }

                                            if root.join-error != "": VerticalLayout {
                                                padding-bottom: 12px;
                                                Banner {
                                                    kind: BannerKind.error;
                                                    title: root.join-error;
                                                }
                                            }

                                            if !root.join-waiting: HorizontalLayout {
                                                spacing: 8px;
                                                Button {
                                                    text: root.join-busy ? "Joining…" : "Join account";
                                                    kind: ButtonKind.primary;
                                                    busy: root.join-busy;
                                                    enabled: root.join-check.valid;
                                                    clicked => { root.join-account(root.join-input); }
                                                }
                                                Button {
                                                    text: "Paste";
                                                    icon: Icons.paste;
                                                    show-icon: true;
                                                    enabled: !root.join-busy;
                                                    clicked => { join-field.paste-over(); }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ─────────────────────────── Add a device ────────────────────────
                        if root.screen == Screen.Token: ScreenFrame {
                            Scroller {
                                content-height: invite-screen.preferred-height;

                                invite-screen := VerticalLayout {
                                    padding-top: 20px;
                                    padding-bottom: 24px;
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    spacing: 0px;
                                    alignment: start;

                                    Title { text: "Add a device"; }
                                    Rectangle { height: 4px; }
                                    Subtitle {
                                        text: "Make a join code here, type it on the new device, then approve it here.";
                                        wrap: word-wrap;
                                    }
                                    Rectangle { height: 18px; }

                                    if root.invite-state == InviteState.idle: VerticalLayout {
                                        spacing: 0px;
                                        HorizontalLayout {
                                            alignment: start;
                                            Button {
                                                text: "Create a join code";
                                                kind: ButtonKind.primary;
                                                pad-x: 14px;
                                                clicked => { root.open-invite(); }
                                            }
                                        }
                                        Rectangle { height: 14px; }
                                        HorizontalLayout {
                                            spacing: 7px;
                                            Icon {
                                                source: Icons.shield;
                                                size: 13px;
                                                tint: Theme.text-3;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Caption {
                                                text: "A code works once, for ten minutes, and lets nobody in until you approve them here. It does not contain your account key.";
                                                horizontal-stretch: 1;
                                                wrap: word-wrap;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if root.invite-state == InviteState.waiting: HorizontalLayout {
                                        spacing: 20px;
                                        alignment: start;

                                        // The QR plate is white whatever the theme: a symbol
                                        // inverted by a dark theme is unreadable to most cameras.
                                        VerticalLayout {
                                            alignment: start;
                                            Rectangle {
                                                width: 171px;
                                                height: 171px;
                                                SoftShadow {
                                                    radius: 14px;
                                                    offset-y: 12px;
                                                    blur: 32px;
                                                    spread: -6px;
                                                    strength: 0.6;
                                                    steps: 14;
                                                }
                                                Rectangle {
                                                    border-radius: 14px;
                                                    background: #FFFFFF;
                                                    Image {
                                                        x: 12px;
                                                        y: 12px;
                                                        width: 147px;
                                                        height: 147px;
                                                        source: root.qr;
                                                        image-rendering: pixelated;
                                                    }
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: start;
                                            spacing: 0px;

                                            Overline { text: "JOIN CODE"; }
                                            Rectangle { height: 8px; }
                                            Rectangle {
                                                border-radius: 10px;
                                                border-width: 1px;
                                                background: Theme.input;
                                                border-color: Theme.border;
                                                height: code-text.preferred-height + 22px;

                                                code-text := TextInput {
                                                    x: 12px;
                                                    y: 11px;
                                                    width: parent.width - 24px;
                                                    text: root.invite-code;
                                                    read-only: true;
                                                    color: Theme.text;
                                                    font-size: 14px;
                                                    font-family: Theme.mono;
                                                    letter-spacing: 0.4px;
                                                    wrap: char-wrap;
                                                    single-line: false;
                                                    selection-background-color: #4C8DFF66;
                                                    selection-foreground-color: Theme.text;
                                                }
                                            }
                                            Rectangle { height: 8px; }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Caption {
                                                    text: "Works once. Expires in " + root.invite-remaining + "."
                                                        + (root.invite-nearby-only ? " Only a device on this network can use it." : "");
                                                    wrap: word-wrap;
                                                    horizontal-stretch: 1;
                                                    vertical-alignment: center;
                                                }
                                                Button {
                                                    text: "Cancel";
                                                    small: true;
                                                    clicked => { root.close-invite(); }
                                                }
                                            }
                                            Rectangle { height: 16px; }

                                            if root.invite-asking.length == 0: Caption {
                                                text: "On the new device, choose Join an existing account and type this code. Its request appears here.";
                                                wrap: word-wrap;
                                            }

                                            for ask[i] in root.invite-asking: VerticalLayout {
                                                padding-bottom: 10px;
                                                Card {
                                                    height: ask-body.preferred-height;
                                                    ask-body := VerticalLayout {
                                                        padding-top: 14px;
                                                        padding-bottom: 14px;
                                                        padding-left: 16px;
                                                        padding-right: 16px;
                                                        spacing: 0px;
                                                        Text {
                                                            text: ask.name + " wants to join";
                                                            color: Theme.text;
                                                            font-size: 13.5px;
                                                            font-weight: 600;
                                                            overflow: elide;
                                                        }
                                                        if ask.os != "": Text {
                                                            text: ask.os;
                                                            color: Theme.text-3;
                                                            font-size: 11.5px;
                                                        }
                                                        Rectangle { height: 10px; }
                                                        Caption {
                                                            text: "Approve only if the new device shows:";
                                                        }
                                                        Rectangle { height: 4px; }
                                                        Text {
                                                            text: ask.comparison;
                                                            color: Theme.text;
                                                            font-size: 26px;
                                                            font-weight: 600;
                                                            font-family: Theme.mono;
                                                            letter-spacing: 2px;
                                                        }
                                                        Rectangle { height: 12px; }
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            alignment: start;
                                                            Button {
                                                                text: "Approve";
                                                                kind: ButtonKind.primary;
                                                                icon: Icons.check;
                                                                show-icon: true;
                                                                clicked => { root.approve-request(i); }
                                                            }
                                                            Button {
                                                                text: "Decline";
                                                                clicked => { root.decline-request(i); }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    if root.invite-state == InviteState.finished: VerticalLayout {
                                        spacing: 0px;
                                        Banner {
                                            kind: root.invite-good ? BannerKind.info : BannerKind.warning;
                                            icon: root.invite-good ? Icons.check : Icons.alert;
                                            title: root.invite-message;
                                        }
                                        Rectangle { height: 14px; }
                                        HorizontalLayout {
                                            alignment: start;
                                            Button {
                                                text: "Add another device";
                                                pad-x: 14px;
                                                clicked => { root.open-invite(); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ──────────────────────────── History ────────────────────────────
                        if root.screen == Screen.History: ScreenFrame {
                            VerticalLayout {
                                // The header stays put while the list scrolls under it.
                                Rectangle {
                                    height: header.preferred-height;
                                    header := HorizontalLayout {
                                        padding-top: 20px;
                                        padding-bottom: 14px;
                                        padding-left: 24px;
                                        padding-right: 24px;
                                        spacing: 16px;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 4px;
                                            Title { text: "History"; }
                                            Subtitle { text: "Click an entry to put it back on the clipboard of every device."; }
                                        }

                                        if root.history.length > 0 && !root.confirm-clear: VerticalLayout {
                                            alignment: start;
                                            Button {
                                                text: "Clear all";
                                                icon: Icons.trash;
                                                show-icon: true;
                                                kind: ButtonKind.destructive;
                                                clicked => { root.confirm-clear = true; }
                                            }
                                        }
                                        // Confirmed inline for four seconds rather than in a dialog.
                                        if root.history.length > 0 && root.confirm-clear: HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            Text {
                                                text: "Clear " + root.history.length + (root.history.length == 1 ? " clip?" : " clips?");
                                                color: Theme.text-2;
                                                font-size: 12px;
                                                font-weight: 500;
                                                height: 34px;
                                                vertical-alignment: center;
                                            }
                                            VerticalLayout {
                                                alignment: start;
                                                Button {
                                                    text: "Clear";
                                                    kind: ButtonKind.danger;
                                                    clicked => {
                                                        root.confirm-clear = false;
                                                        root.clear-history();
                                                    }
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: start;
                                                Button {
                                                    text: "Cancel";
                                                    kind: ButtonKind.ghost;
                                                    clicked => { root.confirm-clear = false; }
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        y: parent.height - 1px;
                                        height: 1px;
                                        background: Theme.hairline;
                                    }
                                }

                                if root.sync-state == SyncState.offline || root.sync-state == SyncState.error: VerticalLayout {
                                    padding-top: 12px;
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    Banner {
                                        kind: BannerKind.info;
                                        icon: Icons.offline;
                                        title: "Offline. History is local until you reconnect.";
                                    }
                                }

                                if !root.history-enabled: Rectangle {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        alignment: center;
                                        padding-bottom: 24px;
                                        HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 64px;
                                                height: 64px;
                                                SoftShadow {
                                                    radius: 18px;
                                                    offset-y: 12px;
                                                    blur: 32px;
                                                    spread: -12px;
                                                    strength: 0.8;
                                                    steps: 14;
                                                }
                                              GradientFill {
                                                radius: 18px;
                                                angle: 145deg;
                                                from: Theme.hero-from;
                                                to: Theme.hero-to;
                                              }
                                              Rectangle {
                                                border-radius: 18px;
                                                border-width: 1px;
                                                border-color: Theme.border;
                                                Icon {
                                                    source: Icons.history;
                                                    size: 26px;
                                                    tint: Theme.border-strong;
                                                }
                                              }
                                            }
                                        }
                                        Rectangle { height: 16px; }
                                        Text {
                                            text: "History is off";
                                            color: Theme.text;
                                            font-size: 15px;
                                            font-weight: 620;
                                            letter-spacing: -0.1px;
                                            horizontal-alignment: center;
                                        }
                                        Rectangle { height: 5px; }
                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                width: min(300px, parent.width);
                                                text: "Turn it on in Settings to keep a local, encrypted list of what you copied.";
                                                color: Theme.text-3;
                                                font-size: 12.5px;
                                                wrap: word-wrap;
                                                horizontal-alignment: center;
                                            }
                                        }
                                        Rectangle { height: 16px; }
                                        HorizontalLayout {
                                            alignment: center;
                                            Button {
                                                text: "Open Settings";
                                                small: true;
                                                clicked => { root.open-screen(Screen.Settings); }
                                            }
                                        }
                                    }
                                }

                                if root.history-enabled && root.history.length == 0: Rectangle {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        alignment: center;
                                        padding-left: 48px;
                                        padding-right: 48px;
                                        padding-bottom: 24px;
                                        HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 64px;
                                                height: 64px;
                                                SoftShadow {
                                                    radius: 18px;
                                                    offset-y: 12px;
                                                    blur: 32px;
                                                    spread: -12px;
                                                    strength: 0.8;
                                                    steps: 14;
                                                }
                                              GradientFill {
                                                radius: 18px;
                                                angle: 145deg;
                                                from: Theme.hero-from;
                                                to: Theme.hero-to;
                                              }
                                              Rectangle {
                                                border-radius: 18px;
                                                border-width: 1px;
                                                border-color: Theme.border;
                                                Icon {
                                                    source: Icons.copy;
                                                    size: 26px;
                                                    tint: Theme.border-strong;
                                                }
                                              }
                                            }
                                        }
                                        Rectangle { height: 16px; }
                                        Text {
                                            text: "Nothing copied yet";
                                            color: Theme.text;
                                            font-size: 15px;
                                            font-weight: 620;
                                            letter-spacing: -0.1px;
                                            horizontal-alignment: center;
                                        }
                                        Rectangle { height: 5px; }
                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                width: min(300px, parent.width);
                                                text: "Copy something on any paired device and it shows up here within a second.";
                                                color: Theme.text-3;
                                                font-size: 12.5px;
                                                wrap: word-wrap;
                                                horizontal-alignment: center;
                                            }
                                        }
                                        Rectangle { height: 16px; }
                                        HorizontalLayout {
                                            alignment: center;
                                            Button {
                                                text: "Add another device";
                                                small: true;
                                                clicked => { root.open-screen(Screen.Token); }
                                            }
                                        }
                                    }
                                }

                                if root.history-enabled && root.history.length > 0: Scroller {
                                    vertical-stretch: 1;
                                    content-height: rows.preferred-height;

                                    rows := VerticalLayout {
                                        padding-top: 12px;
                                        padding-bottom: 20px;
                                        padding-left: 24px;
                                        padding-right: 24px;
                                        spacing: 8px;
                                        alignment: start;

                                        for entry[index] in root.history: Rectangle {
                                            height: entry.has-thumb ? 74px : 62px;
                                            // Nothing a row holds may paint over the next one,
                                            // whatever arrives in it. The preview is already one
                                            // line; this is the backstop.
                                            clip: true;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            background: row-touch.has-hover ? Theme.raised-2 : Theme.raised-1;
                                            border-color: row-touch.has-hover ? Theme.border-strong : Theme.border-subtle;
                                            transform-origin: { x: self.width / 2, y: self.height / 2 };
                                            transform-scale-x: row-touch.pressed ? 99.5% : 100%;
                                            transform-scale-y: row-touch.pressed ? 99.5% : 100%;
                                            animate background, border-color { duration: 120ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                                            animate transform-scale-x, transform-scale-y { duration: 80ms; }
                                            accessible-role: list-item;
                                            accessible-label: entry.is-image ? "Image" : entry.preview;
                                            accessible-description: entry.meta;
                                            accessible-action-default => { root.restore-entry(index); }

                                            row-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.restore-entry(index); }
                                            }

                                            HorizontalLayout {
                                                padding-top: 11px;
                                                padding-bottom: 11px;
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                spacing: 12px;

                                                // Type tile: blue for text, green for an image, and
                                                // a different glyph for each, so the two are told
                                                // apart by shape as well as by hue.
                                                if !entry.has-thumb: Rectangle {
                                                    width: 38px;
                                                    height: 38px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 9px;
                                                    border-width: 1px;
                                                    background: entry.is-image ? #3DD68C1A : #4C8DFF1A;
                                                    border-color: entry.is-image ? Theme.success-border : Theme.accent-border;
                                                    Icon {
                                                        source: entry.is-image ? Icons.image : Icons.text;
                                                        size: 16px;
                                                        tint: entry.is-image ? Theme.success : Theme.link;
                                                    }
                                                }
                                                // The thumbnail arrives with its corners already
                                                // rounded: this renderer cannot clip to a radius.
                                                if entry.has-thumb: Rectangle {
                                                    width: 50px;
                                                    height: 50px;
                                                    y: (parent.height - self.height) / 2;
                                                    Image {
                                                        width: 100%;
                                                        height: 100%;
                                                        source: entry.thumb;
                                                        image-fit: cover;
                                                    }
                                                    Rectangle {
                                                        border-radius: 9px;
                                                        border-width: 1px;
                                                        border-color: Theme.border;
                                                    }
                                                }

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    spacing: 2px;
                                                    Text {
                                                        text: entry.preview;
                                                        color: Theme.text;
                                                        font-size: entry.mono ? 12.5px : 13px;
                                                        font-family: entry.mono ? Theme.mono : "";
                                                        wrap: no-wrap;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: entry.meta;
                                                        color: Theme.text-3;
                                                        font-size: 11.5px;
                                                        letter-spacing: 0.1px;
                                                        overflow: elide;
                                                    }
                                                }

                                                HorizontalLayout {
                                                    spacing: 2px;
                                                    IconButton {
                                                        icon: Icons.copy;
                                                        label: "Copy on this device only";
                                                        y: (parent.height - self.height) / 2;
                                                        clicked => { root.copy-entry(index); }
                                                    }
                                                    IconButton {
                                                        icon: Icons.trash;
                                                        destructive: true;
                                                        label: "Delete";
                                                        y: (parent.height - self.height) / 2;
                                                        clicked => { root.forget-entry(index); }
                                                    }
                                                }
                                            }
                                        }

                                        if root.history-note != "": Caption {
                                            text: root.history-note;
                                            color: Theme.text-4;
                                            horizontal-alignment: center;
                                            height: self.preferred-height + 4px;
                                            vertical-alignment: bottom;
                                        }
                                    }
                                }
                            }
                        }

                        // ──────────────────────────── Status ─────────────────────────────
                        if root.screen == Screen.Status: ScreenFrame {
                            Scroller {
                                content-height: status-screen.preferred-height;

                                status-screen := VerticalLayout {
                                    padding-top: 20px;
                                    padding-bottom: 24px;
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    spacing: 0px;
                                    alignment: start;

                                    Title { text: "Status"; }
                                    Rectangle { height: 14px; }

                                    // A question about the account waiting for an answer: removing a
                                    // device, or replacing the key.
                                    if root.confirm-title != "": VerticalLayout {
                                        padding-bottom: 14px;
                                        Card {
                                            height: confirm-body-layout.preferred-height;
                                            confirm-body-layout := VerticalLayout {
                                                padding-top: 14px;
                                                padding-bottom: 14px;
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                spacing: 0px;
                                                Text {
                                                    text: root.confirm-title;
                                                    color: Theme.text;
                                                    font-size: 13.5px;
                                                    font-weight: 600;
                                                    wrap: word-wrap;
                                                }
                                                Rectangle { height: 6px; }
                                                Caption {
                                                    text: root.confirm-body;
                                                    color: Theme.text-2;
                                                    wrap: word-wrap;
                                                }
                                                Rectangle { height: 12px; }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    alignment: start;
                                                    Button {
                                                        text: root.confirm-action;
                                                        kind: ButtonKind.danger;
                                                        busy: root.rekey-busy;
                                                        clicked => { root.confirm-yes(); }
                                                    }
                                                    Button {
                                                        text: "Cancel";
                                                        enabled: !root.rekey-busy;
                                                        clicked => { root.confirm-no(); }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // A file offered to this device: nothing is kept unless it is
                                    // accepted here.
                                    if root.offer-waiting: VerticalLayout {
                                        padding-bottom: 14px;
                                        Card {
                                            height: offer-body.preferred-height;
                                            offer-body := VerticalLayout {
                                                padding-top: 14px;
                                                padding-bottom: 14px;
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                spacing: 0px;
                                                Text {
                                                    text: root.offer-from + " wants to send you a file";
                                                    color: Theme.text;
                                                    font-size: 13.5px;
                                                    font-weight: 600;
                                                    wrap: word-wrap;
                                                }
                                                Rectangle { height: 8px; }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Icon {
                                                        source: Icons.download;
                                                        size: 15px;
                                                        tint: Theme.link;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                    Text {
                                                        text: root.offer-name;
                                                        color: Theme.text;
                                                        font-size: 13px;
                                                        overflow: elide;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    Text {
                                                        text: root.offer-size;
                                                        color: Theme.text-3;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                Rectangle { height: 8px; }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Caption {
                                                        text: "Save to " + root.offer-folder;
                                                        overflow: elide;
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                    }
                                                    Button {
                                                        text: "Change";
                                                        small: true;
                                                        clicked => { root.change-offer-folder(); }
                                                    }
                                                }
                                                Rectangle { height: 12px; }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    alignment: start;
                                                    Button {
                                                        text: "Accept";
                                                        kind: ButtonKind.primary;
                                                        icon: Icons.check;
                                                        show-icon: true;
                                                        clicked => { root.accept-offer(); }
                                                    }
                                                    Button {
                                                        text: "Decline";
                                                        clicked => { root.decline-offer(); }
                                                    }
                                                }
                                                Rectangle { height: 8px; }
                                                Caption {
                                                    text: "Only accept files you expect. Asli never opens them.";
                                                }
                                            }
                                        }
                                    }

                                    // A file dropped on the window, waiting to be told where to go.
                                    if root.drop-name != "": VerticalLayout {
                                        padding-bottom: 14px;
                                        Card {
                                            height: drop-body.preferred-height;
                                            drop-body := VerticalLayout {
                                                padding-top: 14px;
                                                padding-bottom: 14px;
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                spacing: 0px;
                                                Text {
                                                    text: root.drop-targets.length > 0
                                                        ? "Send " + root.drop-name + " to"
                                                        : "No device can receive " + root.drop-name + " right now";
                                                    color: Theme.text;
                                                    font-size: 13.5px;
                                                    font-weight: 600;
                                                    overflow: elide;
                                                }
                                                if root.drop-note != "": VerticalLayout {
                                                    padding-top: 6px;
                                                    Caption {
                                                        text: root.drop-note + (root.drop-targets.length == 0 ? " You can put it on the shelf for them to fetch later." : "");
                                                        color: Theme.text-2;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                                Rectangle { height: 10px; }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    alignment: start;
                                                    for target[t] in root.drop-targets: Button {
                                                        text: target;
                                                        kind: ButtonKind.primary;
                                                        icon: Icons.send;
                                                        show-icon: true;
                                                        clicked => { root.send-dropped(t); }
                                                    }
                                                    Button {
                                                        text: "Put on the shelf";
                                                        icon: Icons.shelf;
                                                        show-icon: true;
                                                        clicked => { root.shelve-dropped(); }
                                                    }
                                                    Button {
                                                        text: "Cancel";
                                                        clicked => { root.cancel-drop(); }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    if root.rekey-note != "": VerticalLayout {
                                        padding-bottom: 14px;
                                        Banner {
                                            kind: BannerKind.error;
                                            title: root.rekey-note;
                                        }
                                    }

                                    // Another device on the account runs a newer Asli than this one.
                                    if root.update-note != "": VerticalLayout {
                                        padding-bottom: 14px;
                                        Banner {
                                            kind: BannerKind.warning;
                                            title: "This device is not on the latest Asli";
                                            body: root.update-note;
                                        }
                                    }

                                    // An account whose key was once shown as an old style join
                                    // string, which carried the key itself, offers to replace it.
                                    if root.key-exposed && root.confirm-title == "": VerticalLayout {
                                        padding-bottom: 14px;
                                        spacing: 8px;
                                        Banner {
                                            kind: BannerKind.warning;
                                            title: "Replace this account's key";
                                            body: "An earlier version showed it as a join string, which may still be in a screenshot or a chat. A new key leaves any old copy useless. Devices that are offline when you do it will need to join again.";
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            Button {
                                                text: "Replace the key";
                                                busy: root.rekey-busy;
                                                clicked => { root.ask-replace-key(); }
                                            }
                                        }
                                    }

                                    // The hero: what is happening, and the one thing to do about it.
                                    Rectangle {
                                      height: hero.preferred-height;
                                      SoftShadow {
                                        radius: 14px;
                                        offset-y: 4px;
                                        blur: 12px;
                                        spread: -2px;
                                        strength: 0.45;
                                      }
                                      GradientFill {
                                        radius: 14px;
                                        angle: 145deg;
                                        from: Theme.hero-from;
                                        to: Theme.hero-to;
                                      }
                                      Rectangle {
                                        border-radius: 14px;
                                        border-width: 1px;
                                        border-color: States.edge(root.sync-state);
                                        animate border-color { duration: 180ms; }

                                        hero := VerticalLayout {
                                            HorizontalLayout {
                                                padding-top: 16px;
                                                padding-bottom: 16px;
                                                padding-left: 18px;
                                                padding-right: 18px;
                                                spacing: 14px;

                                                Rectangle {
                                                    width: 40px;
                                                    height: 40px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 12px;
                                                    border-width: 1px;
                                                    background: States.tint(root.sync-state).with-alpha(0.1);
                                                    border-color: States.edge(root.sync-state);
                                                    StateDot {
                                                        state: root.sync-state;
                                                        hero: true;
                                                    }
                                                }

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    spacing: 2px;
                                                    Text {
                                                        text: root.state-label;
                                                        color: States.tint(root.sync-state);
                                                        font-size: 15px;
                                                        font-weight: 620;
                                                        letter-spacing: -0.1px;
                                                    }
                                                    Text {
                                                        text: root.state-detail;
                                                        color: Theme.text-2;
                                                        font-size: 12px;
                                                        wrap: word-wrap;
                                                    }
                                                }

                                                VerticalLayout {
                                                    alignment: center;
                                                    Button {
                                                        pad-x: 16px;
                                                        text: root.paused ? "Resume"
                                                            : root.sync-state == SyncState.error ? "Retry now" : "Pause";
                                                        icon: root.paused ? Icons.play
                                                            : root.sync-state == SyncState.error ? Icons.refresh : Icons.pause;
                                                        show-icon: true;
                                                        clicked => {
                                                            if (root.paused) {
                                                                root.set-paused(false);
                                                            } else if (root.sync-state == SyncState.error) {
                                                                root.retry-now();
                                                            } else {
                                                                root.set-paused(true);
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            Rectangle { height: 1px; background: Theme.border; }

                                            HorizontalLayout {
                                                for stat[i] in [
                                                    { key: "CONNECTIONS", value: root.stat-connections },
                                                    { key: "LAST SYNC", value: root.stat-last-sync },
                                                    { key: "SKIPPED", value: root.stat-skipped },
                                                ]: Rectangle {
                                                    horizontal-stretch: 1;
                                                    height: cell.preferred-height;
                                                    cell := VerticalLayout {
                                                        padding-top: 12px;
                                                        padding-bottom: 12px;
                                                        padding-left: 18px;
                                                        padding-right: 18px;
                                                        spacing: 4px;
                                                        Overline { text: stat.key; }
                                                        if !root.loading: Text {
                                                            text: stat.value;
                                                            color: Theme.text;
                                                            font-size: 13px;
                                                            font-weight: 500;
                                                            overflow: elide;
                                                        }
                                                        if root.loading: Skeleton {
                                                            width: 48px;
                                                            height: 13px;
                                                        }
                                                    }
                                                    if i < 2: Rectangle {
                                                        x: parent.width - 1px;
                                                        width: 1px;
                                                        background: Theme.border-subtle;
                                                    }
                                                }
                                            }
                                        }
                                      }
                                    }

                                    // A clip copied while this device was away. Offered, never
                                    // written unasked, because that would overwrite whatever was
                                    // copied here since.
                                    if root.has-retained: VerticalLayout {
                                        padding-top: 14px;
                                        Banner {
                                            kind: BannerKind.info;
                                            icon: Icons.download;
                                            title: "The relay is holding a clip";
                                            body: "Something was copied while this device was away. It isn't written automatically, because that would overwrite what you copied here since.";
                                            VerticalLayout {
                                                alignment: center;
                                                Button {
                                                    text: "Paste it here";
                                                    small: true;
                                                    clicked => { root.request-retained(); }
                                                }
                                            }
                                        }
                                    }

                                    Rectangle { height: 14px; }
                                    if root.files.length > 0: VerticalLayout {
                                        spacing: 0px;
                                        HorizontalLayout {
                                            Overline {
                                                text: "FILES";
                                                vertical-alignment: center;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Button {
                                                text: "Clear finished";
                                                small: true;
                                                clicked => { root.clear-files(); }
                                            }
                                        }
                                        Rectangle { height: 8px; }
                                        Card {
                                            height: files-list.preferred-height;
                                            files-list := VerticalLayout {
                                                for file[f] in root.files: Rectangle {
                                                    height: file-row.preferred-height;
                                                    file-row := HorizontalLayout {
                                                        padding-top: 10px;
                                                        padding-bottom: 10px;
                                                        padding-left: 14px;
                                                        padding-right: 14px;
                                                        spacing: 11px;
                                                        VerticalLayout {
                                                            horizontal-stretch: 1;
                                                            min-width: 0px;
                                                            spacing: 3px;
                                                            Text {
                                                                text: file.name;
                                                                color: Theme.text;
                                                                font-size: 13px;
                                                                overflow: elide;
                                                            }
                                                            Text {
                                                                text: file.peer + "  ·  " + file.detail;
                                                                color: file.live || file.good ? Theme.text-3 : Theme.error;
                                                                font-size: 11.5px;
                                                                overflow: elide;
                                                            }
                                                            if file.live: Rectangle {
                                                                height: 3px;
                                                                border-radius: 1.5px;
                                                                background: Theme.hairline;
                                                                Rectangle {
                                                                    x: 0px;
                                                                    width: parent.width * clamp(file.progress, 0, 1);
                                                                    border-radius: 1.5px;
                                                                    background: Theme.link;
                                                                }
                                                            }
                                                        }
                                                        if file.live: Button {
                                                            text: "Cancel";
                                                            small: true;
                                                            y: (parent.height - self.height) / 2;
                                                            clicked => { root.cancel-file(f); }
                                                        }
                                                    }
                                                    if f < root.files.length - 1: Rectangle {
                                                        y: parent.height - 1px;
                                                        height: 1px;
                                                        background: Theme.border-subtle;
                                                    }
                                                }
                                            }
                                        }
                                        Rectangle { height: 14px; }
                                    }

                                    Overline { text: "PAIRED DEVICES"; }
                                    Rectangle { height: 8px; }
                                    Card {
                                        height: device-list.preferred-height;
                                        device-list := VerticalLayout {
                                            for device[i] in root.devices: Rectangle {
                                                height: device-row.preferred-height;
                                                background: device-touch.has-hover ? Theme.raised-2 : transparent;
                                                // Rounded where the card is. Clipping in the software
                                                // renderer ignores the card's corners.
                                                border-top-left-radius: i == 0 ? 13px : 0px;
                                                border-top-right-radius: i == 0 ? 13px : 0px;
                                                border-bottom-left-radius: i == root.devices.length - 1 ? 13px : 0px;
                                                border-bottom-right-radius: i == root.devices.length - 1 ? 13px : 0px;
                                                animate background { duration: 120ms; }
                                                accessible-role: list-item;
                                                accessible-label: device.name;
                                                accessible-description: device.os + ", " + device.seen;

                                                device-touch := TouchArea { }

                                                device-row := HorizontalLayout {
                                                    padding-top: 11px;
                                                    padding-bottom: 11px;
                                                    padding-left: 14px;
                                                    padding-right: 14px;
                                                    spacing: 11px;

                                                    Rectangle {
                                                        width: 30px;
                                                        height: 30px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 9px;
                                                        border-width: 1px;
                                                        background: Theme.raised-2;
                                                        border-color: Theme.border;
                                                        Icon {
                                                            source: Icons.device;
                                                            size: 15px;
                                                            tint: Theme.text-2;
                                                        }
                                                    }

                                                    VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        min-width: 0px;
                                                        alignment: center;
                                                        spacing: 1px;
                                                        HorizontalLayout {
                                                            spacing: 7px;
                                                            alignment: start;
                                                            Text {
                                                                text: device.name;
                                                                color: Theme.text;
                                                                font-size: 13px;
                                                                font-weight: 500;
                                                                overflow: elide;
                                                                vertical-alignment: center;
                                                            }
                                                            if device.this-device: Pill {
                                                                text: "THIS DEVICE";
                                                                y: (parent.height - self.height) / 2;
                                                            }
                                                        }
                                                        HorizontalLayout {
                                                            spacing: 0px;
                                                            alignment: start;
                                                            if device.os != "": Text {
                                                                text: device.os + "  ·  ";
                                                                color: Theme.text-3;
                                                                font-size: 11.5px;
                                                                vertical-alignment: center;
                                                            }
                                                            Text {
                                                                text: device.id;
                                                                color: Theme.text-3;
                                                                font-size: 11.5px;
                                                                font-family: Theme.mono;
                                                                vertical-alignment: center;
                                                            }
                                                            if device.version != "": Text {
                                                                text: "  ·  " + device.version;
                                                                color: device.outdated ? Theme.warning : Theme.text-3;
                                                                font-size: 11.5px;
                                                                vertical-alignment: center;
                                                                overflow: elide;
                                                            }
                                                        }
                                                    }

                                                    HorizontalLayout {
                                                        spacing: 6px;
                                                        horizontal-stretch: 0;
                                                        Rectangle {
                                                            width: 7px;
                                                            height: 7px;
                                                            y: (parent.height - self.height) / 2;
                                                            border-radius: 3.5px;
                                                            background: device.online ? Theme.success : Theme.text-3;
                                                        }
                                                        Text {
                                                            text: device.seen;
                                                            color: Theme.text-2;
                                                            font-size: 11.5px;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                    if device.can-send: Button {
                                                        text: "Send file";
                                                        small: true;
                                                        icon: Icons.send;
                                                        show-icon: true;
                                                        y: (parent.height - self.height) / 2;
                                                        clicked => { root.send-file(i); }
                                                    }
                                                    if device.removable: Button {
                                                        text: "Remove";
                                                        small: true;
                                                        enabled: !root.rekey-busy;
                                                        y: (parent.height - self.height) / 2;
                                                        clicked => { root.ask-remove(i); }
                                                    }
                                                    if device.forgettable: Button {
                                                        text: "Forget";
                                                        small: true;
                                                        y: (parent.height - self.height) / 2;
                                                        clicked => { root.forget-device(i); }
                                                    }
                                                }

                                                if i < root.devices.length - 1: Rectangle {
                                                    y: parent.height - 1px;
                                                    height: 1px;
                                                    background: Theme.border-subtle;
                                                }
                                            }
                                        }
                                    }

                                    Rectangle { height: 14px; }
                                    Overline { text: "CONNECTION"; }
                                    Rectangle { height: 8px; }
                                    Card {
                                        height: connection.preferred-height;
                                        connection := VerticalLayout {
                                            padding-top: 14px;
                                            padding-bottom: 14px;
                                            padding-left: 16px;
                                            padding-right: 16px;

                                            DetailRow { key: "Relay"; value: root.relay-url-live; }
                                            DetailRow { key: "Room"; value: root.room-id; }
                                            DetailRow { key: "Device"; value: root.device-id; }
                                            DetailRow { key: "Clipboard"; value: root.clipboard-backend; }
                                            Rectangle { height: 12px; }
                                            HorizontalLayout {
                                                alignment: start;
                                                Button {
                                                    text: "Copy diagnostics";
                                                    icon: Icons.copy;
                                                    show-icon: true;
                                                    kind: ButtonKind.ghost;
                                                    small: true;
                                                    clicked => { root.copy-diagnostics(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ─────────────────────────── Settings ────────────────────────────
                        if root.screen == Screen.Shelf: ScreenFrame {
                            Scroller {
                                content-height: shelf-screen.preferred-height;

                                shelf-screen := VerticalLayout {
                                    padding-top: 20px;
                                    padding-bottom: 24px;
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    spacing: 0px;
                                    alignment: start;

                                    HorizontalLayout {
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 4px;
                                            Title { text: "Shelf"; }
                                            Subtitle {
                                                text: "Files kept on offer to your other devices for a day. They stay where they are; taking one off the shelf never deletes it.";
                                                wrap: word-wrap;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: start;
                                            Button {
                                                text: "Add a file";
                                                icon: Icons.plus;
                                                show-icon: true;
                                                kind: ButtonKind.primary;
                                                clicked => { root.add-to-shelf(); }
                                            }
                                        }
                                    }
                                    Rectangle { height: 16px; }

                                    Overline { text: "ON THIS DEVICE"; }
                                    Rectangle { height: 8px; }
                                    Card {
                                        height: mine-list.preferred-height;
                                        mine-list := VerticalLayout {
                                            if root.shelf-mine.length == 0: HorizontalLayout {
                                                padding: 14px;
                                                Caption {
                                                    text: "Nothing yet. Add a file, or drop one on this window.";
                                                    wrap: word-wrap;
                                                }
                                            }
                                            for item[m] in root.shelf-mine: Rectangle {
                                                height: mine-row.preferred-height;
                                                mine-row := HorizontalLayout {
                                                    padding-top: 10px;
                                                    padding-bottom: 10px;
                                                    padding-left: 14px;
                                                    padding-right: 14px;
                                                    spacing: 11px;
                                                    VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        min-width: 0px;
                                                        alignment: center;
                                                        spacing: 3px;
                                                        Text {
                                                            text: item.name;
                                                            color: Theme.text;
                                                            font-size: 13px;
                                                            overflow: elide;
                                                        }
                                                        Text {
                                                            text: item.detail;
                                                            color: Theme.text-3;
                                                            font-size: 11.5px;
                                                            overflow: elide;
                                                        }
                                                    }
                                                    Button {
                                                        text: "Remove";
                                                        small: true;
                                                        y: (parent.height - self.height) / 2;
                                                        clicked => { root.unshelve(m); }
                                                    }
                                                }
                                                if m < root.shelf-mine.length - 1: Rectangle {
                                                    y: parent.height - 1px;
                                                    height: 1px;
                                                    background: Theme.border-subtle;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle { height: 18px; }

                                    Overline { text: "ON YOUR OTHER DEVICES"; }
                                    Rectangle { height: 8px; }
                                    Card {
                                        height: theirs-list.preferred-height;
                                        theirs-list := VerticalLayout {
                                            if root.shelf-theirs.length == 0: HorizontalLayout {
                                                padding: 14px;
                                                Caption {
                                                    text: "Nothing on their shelves. A device shows its shelf while it is on.";
                                                    wrap: word-wrap;
                                                }
                                            }
                                            for item[t] in root.shelf-theirs: Rectangle {
                                                height: theirs-row.preferred-height;
                                                theirs-row := HorizontalLayout {
                                                    padding-top: 10px;
                                                    padding-bottom: 10px;
                                                    padding-left: 14px;
                                                    padding-right: 14px;
                                                    spacing: 8px;
                                                    VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        min-width: 0px;
                                                        alignment: center;
                                                        spacing: 3px;
                                                        Text {
                                                            text: item.name;
                                                            color: Theme.text;
                                                            font-size: 13px;
                                                            overflow: elide;
                                                        }
                                                        Text {
                                                            text: item.detail;
                                                            color: Theme.text-3;
                                                            font-size: 11.5px;
                                                            overflow: elide;
                                                        }
                                                    }
                                                    Button {
                                                        text: "Get";
                                                        small: true;
                                                        icon: Icons.download;
                                                        show-icon: true;
                                                        kind: ButtonKind.primary;
                                                        y: (parent.height - self.height) / 2;
                                                        clicked => { root.take-shelved(t); }
                                                    }
                                                    Button {
                                                        text: "Remove";
                                                        small: true;
                                                        y: (parent.height - self.height) / 2;
                                                        clicked => { root.remove-shelved(t); }
                                                    }
                                                }
                                                if t < root.shelf-theirs.length - 1: Rectangle {
                                                    y: parent.height - 1px;
                                                    height: 1px;
                                                    background: Theme.border-subtle;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if root.screen == Screen.Settings: ScreenFrame {
                            Scroller {
                                content-height: settings-screen.preferred-height;

                                settings-screen := VerticalLayout {
                                    padding-top: 20px;
                                    padding-bottom: 24px;
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    spacing: 0px;
                                    alignment: start;

                                    Title { text: "Settings"; }
                                    Rectangle { height: 14px; }

                                    Overline { text: "RELAY"; }
                                    Rectangle { height: 8px; }
                                    Card {
                                        height: relay-card.preferred-height;
                                        relay-card := VerticalLayout {
                                            padding-top: 14px;
                                            padding-bottom: 14px;
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 0px;

                                            Label { text: "Relay address"; }
                                            Rectangle { height: 6px; }
                                            TextField {
                                                placeholder: "wss://asli.vnat.dev/v1";
                                                monospace: true;
                                                invalid: root.relay-invalid;
                                                text <=> root.relay-url;
                                            }
                                            Rectangle { height: 6px; }
                                            if !root.relay-invalid: Caption {
                                                text: "Passes sealed bytes between your devices. It cannot read them.";
                                            }
                                            if root.relay-invalid: HorizontalLayout {
                                                spacing: 6px;
                                                Icon {
                                                    source: Icons.alert;
                                                    size: 14px;
                                                    tint: Theme.error;
                                                    y: 1px;
                                                }
                                                Caption {
                                                    text: "Must start with wss:// or ws://";
                                                    color: Theme.error;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                            Rectangle { height: 14px; }
                                            Label { text: "Largest clip to sync"; }
                                            Rectangle { height: 6px; }
                                            Select {
                                                options: ["256 KB", "700 KB", "1 MB", "4 MB"];
                                                current <=> root.size-cap-index;
                                            }
                                            Rectangle { height: 6px; }
                                            Caption { text: "Anything bigger is skipped rather than sent."; }
                                        }
                                    }

                                    Rectangle { height: 16px; }
                                    Overline { text: "THIS DEVICE"; }
                                    Rectangle { height: 8px; }
                                    Card {
                                        height: device-card.preferred-height;
                                        device-card := VerticalLayout {
                                            VerticalLayout {
                                                padding-top: 13px;
                                                padding-bottom: 13px;
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                spacing: 0px;
                                                Text {
                                                    text: "Device name";
                                                    color: Theme.text;
                                                    font-size: 13px;
                                                    font-weight: 500;
                                                }
                                                Rectangle { height: 6px; }
                                                TextField {
                                                    placeholder: "This computer";
                                                    text <=> root.device-name;
                                                }
                                                Rectangle { height: 6px; }
                                                Caption { text: "How your other devices list this one. Sent to them sealed, like a clip."; }
                                            }
                                            Divider { }
                                            SettingRow {
                                                title: "Notifications";
                                                detail: "A short message when a clip arrives or something goes wrong.";
                                                checked <=> root.notifications;
                                                toggled(on) => { root.set-notifications(on); }
                                            }
                                            SettingRow {
                                                title: "Start at login";
                                                detail: root.autostart-detail;
                                                mono-detail: true;
                                                checked <=> root.autostart;
                                                toggled(on) => { root.set-autostart(on); }
                                            }
                                            SettingRow {
                                                title: "Same network only";
                                                detail: "Approve a new device, and send or receive a file, only when the other device is on this network. Clips still sync from anywhere.";
                                                checked <=> root.same-network-only;
                                                toggled(on) => { root.set-same-network-only(on); }
                                            }
                                            SettingRow {
                                                title: "Keep history";
                                                detail: "Stored on this device only, encrypted with your account key. Anything marked as a password is never recorded.";
                                                checked <=> root.keep-history;
                                                toggled(on) => { root.set-keep-history(on); }
                                            }
                                            VerticalLayout {
                                                padding-top: 13px;
                                                padding-bottom: 13px;
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                spacing: 0px;
                                                Text {
                                                    text: "Keep at most";
                                                    color: root.keep-history ? Theme.text : Theme.text-4;
                                                    font-size: 13px;
                                                    font-weight: 500;
                                                }
                                                Rectangle { height: 6px; }
                                                Select {
                                                    options: ["25 entries", "50 entries", "100 entries", "250 entries"];
                                                    enabled: root.keep-history;
                                                    current <=> root.retention-index;
                                                }
                                                Rectangle { height: 6px; }
                                                Caption { text: "Older entries are dropped first."; }
                                            }
                                        }
                                    }

                                    Rectangle { height: 14px; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Button {
                                            text: root.settings-saving ? "Saving…" : "Save";
                                            kind: ButtonKind.primary;
                                            pad-x: 18px;
                                            busy: root.settings-saving;
                                            enabled: root.settings-dirty && !root.relay-invalid;
                                            clicked => { root.save-settings(); }
                                        }
                                        Button {
                                            text: "Revert";
                                            kind: ButtonKind.ghost;
                                            pad-x: 16px;
                                            enabled: root.settings-dirty && !root.settings-saving;
                                            clicked => { root.revert-settings(); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        HorizontalLayout {
                                            spacing: 5px;
                                            if root.settings-saved-flash && !root.settings-dirty: Icon {
                                                source: Icons.check;
                                                size: 13px;
                                                tint: Theme.success;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                text: root.settings-dirty ? "Unsaved changes"
                                                    : root.settings-saved-flash ? "Saved" : "All changes saved";
                                                color: root.settings-dirty ? Theme.warning
                                                    : root.settings-saved-flash ? Theme.success : Theme.text-4;
                                                font-size: 11.5px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    if root.settings-note != "": VerticalLayout {
                                        padding-top: 10px;
                                        Caption { text: root.settings-note; }
                                    }

                                    Rectangle { height: 20px; }
                                    Overline {
                                        text: "DANGER";
                                        danger: true;
                                    }
                                    Rectangle { height: 8px; }
                                    Rectangle {
                                        border-radius: 14px;
                                        border-width: 1px;
                                        background: #F2555A0D;
                                        border-color: Theme.error-border;
                                        height: danger-card.preferred-height;

                                        danger-card := VerticalLayout {
                                            padding-top: 14px;
                                            padding-bottom: 14px;
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 12px;
                                            Text {
                                                text: "Joining another account replaces the one on this device. A single device can't be removed from an account, so if a join string leaked, create a new account and re-join your other devices.";
                                                color: Theme.text-2;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                            }
                                            HorizontalLayout {
                                                alignment: start;
                                                Button {
                                                    text: "Join another account";
                                                    kind: ButtonKind.danger;
                                                    clicked => { root.confirm-join-other = true; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // A file dragged over the window: drop it to choose a device.
                        if root.drop-hover: Rectangle {
                            background: #0B0E14E6;
                            Rectangle {
                                x: 16px;
                                y: 16px;
                                width: parent.width - 32px;
                                height: parent.height - 32px;
                                border-radius: 14px;
                                border-width: 2px;
                                border-color: Theme.link;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 10px;
                                    HorizontalLayout {
                                        alignment: center;
                                        Icon {
                                            source: Icons.send;
                                            size: 28px;
                                            tint: Theme.link;
                                        }
                                    }
                                    Text {
                                        text: "Drop to send it to another device";
                                        color: Theme.text;
                                        font-size: 15px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        // The toast, 16 px above the bottom edge, centred.
                        Toast {
                            x: (parent.width - self.width) / 2;
                            y: parent.height - self.height - (root.toast-shown ? 16px : 8px);
                            text: root.toast-text;
                            good: root.toast-good;
                            shown: root.toast-shown;
                            animate y { duration: 180ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
                        }
                    }
                }
            }

            // Confirmation before leaving this account, over a scrim.
            if root.confirm-join-other: Rectangle {
                background: #00000099;

                TouchArea {
                    clicked => { root.confirm-join-other = false; }
                }

                SoftShadow {
                    x: (parent.width - 420px) / 2;
                    y: (parent.height - dialog.preferred-height) / 2;
                    width: 420px;
                    height: dialog.preferred-height;
                    radius: 14px;
                    offset-y: 12px;
                    blur: 32px;
                    spread: -6px;
                    strength: 0.6;
                    steps: 14;
                }

                Rectangle {
                    width: 420px;
                    height: dialog.preferred-height;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 14px;
                    border-width: 1px;
                    background: Theme.raised-2;
                    border-color: Theme.border;

                    TouchArea { }

                    dialog := VerticalLayout {
                        padding: 20px;
                        spacing: 0px;
                        Text {
                            text: "Join another account?";
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 620;
                            letter-spacing: -0.1px;
                        }
                        Rectangle { height: 6px; }
                        Text {
                            text: "This device leaves its current account. Your other devices keep syncing with each other, and the current account can only be rejoined with its join string.";
                            color: Theme.text-2;
                            font-size: 12.5px;
                            wrap: word-wrap;
                        }
                        Rectangle { height: 18px; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            Button {
                                text: "Cancel";
                                kind: ButtonKind.ghost;
                                clicked => { root.confirm-join-other = false; }
                            }
                            Button {
                                text: "Continue";
                                kind: ButtonKind.danger;
                                clicked => {
                                    root.confirm-join-other = false;
                                    root.open-screen(Screen.Join);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
