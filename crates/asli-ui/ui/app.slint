// The Asli window.
//
// One window, six screens, created only when somebody asks for it. The tray is still the front
// door: nothing here runs at startup, so an idle device pays for a tray icon and a socket and
// not for a user interface.
//
// The window draws its own frame. The title bar, the sidebar and the six screens are laid out to
// the redesign's measurements, and a frame supplied by the desktop would have put a second, foreign
// title bar above ours, different on every desktop it ran on.

import {
    SoftShadow, GradientFill, Theme, Icons, SyncState, States, Icon, Spinner, ButtonKind, Button, IconButton, Overline,
    Title, Subtitle, Caption, Label, Card, Divider, BannerKind, Banner, TextField, JoinArea,
    Toggle, Select, StateDot, Pill, Skeleton, Toast, Glow, Tile, ProgressBar
} from "design.slint";

export { SyncState }

// Which screen is showing. Held on the window so the tray can open any of them directly.
export enum Screen {
    FirstRun,
    Join,
    Token,
    History,
    Settings,
    Status,
}

// One history entry, flattened for drawing. The identifier stays on the Rust side and is looked
// up by row index, so nothing here ever holds a key or a full clipboard payload.
export struct HistoryRow {
    preview: string,
    meta: string,
    is-image: bool,
    // URLs and code read better in the monospaced face.
    mono: bool,
    thumb: image,
    has-thumb: bool,
}

// One device on the account, as the Status screen lists it.
export struct DeviceRow {
    name: string,
    os: string,
    id: string,
    seen: string,
    online: bool,
    this-device: bool,
    // Whether it can be removed from here: another device, which has sent a signed card, so the
    // new account key can be sealed to the ones that stay.
    removable: bool,
    // Whether a file can be sent to it now: removable, and connected.
    can-send: bool,
    // Which Asli it runs, or that it is too old to say.
    version: string,
    // Whether it runs an older Asli than the newest on the account.
    outdated: bool,
    // Whether it can only be taken off this list: it has no key of its own to remove it with.
    forgettable: bool,
    // Sending to it: 0 at rest, 1 waiting for an answer, 2 sending, 3 sent, 4 declined,
    // 5 called off, 6 failed. With what to say, and how far it has got.
    send-state: int,
    send-label: string,
    send-progress: float,
}

// A file dropped on the window, waiting in Ready to Send.
export struct ReadyFile {
    name: string,
    size: string,
}

// A device Ready to Send can go to.
export struct ReadyTarget {
    name: string,
    // Already sent this group.
    sent: bool,
}

// A file on its way to or from this device.
export struct FileRow {
    name: string,
    // "To MacBook" or "From MacBook".
    peer: string,
    // Size, and how far it has got or how it ended.
    detail: string,
    // 0 to 1 while it moves.
    progress: float,
    // Still under way, so it can be called off.
    live: bool,
    // Kept on this device, so its folder can be shown.
    can-show: bool,
    // Over, and it went well.
    good: bool,
}

// A device asking to join, on the device that approves it.
export struct AskRow {
    name: string,
    os: string,
    // The six digits the asking device shows, for a person to compare.
    comparison: string,
}

// Where adding a device has got to, on the device already on the account.
export enum InviteState {
    // No code made yet.
    idle,
    // A code is showing and requests can arrive.
    waiting,
    // Over: approved, turned down, expired or failed. invite-message says which.
    finished,
}

// How the join field feels about what has been typed into it so far.
export struct TokenCheck {
    valid: bool,
    invalid: bool,
    message: string,
}

// A screen fades in over 200 ms with a 6 px rise. The outgoing screen is cut, not cross faded.
component ScreenFrame inherits Rectangle {
    property <bool> entered: false;
    init => { entered = true; }
    opacity: entered ? 1 : 0;
    y: entered ? 0px : 6px;
    animate opacity, y { duration: 200ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
}

// A scrolling column with the design's overlay scrollbar: a 4 px thumb inset 3 px from the edge,
// laid over the content rather than taking width from it.
component Scroller inherits Rectangle {
    in property <length> content-height;
    out property <length> scroll-y: -flick.content-y;

    flick := Flickable {
        width: 100%;
        height: 100%;
        content-height: max(root.content-height, self.height);
        @children
    }

    if flick.content-height > flick.height + 1px: Rectangle {
        property <length> track: flick.height - 6px;
        property <length> span: max(28px, self.track * flick.height / flick.content-height);
        x: parent.width - 7px;
        width: 4px;
        height: self.span;
        y: 3px + (self.track - self.span) * (-flick.content-y) / (flick.content-height - flick.height);
        border-radius: 2px;
        background: thumb-touch.has-hover || thumb-touch.pressed ? Theme.border-strong : Theme.border;

        thumb-touch := TouchArea {
            property <length> start;
            moved => {
                if (self.pressed) {
                    flick.content-y = max(flick.height - flick.content-height, min(0px,
                        flick.content-y - (self.mouse-y - self.pressed-y) * flick.content-height / flick.height));
                }
            }
        }
    }
}

// An item in the sidebar: an icon tile, a title, and a line under it saying how things stand
// there. The highlight behind the selected item is shared and glides between items, so it is drawn
// by the sidebar, not here.
component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> sub;
    in property <image> icon;
    in property <bool> selected: false;
    // How many things on this screen wait for the person. Shown as a count while above zero.
    in property <int> badge: 0;
    callback clicked();

    // Even heights throughout, so the tile, the text block and the count sit on whole pixels.
    height: 54px;
    border-radius: 14px;
    background: !selected && touch.has-hover ? #FFFFFF0A : transparent;
    animate background { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    accessible-role: tab;
    accessible-label: text;
    accessible-item-selected: selected;
    accessible-action-default => { clicked(); }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Tile {
                icon: root.icon;
                on: root.selected;
                size: 32px;
                tint: touch.has-hover ? Theme.text-2 : Theme.text-3;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                height: 18px;
                text: root.text;
                color: root.selected || touch.has-hover ? Theme.text : Theme.text-2;
                font-size: 13.5px;
                font-weight: root.selected ? 700 : 600;
                vertical-alignment: center;
                animate color { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
            }
            if root.sub != "": Text {
                height: 14px;
                text: root.sub;
                color: root.selected ? Theme.text-2 : Theme.text-3;
                font-size: 11.5px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if root.badge > 0: VerticalLayout {
            alignment: center;
            Rectangle {
                width: max(20px, badge-text.preferred-width + 12px);
                height: 20px;
                border-radius: 10px;
                background: @linear-gradient(120deg, #FF7A6A 0%, #FF4D5E 100%);
                drop-shadow-color: #FF4D5E80;
                drop-shadow-blur: 10px;
                badge-text := Text {
                    text: root.badge;
                    color: #FFFFFF;
                    font-family: Theme.display;
                    font-size: 11.5px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// The sending control on a device's row. It is one piece that changes shape: Send File at rest,
// then waiting for the other device to accept with a way to call it off, then a progress bar, then
// for a moment how it ended, then Send File again. Its width glides between those, and each face
// fades into the next, so the row never jumps.
component SendControl inherits Rectangle {
    // 0 at rest, 1 waiting for an answer, 2 sending, 3 sent, 4 declined, 5 called off, 6 failed.
    in property <int> state: 0;
    in property <string> label;
    in property <float> progress: 0;
    in property <bool> can-send: true;
    callback send();
    callback cancel();

    property <bool> live: state == 1 || state == 2;
    property <color> ending-tone: state == 3 ? Theme.success
        : state == 4 ? Theme.warning
        : state == 6 ? Theme.error : Theme.text-2;

    width: state == 0 ? (can-send ? 116px : 0px)
        : state == 1 ? 296px
        : state == 2 ? 252px : ending.preferred-width;
    height: 30px;
    animate width { duration: 380ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

    // At rest.
    Button {
        width: parent.width;
        text: "Send File";
        small: true;
        icon: Icons.send;
        show-icon: true;
        enabled: root.can-send && root.state == 0;
        opacity: root.state == 0 && root.can-send ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 220ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        clicked => { root.send(); }
    }

    // Under way: waiting for an answer, or sending.
    Rectangle {
        border-radius: 9px;
        background: #6D7CFF1A;
        border-width: 1px;
        border-color: #6D7CFF59;
        opacity: root.live ? 1 : 0;
        visible: self.opacity > 0.01;
        clip: true;
        animate opacity { duration: 220ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

        // A band of light that sweeps across while it waits, so waiting reads as alive.
        if root.state == 1: Rectangle {
            x: (mod(animation-tick(), 1800ms) / 1800ms) * (parent.width + 120px) - 120px;
            width: 120px;
            background: @linear-gradient(90deg, #4FE3C100 0%, #4FE3C126 50%, #4FE3C100 100%);
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 3px;
            spacing: 8px;

            if root.state == 1: VerticalLayout {
                alignment: center;
                Spinner {
                    size: 13px;
                    tint: Theme.accent-2;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 4px;
                Text {
                    height: 14px;
                    text: root.label;
                    color: Theme.text;
                    font-size: 11.5px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.state == 2: ProgressBar {
                    progress: root.progress;
                    thickness: 4px;
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: cancel-text.preferred-width + 16px;
                    height: 24px;
                    border-radius: 7px;
                    background: cancel-touch.pressed ? #FF4D5E40 : cancel-touch.has-hover ? #FF4D5E26 : transparent;
                    animate background { duration: 140ms; }
                    cancel-text := Text {
                        text: "Cancel";
                        color: cancel-touch.has-hover ? Theme.danger-soft : Theme.text-2;
                        font-size: 11.5px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    cancel-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.cancel(); }
                    }
                }
            }
        }
    }

    // How it ended, for a moment.
    Rectangle {
        border-radius: 9px;
        background: root.ending-tone.with-alpha(0.12);
        border-width: 1px;
        border-color: root.ending-tone.with-alpha(0.35);
        opacity: root.state >= 3 ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 220ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

        ending := HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            spacing: 7px;
            alignment: center;
            VerticalLayout {
                alignment: center;
                Icon {
                    source: root.state == 3 ? Icons.check : Icons.alert;
                    size: 14px;
                    tint: root.ending-tone;
                    // The mark pops in.
                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                    transform-scale-x: root.state >= 3 ? 1 : 0.2;
                    transform-scale-y: root.state >= 3 ? 1 : 0.2;
                    animate transform-scale-x, transform-scale-y { duration: 450ms; easing: cubic-bezier(0.34, 1.32, 0.5, 1); }
                }
            }
            Text {
                text: root.label;
                color: root.ending-tone;
                font-size: 11.5px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
}

// One of the three caption buttons at the right of the title bar.
component CaptionButton inherits Rectangle {
    in property <image> icon;
    in property <bool> close: false;
    in property <string> label;
    callback clicked();

    width: 34px;
    height: 30px;
    border-radius: 8px;
    y: 7px;
    background: touch.pressed ? (close ? #A82418 : Theme.press)
        : touch.has-hover ? (close ? #C42B1C : Theme.raised-3) : transparent;
    animate background { duration: 140ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }

    Icon {
        source: root.icon;
        size: 11px;
        tint: touch.has-hover ? (root.close ? #FFFFFF : Theme.text) : Theme.text-3;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A card on the first run screen: one of the two ways in.
component ChoiceCard {
    in property <bool> primary: false;
    in property <string> title;
    in property <string> body;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> busy: false;
    callback clicked();

    min-height: card.min-height;
    preferred-height: card.preferred-height;
    horizontal-stretch: 1;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: title;
    accessible-description: body;
    accessible-action-default => { clicked(); }

    property <bool> hover: touch.has-hover && enabled;

    if root.primary: SoftShadow {
        y: card.y;
        radius: 14px;
        offset-y: 4px;
        blur: 12px;
        spread: -2px;
        strength: 0.45;
    }

    card := Rectangle {
        // Lifts a pixel under the pointer and settles back when pressed.
        y: root.hover && !touch.pressed ? -1px : 0px;
        width: 100%;
        height: 100%;
        border-radius: 14px;
        border-width: root.primary ? 0px : 1px;
        background: root.primary ? transparent : Theme.raised-1;
        border-color: root.hover ? Theme.border-strong : Theme.border-subtle;
        animate border-color { duration: 120ms; easing: cubic-bezier(0.2, 0, 0, 1); }
        animate y { duration: 80ms; easing: cubic-bezier(0.2, 0, 0, 1); }

        if root.primary: GradientFill {
            radius: 14px;
            angle: 145deg;
            from: Theme.hero-from;
            to: Theme.hero-to;
        }
        if root.primary: Rectangle {
            border-radius: 14px;
            border-width: 1px;
            border-color: root.hover ? Theme.accent : Theme.accent-border;
            animate border-color { duration: 120ms; easing: cubic-bezier(0.2, 0, 0, 1); }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 0px;

            HorizontalLayout {
                alignment: start;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: 9px;
                    border-width: 1px;
                    background: root.primary ? Theme.accent-soft : Theme.raised-2;
                    border-color: root.primary ? Theme.accent-border : Theme.border;

                    if !root.busy: Icon {
                        source: root.icon;
                        size: 16px;
                        tint: root.primary ? Theme.link : Theme.text-2;
                    }
                    if root.busy: Spinner {
                        size: 16px;
                        tint: Theme.link;
                    }
                }
            }
            Rectangle { height: 12px; }
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
            }
            Rectangle { height: 3px; }
            Caption {
                text: root.body;
            }
        }
    }

    Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: 18px;
        border-width: 2px;
        border-color: Theme.focus;
        opacity: focus.has-focus ? 1 : 0;
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// A key and its value, in the Connection card.
component DetailRow inherits HorizontalLayout {
    in property <string> key;
    in property <string> value;
    spacing: 16px;
    padding-top: 5px;
    padding-bottom: 5px;

    Text {
        width: 96px;
        text: root.key;
        color: Theme.text-3;
        font-size: 12px;
    }
    TextInput {
        horizontal-stretch: 1;
        text: root.value;
        read-only: true;
        color: Theme.text;
        font-size: 12px;
        font-family: Theme.mono;
        wrap: char-wrap;
        single-line: false;
        selection-background-color: #4C8DFF66;
        selection-foreground-color: Theme.text;
    }
}

// A switch with its title and explanation, in the This Device card.
component SettingRow inherits VerticalLayout {
    in property <string> title;
    in property <string> detail;
    in property <bool> mono-detail: false;
    in property <bool> last: false;
    in-out property <bool> checked;
    callback toggled(bool);

    HorizontalLayout {
        padding-top: 13px;
        padding-bottom: 13px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;

        VerticalLayout {
            spacing: 2px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 500;
            }
            Caption {
                text: root.detail;
                font-family: root.mono-detail ? Theme.mono : "";
                wrap: root.mono-detail ? char-wrap : word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            Toggle {
                label: root.title;
                checked <=> root.checked;
                toggled(on) => { root.toggled(on); }
            }
        }
    }
    if !root.last: Divider { }
}

export component AppWindow inherits Window {
    title: "Asli";
    // The title bar and taskbar icon on Windows and X11. Wayland takes it from the desktop entry
    // named by the app id instead. Rendered from packaging/linux/asli.svg, the one source of the
    // mark, and embedded at build time.
    icon: @image-url("../../../packaging/icons/asli-256.png");
    no-frame: true;
    // A frameless window still resizes from its edges, within this many pixels of them.
    resize-border-width: 6px;
    // Square, with the design's one pixel edge. The design rounds the window's corners, but the
    // software renderer hands the desktop an opaque surface, so a transparent corner comes out
    // black on every platform. Square is the better of the two.
    background: Theme.bg-2;
    min-width: 720px;
    min-height: 520px;
    preferred-width: 880px;
    preferred-height: 600px;
    default-font-size: 13px;
    default-font-family: Theme.ui;

    in property <bool> is-maximized: false;

    // Which screen is showing, and whether this device has an account at all. With no account
    // there is nothing to navigate between, so the sidebar is hidden and first run takes the window.
    in-out property <Screen> screen: Screen.Status;
    in property <bool> has-account: false;
    property <bool> chrome: screen != Screen.FirstRun && screen != Screen.Join;

    // The connection, shared by the Status hero, the sidebar footer and the History banner.
    in property <SyncState> sync-state: SyncState.connecting;
    in property <string> state-label: "Connecting…";
    in property <string> state-detail: "";
    in property <bool> paused: false;
    in property <bool> loading: false;

    // Status screen.
    in property <string> stat-connections: "";
    in property <string> stat-last-sync: "";
    in property <string> stat-skipped: "0";
    in property <bool> has-retained: false;
    in property <[DeviceRow]> devices: [];
    in property <string> relay-url-live: "";
    in property <string> room-id: "";
    in property <string> device-id: "";
    in property <string> clipboard-backend: "";

    // Join String screen.
    // Adding a device: the join code, its QR, how long it has left, and who is asking.
    in property <image> qr;
    in property <string> invite-code: "";
    in property <string> invite-remaining: "";
    in property <bool> invite-nearby-only: false;
    in property <InviteState> invite-state: InviteState.idle;
    in property <[AskRow]> invite-asking: [];
    in property <string> invite-message: "";
    in property <bool> invite-good: true;
    // Account security, on Status: whether the key was ever shown as an old style join string,
    // whether a key change is under way, and a question waiting for an answer.
    in property <bool> key-exposed: false;
    in property <bool> rekey-busy: false;
    in property <string> rekey-note: "";
    in property <string> confirm-title: "";
    in property <string> confirm-body: "";
    in property <string> confirm-action: "";
    // Files: what is moving, a file offered to this device, and a file dropped on the window.
    in property <[FileRow]> files: [];
    in property <bool> offer-waiting: false;
    in property <string> offer-from: "";
    in property <string> offer-name: "";
    in property <string> offer-size: "";
    // How many files the device offering them sent at once.
    in property <int> offer-count: 0;
    // Files dropped on the window, ready to send.
    in property <[ReadyFile]> ready-files: [];
    in property <string> ready-summary: "";
    in property <[ReadyTarget]> ready-targets: [];
    in property <string> ready-note: "";
    in property <bool> drop-hover: false;
    in property <string> update-note: "";
    in property <string> app-version: "";
    // Things on Status that wait for the person: a file offered to this device.
    in property <int> status-badge: 0;

    // First run.
    in property <bool> creating: false;
    in property <string> create-error: "";

    // Join screen.
    in-out property <string> join-input: "";
    in property <TokenCheck> join-check: { valid: false, invalid: false, message: "" };
    in property <bool> join-busy: false;
    in property <string> join-error: "";
    // Waiting for the other device to approve this one, and the digits to compare meanwhile.
    in property <bool> join-waiting: false;
    in property <string> join-comparison: "";

    // History screen.
    in property <[HistoryRow]> history: [];
    in property <bool> history-enabled: true;
    in property <string> history-note: "";

    // Settings screen. The fields are applied by Save; the switches take effect immediately,
    // because a switch that needs saving does not feel like a switch.
    in-out property <string> relay-url: "";
    in-out property <string> device-name: "";
    in-out property <int> size-cap-index: 1;
    in-out property <int> retention-index: 2;
    in-out property <bool> notifications: true;
    in-out property <bool> autostart: false;
    in-out property <bool> keep-history: true;
    in-out property <bool> same-network-only: false;
    in-out property <bool> confirm-leave: false;
    in property <string> saved-relay-url: "";
    in property <string> saved-device-name: "";
    in property <int> saved-size-cap-index: 1;
    in property <int> saved-retention-index: 2;
    in property <string> settings-note: "";
    in property <bool> settings-saving: false;
    in property <string> autostart-detail: "";
    property <string> relay-lower: root.relay-url.to-lowercase();
    property <bool> relay-invalid: !(relay-lower.starts-with("wss://") || relay-lower.starts-with("ws://"))
        || relay-lower.character-count < 7;
    property <bool> settings-dirty: relay-url != saved-relay-url || device-name != saved-device-name
        || size-cap-index != saved-size-cap-index || retention-index != saved-retention-index;
    property <bool> settings-saved-flash: false;

    // Transient state owned by the markup.
    property <string> toast-text;
    property <bool> toast-good: true;
    property <bool> toast-shown: false;
    property <bool> confirm-clear: false;
    property <bool> confirm-join-other: false;

    callback open-screen(Screen);
    callback create-account();
    callback join-account(string);
    callback check-token(string);
    callback cancel-join();
    callback open-invite();
    callback close-invite();
    callback approve-request(int);
    callback decline-request(int);
    callback ask-remove(int);
    callback forget-device(int);
    callback ask-replace-key();
    callback confirm-yes();
    callback confirm-no();
    callback send-file(int);
    callback accept-offer();
    callback decline-offer();
    callback cancel-file(int);
    callback show-file(int);
    callback copy-invite-code();
    callback open-releases();
    callback clear-files();
    callback ready-send(int);
    callback ready-send-all();
    callback ready-done();
    callback ready-remove(int);
    callback cancel-device-send(int);
    callback restore-entry(int);
    callback copy-entry(int);
    callback forget-entry(int);
    callback clear-history();
    callback set-paused(bool);
    callback retry-now();
    callback request-retained();
    callback copy-diagnostics();
    callback save-settings();
    callback revert-settings();
    callback set-notifications(bool);
    callback set-autostart(bool);
    callback set-keep-history(bool);
    callback set-same-network-only(bool);
    callback leave-account();
    callback hide-window();
    // Where the pointer is, in window coordinates, so the release can be handed back.
    callback start-drag(length, length);
    callback minimize-window();
    callback toggle-maximize();

    // Shows a short confirmation near the bottom of the window for 2.4 seconds.
    public function show-toast(text: string, good: bool) {
        root.toast-text = text;
        root.toast-good = good;
        root.toast-shown = true;
        toast-timer.running = false;
        toast-timer.running = true;
    }

    // Called once a save has gone through.
    public function settings-saved() {
        root.settings-saved-flash = true;
        saved-timer.running = false;
        saved-timer.running = true;
    }


    toast-timer := Timer {
        interval: 2400ms;
        running: false;
        triggered => {
            root.toast-shown = false;
            self.running = false;
        }
    }
    saved-timer := Timer {
        interval: 2000ms;
        running: false;
        triggered => {
            root.settings-saved-flash = false;
            self.running = false;
        }
    }

    clear-timer := Timer {
        interval: 4000ms;
        running: root.confirm-clear;
        triggered => { root.confirm-clear = false; }
    }

    // Escape closes a dialog first, then the window, rather than quitting: the daemon outlives
    // the window, and a person closing a tray window means "go away", never "stop syncing".
    forward-focus: shortcuts;
    shortcuts := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.confirm-join-other) {
                    root.confirm-join-other = false;
                } else {
                    root.hide-window();
                }
                return accept;
            }
            if (event.modifiers.control && root.chrome) {
                if (event.text == "1") { root.open-screen(Screen.Status); return accept; }
                if (event.text == "2") { root.open-screen(Screen.History); return accept; }
                if (event.text == "3") { root.open-screen(Screen.Token); return accept; }
                if (event.text == "4") { root.open-screen(Screen.Settings); return accept; }
            }
            return reject;
        }

        // The whole window, with its own one pixel edge, which a maximised window does without.
        frame := Rectangle {
            border-width: root.is-maximized ? 0px : 1px;
            border-color: #FFFFFF14;
            background: @linear-gradient(180deg, #1A1921 0%, #0F0E14 100%);
            clip: true;

            // The light the window sits in: three very faint pools of the accent colours, one high on
            // the left, one low on the right, one in the middle. Still, not drifting: motion here
            // would keep the window redrawing for as long as it is open.
            Rectangle {
                x: -180px;
                y: -260px;
                width: 620px;
                height: 620px;
                background: @radial-gradient(circle, #4FE3C138 0%, #4FE3C100 70%);
            }
            Rectangle {
                x: frame.width - 700px + 260px;
                y: frame.height - 700px + 320px;
                width: 700px;
                height: 700px;
                background: @radial-gradient(circle, #6D7CFF3D 0%, #6D7CFF00 70%);
            }
            Rectangle {
                x: frame.width * 0.42 - 210px;
                y: frame.height * 0.3 - 210px;
                width: 420px;
                height: 420px;
                background: @radial-gradient(circle, #5EB0E01F 0%, #5EB0E000 70%);
            }

            VerticalLayout {
                padding: frame.border-width;

                // The title bar. All of it drags the window except the three buttons.
                Rectangle {
                    height: 44px;

                    // The move starts once the pointer moves with the button held, not on the
                    // press, so a double click still reaches the maximise below.
                    drag := TouchArea {
                        moved => {
                            if (self.pressed) {
                                root.start-drag(self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                            }
                        }
                        double-clicked => { root.toggle-maximize(); }
                    }

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 8px;
                        spacing: 9px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: Icons.mark;
                                width: 18px;
                                height: 18px;
                            }
                        }
                        Text {
                            text: "Asli";
                            color: Theme.text;
                            font-size: 12.5px;
                            font-weight: 700;
                            letter-spacing: 0.2px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "v" + root.app-version;
                            color: Theme.text-3;
                            font-family: Theme.display;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        HorizontalLayout {
                            spacing: 2px;
                            CaptionButton {
                                icon: Icons.win-minimize;
                                label: "Minimize to Tray";
                                clicked => { root.minimize-window(); }
                            }
                            CaptionButton {
                                icon: Icons.win-maximize;
                                label: root.is-maximized ? "Restore" : "Maximize";
                                clicked => { root.toggle-maximize(); }
                            }
                            CaptionButton {
                                icon: Icons.win-close;
                                close: true;
                                label: "Close";
                                clicked => { root.hide-window(); }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    padding-right: root.chrome ? 10px : 0px;
                    padding-bottom: root.chrome ? 10px : 0px;

                    // The sidebar. Absent on first run and join, which take the whole window.
                    if root.chrome: Rectangle {
                        width: 236px;

                        VerticalLayout {
                            padding-top: 8px;
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-bottom: 14px;

                            // The items, with the one highlight that glides to the selected item.
                            Rectangle {
                                property <int> index: root.screen == Screen.Status ? 0
                                    : root.screen == Screen.History ? 1
                                    : root.screen == Screen.Token ? 2
                                    : root.screen == Screen.Settings ? 3 : -1;
                                height: nav.preferred-height;

                                if self.index >= 0: Rectangle {
                                    y: parent.index * (54px + 4px);
                                    height: 54px;
                                    border-radius: 14px;
                                    background: @linear-gradient(90deg, #6D7CFF29 0%, #FFFFFF05 100%);
                                    border-width: 1px;
                                    border-color: #6D7CFF47;
                                    drop-shadow-color: #6D7CFF40;
                                    drop-shadow-blur: 22px;
                                    drop-shadow-offset-y: 8px;
                                    animate y { duration: 350ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                                }

                                nav := VerticalLayout {
                                    spacing: 4px;
                                    NavItem {
                                        text: "Home";
                                        sub: root.state-label;
                                        badge: root.status-badge;
                                        icon: Icons.shield;
                                        selected: root.screen == Screen.Status;
                                        clicked => { root.open-screen(Screen.Status); }
                                    }
                                    NavItem {
                                        text: "History";
                                        sub: root.history.length == 0 ? "Nothing Yet"
                                            : root.history.length == 1 ? "1 Clip" : root.history.length + " Clips";
                                        icon: Icons.history;
                                        selected: root.screen == Screen.History;
                                        clicked => { root.open-screen(Screen.History); }
                                    }
                                    NavItem {
                                        text: "Add a Device";
                                        sub: root.invite-asking.length > 0 ? "Someone is Asking"
                                            : root.invite-state == InviteState.waiting ? "Code is Open" : "With a Join Code";
                                        badge: root.invite-asking.length;
                                        icon: Icons.key;
                                        selected: root.screen == Screen.Token;
                                        clicked => { root.open-screen(Screen.Token); }
                                    }
                                    NavItem {
                                        text: "Settings";
                                        sub: "Relay, Device, Account";
                                        icon: Icons.settings;
                                        selected: root.screen == Screen.Settings;
                                        clicked => { root.open-screen(Screen.Settings); }
                                    }
                                }
                            }

                            Rectangle { vertical-stretch: 1; }

                            // The connection at a glance, from every screen. 48 high inside its
                            // ring, so the dot sits exactly in the middle.
                            Rectangle {
                                height: 50px;
                                border-radius: 16px;
                                background: #FFFFFF08;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    y: 1px;
                                    height: 48px;
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 9px;
                                    VerticalLayout {
                                        alignment: center;
                                        StateDot {
                                            state: root.sync-state;
                                        }
                                    }
                                    Text {
                                        text: root.state-label;
                                        color: Theme.text;
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: "v" + root.app-version;
                                        color: Theme.text-3;
                                        font-family: Theme.display;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // The content, in a pane of its own that catches a little of the light.
                    content := Rectangle {
                        horizontal-stretch: 1;
                        border-radius: root.chrome ? 22px : 0px;
                        background: root.chrome ? @linear-gradient(180deg, #FFFFFF09 0%, #FFFFFF04 100%) : transparent;
                        border-width: root.chrome ? 1px : 0px;
                        border-color: #FFFFFF0F;
                        clip: true;

                        // ─────────────────────────── First run ───────────────────────────
                        if root.screen == Screen.FirstRun: ScreenFrame {
                            VerticalLayout {
                                padding-left: 64px;
                                padding-right: 64px;
                                alignment: center;

                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 72px;
                                        height: 72px;
                                        SoftShadow {
                                            radius: 17px;
                                            // Wider than the design's 28 px on paper: CSS
                                            // filter shadows take that as a deviation, not a
                                            // radius, and this matches what it renders.
                                            offset-y: 12px;
                                            blur: 44px;
                                            tint: #2F73F0;
                                            strength: 0.42;
                                            steps: 20;
                                        }
                                        Image {
                                            source: Icons.app-icon;
                                            width: 72px;
                                            height: 72px;
                                        }
                                    }
                                }
                                Rectangle { height: 20px; }
                                Text {
                                    text: "Welcome to Asli";
                                    color: Theme.text;
                                    font-size: 24px;
                                    font-weight: 650;
                                    letter-spacing: -0.3px;
                                    horizontal-alignment: center;
                                }
                                Rectangle { height: 6px; }
                                HorizontalLayout {
                                    alignment: center;
                                    Subtitle {
                                        width: min(380px, parent.width);
                                        text: "One clipboard across your computers. Copy here, paste there, sealed end to end, so the relay only ever sees noise.";
                                        horizontal-alignment: center;
                                    }
                                }
                                Rectangle { height: 28px; }

                                if root.create-error != "": HorizontalLayout {
                                    alignment: center;
                                    padding-bottom: 12px;
                                    Banner {
                                        width: min(480px, parent.width);
                                        kind: BannerKind.error;
                                        title: "Couldn't Create the Account";
                                        body: root.create-error;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        width: min(480px, parent.width);
                                        spacing: 12px;
                                        opacity: root.creating ? 0.45 : 1;
                                        ChoiceCard {
                                            primary: true;
                                            icon: Icons.plus;
                                            title: "Create a New Account";
                                            body: "Start fresh on this device and invite the others.";
                                            enabled: !root.creating;
                                            busy: root.creating;
                                            clicked => { root.create-account(); }
                                        }
                                        ChoiceCard {
                                            icon: Icons.key;
                                            title: "Join an Existing Account";
                                            body: "Type a join code from another device.";
                                            enabled: !root.creating;
                                            clicked => { root.open-screen(Screen.Join); }
                                        }
                                    }
                                }
                                Rectangle { height: 24px; }
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 7px;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            source: Icons.shield;
                                            size: 13px;
                                            tint: Theme.text-4;
                                        }
                                    }
                                    Text {
                                        text: "Keys Never Leave Your Devices";
                                        color: Theme.text-4;
                                        font-size: 11.5px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // ───────────────────────────── Join ──────────────────────────────
                        if root.screen == Screen.Join: ScreenFrame {
                            VerticalLayout {
                                padding-top: 20px;
                                padding-bottom: 20px;
                                padding-left: 24px;
                                padding-right: 24px;

                                HorizontalLayout {
                                    alignment: start;
                                    back := Rectangle {
                                        height: 28px;
                                        width: back-row.preferred-width;
                                        border-radius: 8px;
                                        background: back-touch.has-hover ? Theme.hairline : transparent;
                                        animate background { duration: 120ms; }
                                        accessible-role: button;
                                        accessible-label: "Back";
                                        accessible-action-default => { back-touch.clicked(); }

                                        back-row := HorizontalLayout {
                                            padding-left: 7px;
                                            padding-right: 10px;
                                            spacing: 5px;
                                            VerticalLayout {
                                                alignment: center;
                                                Icon {
                                                    source: Icons.back;
                                                    size: 14px;
                                                    tint: back-touch.has-hover ? Theme.text : Theme.text-2;
                                                }
                                            }
                                            Text {
                                                text: "Back";
                                                color: back-touch.has-hover ? Theme.text : Theme.text-2;
                                                font-size: 12px;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                        back-touch := TouchArea {
                                            clicked => {
                                                root.open-screen(root.has-account ? Screen.Settings : Screen.FirstRun);
                                            }
                                        }
                                    }
                                }

                                // The form, centred with a 28 px optical lift.
                                VerticalLayout {
                                    alignment: center;
                                    vertical-stretch: 1;
                                    padding-bottom: 28px;

                                    HorizontalLayout {
                                        alignment: center;
                                        VerticalLayout {
                                            width: min(440px, parent.width);
                                            spacing: 0px;

                                            Title { text: root.join-waiting ? "Approve This Device" : "Join an Existing Account"; }
                                            Rectangle { height: 5px; }
                                            if !root.join-waiting: StyledText {
                                                text: @markdown("On a device that is already set up, open <font color=\"#E9EDF6\">Add a Device</font> and make a join code, then type it here.");
                                                default-color: Theme.text-2;
                                                default-font-size: 13px;
                                            }
                                            if root.join-waiting: VerticalLayout {
                                                spacing: 0px;
                                                Caption {
                                                    text: "Your other device is asking whether to let this one in. Approve it there only if it shows the same six digits as here.";
                                                    color: Theme.text-2;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                }
                                                Rectangle { height: 22px; }
                                                Overline { text: "THIS DEVICE SHOWS"; }
                                                Rectangle { height: 8px; }
                                                Text {
                                                    text: root.join-comparison;
                                                    color: Theme.text;
                                                    font-size: 34px;
                                                    font-weight: 600;
                                                    font-family: Theme.mono;
                                                    letter-spacing: 2px;
                                                }
                                                Rectangle { height: 18px; }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text {
                                                        text: "Waiting for Approval…";
                                                        color: Theme.text-3;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle { horizontal-stretch: 1; }
                                                    Button {
                                                        text: "Cancel";
                                                        clicked => { root.cancel-join(); }
                                                    }
                                                }
                                            }
                                            if !root.join-waiting: Rectangle { height: 20px; }
                                            if !root.join-waiting: Label { text: "Join Code"; }
                                            if !root.join-waiting: Rectangle { height: 6px; }
                                            join-field := JoinArea {
                                                visible: !root.join-waiting;
                                                height: root.join-waiting ? 0px : self.preferred-height;
                                                placeholder: "asli2_…";
                                                text <=> root.join-input;
                                                invalid: root.join-check.invalid;
                                                read-only: root.join-busy;
                                                edited(value) => { root.check-token(value); }
                                                accepted(value) => {
                                                    if (root.join-check.valid && !root.join-busy) {
                                                        root.join-account(value);
                                                    }
                                                }
                                            }

                                            // The verdict names the specific mistake: a wrong prefix,
                                            // a bad checksum and a truncated string are different
                                            // problems and only one means "the wrong string".
                                            if root.join-check.invalid && !root.join-waiting: HorizontalLayout {
                                                padding-top: 7px;
                                                spacing: 6px;
                                                VerticalLayout {
                                                    padding-top: 1px;
                                                    alignment: start;
                                                    Icon {
                                                        source: Icons.alert;
                                                        size: 14px;
                                                        tint: Theme.error;
                                                    }
                                                }
                                                Caption {
                                                    text: root.join-check.message;
                                                    color: Theme.error;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                            if !root.join-check.invalid && !root.join-waiting: VerticalLayout {
                                                padding-top: 7px;
                                                Caption {
                                                    text: root.has-account
                                                        ? "Joining replaces the account on this device."
                                                        : "A code works once, for ten minutes, and only when the other device approves this one.";
                                                }
                                            }

                                            Rectangle { height: 16px; }

                                            if root.join-error != "": VerticalLayout {
                                                padding-bottom: 12px;
                                                Banner {
                                                    kind: BannerKind.error;
                                                    title: root.join-error;
                                                }
                                            }

                                            if !root.join-waiting: HorizontalLayout {
                                                spacing: 8px;
                                                Button {
                                                    text: root.join-busy ? "Joining…" : "Join Account";
                                                    kind: ButtonKind.primary;
                                                    busy: root.join-busy;
                                                    enabled: root.join-check.valid;
                                                    clicked => { root.join-account(root.join-input); }
                                                }
                                                Button {
                                                    text: "Paste";
                                                    icon: Icons.paste;
                                                    show-icon: true;
                                                    enabled: !root.join-busy;
                                                    clicked => { join-field.paste-over(); }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ─────────────────────────── Add a Device ────────────────────────
                        if root.screen == Screen.Token: ScreenFrame {
                            Scroller {
                                content-height: invite-screen.preferred-height;

                                invite-screen := VerticalLayout {
                                    padding-top: 20px;
                                    padding-bottom: 24px;
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    spacing: 0px;
                                    alignment: start;

                                    Title { text: "Add a Device"; }
                                    Rectangle { height: 4px; }
                                    Subtitle {
                                        text: "Make a join code here, type it on the new device, then approve it here.";
                                        wrap: word-wrap;
                                    }
                                    Rectangle { height: 18px; }

                                    if root.invite-state == InviteState.idle: VerticalLayout {
                                        spacing: 0px;
                                        HorizontalLayout {
                                            alignment: start;
                                            Button {
                                                text: "Create a Join Code";
                                                kind: ButtonKind.primary;
                                                pad-x: 14px;
                                                clicked => { root.open-invite(); }
                                            }
                                        }
                                        Rectangle { height: 14px; }
                                        HorizontalLayout {
                                            spacing: 7px;
                                            VerticalLayout {
                                                alignment: center;
                                                Icon {
                                                    source: Icons.shield;
                                                    size: 13px;
                                                    tint: Theme.text-3;
                                                }
                                            }
                                            Caption {
                                                text: "A code works once, for ten minutes, and lets nobody in until you approve them here. It does not contain your account key.";
                                                horizontal-stretch: 1;
                                                wrap: word-wrap;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    if root.invite-state == InviteState.waiting: HorizontalLayout {
                                        spacing: 20px;

                                        // The QR plate is white whatever the theme: a symbol
                                        // inverted by a dark theme is unreadable to most cameras.
                                        VerticalLayout {
                                            alignment: start;
                                            Rectangle {
                                                width: 171px;
                                                height: 171px;
                                                SoftShadow {
                                                    radius: 14px;
                                                    offset-y: 12px;
                                                    blur: 32px;
                                                    spread: -6px;
                                                    strength: 0.6;
                                                    steps: 14;
                                                }
                                                Rectangle {
                                                    border-radius: 14px;
                                                    background: #FFFFFF;
                                                    Image {
                                                        x: 12px;
                                                        y: 12px;
                                                        width: 147px;
                                                        height: 147px;
                                                        source: root.qr;
                                                        image-rendering: pixelated;
                                                    }
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: start;
                                            spacing: 0px;

                                            Overline { text: "JOIN CODE"; }
                                            Rectangle { height: 8px; }
                                            Rectangle {
                                                border-radius: 10px;
                                                border-width: 1px;
                                                background: Theme.input;
                                                border-color: Theme.border;
                                                height: code-text.preferred-height + 22px;

                                                code-text := TextInput {
                                                    x: 12px;
                                                    y: 11px;
                                                    width: parent.width - 24px;
                                                    text: root.invite-code;
                                                    read-only: true;
                                                    color: Theme.text;
                                                    font-size: 14px;
                                                    font-family: Theme.mono;
                                                    letter-spacing: 0.4px;
                                                    wrap: char-wrap;
                                                    single-line: false;
                                                    selection-background-color: #4C8DFF66;
                                                    selection-foreground-color: Theme.text;
                                                }
                                            }
                                            Rectangle { height: 8px; }
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Caption {
                                                    text: "Works once. Expires in " + root.invite-remaining + "."
                                                        + (root.invite-nearby-only ? " Only a device on this network can use it." : "");
                                                    wrap: word-wrap;
                                                    horizontal-stretch: 1;
                                                    vertical-alignment: center;
                                                }
                                                Button {
                                                    text: "Copy Code";
                                                    small: true;
                                                    icon: Icons.copy;
                                                    show-icon: true;
                                                    clicked => { root.copy-invite-code(); }
                                                }
                                                Button {
                                                    text: "Cancel";
                                                    small: true;
                                                    clicked => { root.close-invite(); }
                                                }
                                            }
                                            Rectangle { height: 16px; }

                                            if root.invite-asking.length == 0: Caption {
                                                text: "On the new device, choose Join an Existing Account and type this code. Its request appears here.";
                                                wrap: word-wrap;
                                            }

                                            for ask[i] in root.invite-asking: VerticalLayout {
                                                padding-bottom: 10px;
                                                Card {
                                                    height: ask-body.preferred-height;
                                                    ask-body := VerticalLayout {
                                                        padding-top: 14px;
                                                        padding-bottom: 14px;
                                                        padding-left: 16px;
                                                        padding-right: 16px;
                                                        spacing: 0px;
                                                        Text {
                                                            text: ask.name + " Wants to Join";
                                                            color: Theme.text;
                                                            font-size: 13.5px;
                                                            font-weight: 600;
                                                            overflow: elide;
                                                        }
                                                        if ask.os != "": Text {
                                                            text: ask.os;
                                                            color: Theme.text-3;
                                                            font-size: 11.5px;
                                                        }
                                                        Rectangle { height: 10px; }
                                                        Caption {
                                                            text: "Approve only if the new device shows:";
                                                        }
                                                        Rectangle { height: 4px; }
                                                        Text {
                                                            text: ask.comparison;
                                                            color: Theme.text;
                                                            font-size: 26px;
                                                            font-weight: 600;
                                                            font-family: Theme.mono;
                                                            letter-spacing: 2px;
                                                        }
                                                        Rectangle { height: 12px; }
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            alignment: start;
                                                            Button {
                                                                text: "Approve";
                                                                kind: ButtonKind.primary;
                                                                icon: Icons.check;
                                                                show-icon: true;
                                                                clicked => { root.approve-request(i); }
                                                            }
                                                            Button {
                                                                text: "Decline";
                                                                clicked => { root.decline-request(i); }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    if root.invite-state == InviteState.finished: VerticalLayout {
                                        spacing: 0px;
                                        Banner {
                                            kind: root.invite-good ? BannerKind.info : BannerKind.warning;
                                            icon: root.invite-good ? Icons.check : Icons.alert;
                                            title: root.invite-message;
                                        }
                                        Rectangle { height: 14px; }
                                        HorizontalLayout {
                                            alignment: start;
                                            Button {
                                                text: "Add Another Device";
                                                pad-x: 14px;
                                                clicked => { root.open-invite(); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ──────────────────────────── History ────────────────────────────
                        if root.screen == Screen.History: ScreenFrame {
                            VerticalLayout {
                                // The header stays put while the list scrolls under it.
                                Rectangle {
                                    height: header.preferred-height;
                                    header := HorizontalLayout {
                                        padding-top: 20px;
                                        padding-bottom: 14px;
                                        padding-left: 24px;
                                        padding-right: 24px;
                                        spacing: 16px;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 4px;
                                            Title { text: "History"; }
                                            Subtitle { text: "Click an entry to put it back on the clipboard of every device."; }
                                        }

                                        if root.history.length > 0 && !root.confirm-clear: VerticalLayout {
                                            alignment: start;
                                            Button {
                                                text: "Clear All";
                                                icon: Icons.trash;
                                                show-icon: true;
                                                kind: ButtonKind.destructive;
                                                clicked => { root.confirm-clear = true; }
                                            }
                                        }
                                        // Confirmed inline for four seconds rather than in a dialog.
                                        if root.history.length > 0 && root.confirm-clear: HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            Text {
                                                text: "Clear " + root.history.length + (root.history.length == 1 ? " clip?" : " clips?");
                                                color: Theme.text-2;
                                                font-size: 12px;
                                                font-weight: 500;
                                                height: 34px;
                                                vertical-alignment: center;
                                            }
                                            VerticalLayout {
                                                alignment: start;
                                                Button {
                                                    text: "Clear";
                                                    kind: ButtonKind.danger;
                                                    clicked => {
                                                        root.confirm-clear = false;
                                                        root.clear-history();
                                                    }
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: start;
                                                Button {
                                                    text: "Cancel";
                                                    kind: ButtonKind.ghost;
                                                    clicked => { root.confirm-clear = false; }
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        y: parent.height - 1px;
                                        height: 1px;
                                        background: Theme.hairline;
                                    }
                                }

                                if root.sync-state == SyncState.offline || root.sync-state == SyncState.error: VerticalLayout {
                                    padding-top: 12px;
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    Banner {
                                        kind: BannerKind.info;
                                        icon: Icons.offline;
                                        title: "Offline. History is local until you reconnect.";
                                    }
                                }

                                if !root.history-enabled: Rectangle {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        alignment: center;
                                        padding-bottom: 24px;
                                        HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 64px;
                                                height: 64px;
                                                SoftShadow {
                                                    radius: 18px;
                                                    offset-y: 12px;
                                                    blur: 32px;
                                                    spread: -12px;
                                                    strength: 0.8;
                                                    steps: 14;
                                                }
                                              GradientFill {
                                                radius: 18px;
                                                angle: 145deg;
                                                from: Theme.hero-from;
                                                to: Theme.hero-to;
                                              }
                                              Rectangle {
                                                border-radius: 18px;
                                                border-width: 1px;
                                                border-color: Theme.border;
                                                Icon {
                                                    source: Icons.history;
                                                    size: 26px;
                                                    tint: Theme.border-strong;
                                                }
                                              }
                                            }
                                        }
                                        Rectangle { height: 16px; }
                                        Text {
                                            text: "History is Off";
                                            color: Theme.text;
                                            font-size: 15px;
                                            font-weight: 620;
                                            letter-spacing: -0.1px;
                                            horizontal-alignment: center;
                                        }
                                        Rectangle { height: 5px; }
                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                width: min(300px, parent.width);
                                                text: "Turn it on in Settings to keep a local, encrypted list of what you copied.";
                                                color: Theme.text-3;
                                                font-size: 12.5px;
                                                wrap: word-wrap;
                                                horizontal-alignment: center;
                                            }
                                        }
                                        Rectangle { height: 16px; }
                                        HorizontalLayout {
                                            alignment: center;
                                            Button {
                                                text: "Open Settings";
                                                small: true;
                                                clicked => { root.open-screen(Screen.Settings); }
                                            }
                                        }
                                    }
                                }

                                if root.history-enabled && root.history.length == 0: Rectangle {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        alignment: center;
                                        padding-left: 48px;
                                        padding-right: 48px;
                                        padding-bottom: 24px;
                                        HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 64px;
                                                height: 64px;
                                                SoftShadow {
                                                    radius: 18px;
                                                    offset-y: 12px;
                                                    blur: 32px;
                                                    spread: -12px;
                                                    strength: 0.8;
                                                    steps: 14;
                                                }
                                              GradientFill {
                                                radius: 18px;
                                                angle: 145deg;
                                                from: Theme.hero-from;
                                                to: Theme.hero-to;
                                              }
                                              Rectangle {
                                                border-radius: 18px;
                                                border-width: 1px;
                                                border-color: Theme.border;
                                                Icon {
                                                    source: Icons.copy;
                                                    size: 26px;
                                                    tint: Theme.border-strong;
                                                }
                                              }
                                            }
                                        }
                                        Rectangle { height: 16px; }
                                        Text {
                                            text: "Nothing Copied Yet";
                                            color: Theme.text;
                                            font-size: 15px;
                                            font-weight: 620;
                                            letter-spacing: -0.1px;
                                            horizontal-alignment: center;
                                        }
                                        Rectangle { height: 5px; }
                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                width: min(300px, parent.width);
                                                text: "Copy something on any paired device and it shows up here within a second.";
                                                color: Theme.text-3;
                                                font-size: 12.5px;
                                                wrap: word-wrap;
                                                horizontal-alignment: center;
                                            }
                                        }
                                        Rectangle { height: 16px; }
                                        HorizontalLayout {
                                            alignment: center;
                                            Button {
                                                text: "Add Another Device";
                                                small: true;
                                                clicked => { root.open-screen(Screen.Token); }
                                            }
                                        }
                                    }
                                }

                                if root.history-enabled && root.history.length > 0: Scroller {
                                    vertical-stretch: 1;
                                    content-height: rows.preferred-height;

                                    rows := VerticalLayout {
                                        padding-top: 12px;
                                        padding-bottom: 20px;
                                        padding-left: 24px;
                                        padding-right: 24px;
                                        spacing: 8px;
                                        alignment: start;

                                        for entry[index] in root.history: Rectangle {
                                            height: entry.has-thumb ? 74px : 62px;
                                            // Nothing a row holds may paint over the next one,
                                            // whatever arrives in it. The preview is already one
                                            // line; this is the backstop.
                                            clip: true;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            background: row-touch.has-hover ? Theme.raised-2 : Theme.raised-1;
                                            border-color: row-touch.has-hover ? Theme.border-strong : Theme.border-subtle;
                                            transform-origin: { x: self.width / 2, y: self.height / 2 };
                                            transform-scale-x: row-touch.pressed ? 99.5% : 100%;
                                            transform-scale-y: row-touch.pressed ? 99.5% : 100%;
                                            animate background, border-color { duration: 120ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                                            animate transform-scale-x, transform-scale-y { duration: 80ms; }
                                            accessible-role: list-item;
                                            accessible-label: entry.is-image ? "Image" : entry.preview;
                                            accessible-description: entry.meta;
                                            accessible-action-default => { root.restore-entry(index); }

                                            row-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.restore-entry(index); }
                                            }

                                            HorizontalLayout {
                                                padding-top: 11px;
                                                padding-bottom: 11px;
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                spacing: 12px;

                                                // Type tile: blue for text, green for an image, and
                                                // a different glyph for each, so the two are told
                                                // apart by shape as well as by hue.
                                                if !entry.has-thumb: VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 38px;
                                                        height: 38px;
                                                        border-radius: 9px;
                                                        border-width: 1px;
                                                        background: entry.is-image ? #3DD68C1A : #4C8DFF1A;
                                                        border-color: entry.is-image ? Theme.success-border : Theme.accent-border;
                                                        Icon {
                                                            source: entry.is-image ? Icons.image : Icons.text;
                                                            size: 16px;
                                                            tint: entry.is-image ? Theme.success : Theme.link;
                                                        }
                                                    }
                                                }
                                                // The thumbnail arrives with its corners already
                                                // rounded: this renderer cannot clip to a radius.
                                                if entry.has-thumb: VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 50px;
                                                        height: 50px;
                                                        Image {
                                                            width: 100%;
                                                            height: 100%;
                                                            source: entry.thumb;
                                                            image-fit: cover;
                                                        }
                                                        Rectangle {
                                                            border-radius: 9px;
                                                            border-width: 1px;
                                                            border-color: Theme.border;
                                                        }
                                                    }
                                                }

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    spacing: 2px;
                                                    Text {
                                                        height: 20px;
                                                        vertical-alignment: center;
                                                        text: entry.preview;
                                                        color: Theme.text;
                                                        font-size: entry.mono ? 12.5px : 13px;
                                                        font-family: entry.mono ? Theme.mono : "";
                                                        wrap: no-wrap;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        height: 16px;
                                                        vertical-alignment: center;
                                                        text: entry.meta;
                                                        color: Theme.text-3;
                                                        font-size: 11.5px;
                                                        letter-spacing: 0.1px;
                                                        overflow: elide;
                                                    }
                                                }

                                                HorizontalLayout {
                                                    spacing: 2px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        IconButton {
                                                            icon: Icons.copy;
                                                            label: "Copy on This Device Only";
                                                            clicked => { root.copy-entry(index); }
                                                        }
                                                    }
                                                    VerticalLayout {
                                                        alignment: center;
                                                        IconButton {
                                                            icon: Icons.trash;
                                                            destructive: true;
                                                            label: "Delete";
                                                            clicked => { root.forget-entry(index); }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        if root.history-note != "": Caption {
                                            text: root.history-note;
                                            color: Theme.text-4;
                                            horizontal-alignment: center;
                                            height: self.preferred-height + 4px;
                                            vertical-alignment: bottom;
                                        }
                                    }
                                }
                            }
                        }

                        // ──────────────────────────── Status ─────────────────────────────
                        if root.screen == Screen.Status: ScreenFrame {
                            Scroller {
                                content-height: status-screen.preferred-height;

                                status-screen := VerticalLayout {
                                    padding-top: 22px;
                                    padding-bottom: 26px;
                                    padding-left: 28px;
                                    padding-right: 28px;
                                    spacing: 0px;
                                    alignment: start;

                                    Title { text: "Home"; }
                                    Rectangle { height: 18px; }

                                    // A question about the account waiting for an answer: removing a
                                    // device, or replacing the key.
                                    if root.confirm-title != "": VerticalLayout {
                                        padding-bottom: 14px;
                                        Card {
                                            height: confirm-body-layout.preferred-height;
                                            confirm-body-layout := VerticalLayout {
                                                padding-top: 14px;
                                                padding-bottom: 14px;
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                spacing: 0px;
                                                Text {
                                                    text: root.confirm-title;
                                                    color: Theme.text;
                                                    font-size: 13.5px;
                                                    font-weight: 600;
                                                    wrap: word-wrap;
                                                }
                                                Rectangle { height: 6px; }
                                                Caption {
                                                    text: root.confirm-body;
                                                    color: Theme.text-2;
                                                    wrap: word-wrap;
                                                }
                                                Rectangle { height: 12px; }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    alignment: start;
                                                    Button {
                                                        text: root.confirm-action;
                                                        kind: ButtonKind.danger;
                                                        busy: root.rekey-busy;
                                                        clicked => { root.confirm-yes(); }
                                                    }
                                                    Button {
                                                        text: "Cancel";
                                                        enabled: !root.rekey-busy;
                                                        clicked => { root.confirm-no(); }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // Files offered to this device: nothing is kept unless it is
                                    // accepted here, and the person chooses where.
                                    if root.offer-waiting: VerticalLayout {
                                        padding-bottom: 16px;
                                        Rectangle {
                                            height: offer-body.preferred-height;
                                            Glow {
                                                tint: #6D7CFF59;
                                                radius: 18px;
                                                blur: 30px;
                                                lift: 10px;
                                                inset: 10px;
                                            }
                                            Rectangle {
                                                border-radius: 18px;
                                                background: @linear-gradient(135deg, #6D7CFF26 0%, #4FE3C10F 100%);
                                                border-width: 1px;
                                                border-color: #6D7CFF66;
                                                offer-body := HorizontalLayout {
                                                    padding: 16px;
                                                    spacing: 14px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Tile {
                                                            icon: Icons.download;
                                                            on: true;
                                                            size: 44px;
                                                        }
                                                    }
                                                    VerticalLayout {
                                                        alignment: center;
                                                        spacing: 3px;
                                                        horizontal-stretch: 1;
                                                        Text {
                                                            text: root.offer-count > 1
                                                                ? root.offer-from + " Wants to Send You " + root.offer-count + " Files"
                                                                : root.offer-from + " Wants to Send You a File";
                                                            color: Theme.text;
                                                            font-size: 14px;
                                                            font-weight: 700;
                                                            wrap: word-wrap;
                                                        }
                                                        Text {
                                                            text: root.offer-count > 1
                                                                ? root.offer-name + " and " + (root.offer-count - 1) + " more  ·  " + root.offer-size
                                                                : root.offer-name + "  ·  " + root.offer-size;
                                                            color: Theme.text-2;
                                                            font-size: 12.5px;
                                                            overflow: elide;
                                                        }
                                                        Caption {
                                                            text: "You choose where it is saved. Only accept what you expect; Asli never opens files.";
                                                        }
                                                    }
                                                    VerticalLayout {
                                                        alignment: center;
                                                        spacing: 8px;
                                                        Button {
                                                            text: root.offer-count > 1 ? "Accept All…" : "Accept and Save As…";
                                                            kind: ButtonKind.primary;
                                                            icon: Icons.download;
                                                            show-icon: true;
                                                            clicked => { root.accept-offer(); }
                                                        }
                                                        Button {
                                                            text: root.offer-count > 1 ? "Decline All" : "Decline";
                                                            kind: ButtonKind.ghost;
                                                            clicked => { root.decline-offer(); }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    if root.rekey-note != "": VerticalLayout {
                                        padding-bottom: 14px;
                                        Banner {
                                            kind: BannerKind.error;
                                            title: root.rekey-note;
                                        }
                                    }

                                    // Another device on the account runs a newer Asli than this one.
                                    if root.update-note != "": VerticalLayout {
                                        padding-bottom: 14px;
                                        Banner {
                                            kind: BannerKind.warning;
                                            title: "This Device is Not on the Latest Asli";
                                            body: root.update-note;
                                            VerticalLayout {
                                                alignment: center;
                                                Button {
                                                    text: "Download New Version";
                                                    small: true;
                                                    kind: ButtonKind.primary;
                                                    icon: Icons.download;
                                                    show-icon: true;
                                                    clicked => { root.open-releases(); }
                                                }
                                            }
                                        }
                                    }

                                    // An account whose key was once shown as an old style join
                                    // string, which carried the key itself, offers to replace it.
                                    if root.key-exposed && root.confirm-title == "": VerticalLayout {
                                        padding-bottom: 14px;
                                        spacing: 8px;
                                        Banner {
                                            kind: BannerKind.warning;
                                            title: "Replace This Account's Key";
                                            body: "An earlier version showed it as a join string, which may still be in a screenshot or a chat. A new key leaves any old copy useless. Devices that are offline when you do it will need to join again.";
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            Button {
                                                text: "Replace the Key";
                                                busy: root.rekey-busy;
                                                clicked => { root.ask-replace-key(); }
                                            }
                                        }
                                    }

                                    // The connection: what is happening, and the one thing to do about it.
                                    hero-card := Rectangle {
                                        property <color> tone: States.tint(root.sync-state);
                                        height: hero.preferred-height;
                                        Rectangle {
                                            border-radius: 20px;
                                            background: @linear-gradient(135deg, #FFFFFF0F 0%, #FFFFFF05 100%);
                                            border-width: 1px;
                                            border-color: hero-card.tone.with-alpha(0.32);
                                            clip: true;
                                            animate border-color { duration: 600ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

                                            // The state's own colour, as light from the left.
                                            Rectangle {
                                                x: -120px;
                                                y: -140px;
                                                width: 360px;
                                                height: 360px;
                                                background: @radial-gradient(circle, hero-card.tone.with-alpha(0.22) 0%, hero-card.tone.with-alpha(0) 70%);
                                            }

                                            hero := VerticalLayout {
                                                HorizontalLayout {
                                                    padding: 20px;
                                                    spacing: 16px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Rectangle {
                                                            width: 52px;
                                                            height: 52px;
                                                            border-radius: 16px;
                                                            background: hero-card.tone.with-alpha(0.14);
                                                            border-width: 1px;
                                                            border-color: hero-card.tone.with-alpha(0.4);
                                                            StateDot {
                                                                state: root.sync-state;
                                                                hero: true;
                                                            }
                                                        }
                                                    }
                                                    VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        alignment: center;
                                                        spacing: 4px;
                                                        Text {
                                                            text: root.state-label;
                                                            color: States.tint(root.sync-state);
                                                            font-family: Theme.display;
                                                            font-size: 24px;
                                                            font-weight: 600;
                                                            letter-spacing: -0.4px;
                                                        }
                                                        Text {
                                                            text: root.state-detail;
                                                            color: Theme.text-2;
                                                            font-size: 12.5px;
                                                            wrap: word-wrap;
                                                        }
                                                    }
                                                    VerticalLayout {
                                                        alignment: center;
                                                        Button {
                                                            text: root.paused ? "Resume"
                                                                : root.sync-state == SyncState.error ? "Retry Now" : "Pause";
                                                            icon: root.paused ? Icons.play
                                                                : root.sync-state == SyncState.error ? Icons.refresh : Icons.pause;
                                                            show-icon: true;
                                                            kind: root.paused || root.sync-state == SyncState.error ? ButtonKind.primary : ButtonKind.secondary;
                                                            clicked => {
                                                                if (root.paused) {
                                                                    root.set-paused(false);
                                                                } else if (root.sync-state == SyncState.error) {
                                                                    root.retry-now();
                                                                } else {
                                                                    root.set-paused(true);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 12px;
                                                    padding-bottom: 12px;
                                                    spacing: 8px;
                                                    for stat[i] in [
                                                        { key: "CONNECTED", value: root.stat-connections, icon: Icons.device },
                                                        { key: "LAST SYNC", value: root.stat-last-sync, icon: Icons.history },
                                                        { key: "SKIPPED", value: root.stat-skipped, icon: Icons.shield },
                                                    ]: Rectangle {
                                                        horizontal-stretch: 1;
                                                        height: 58px;
                                                        border-radius: 14px;
                                                        background: #FFFFFF08;
                                                        border-width: 1px;
                                                        border-color: Theme.border-subtle;
                                                        HorizontalLayout {
                                                            padding-left: 12px;
                                                            padding-right: 12px;
                                                            spacing: 10px;
                                                            VerticalLayout {
                                                                alignment: center;
                                                                Tile {
                                                                    icon: stat.icon;
                                                                    size: 30px;
                                                                    tint: Theme.text-3;
                                                                }
                                                            }
                                                            VerticalLayout {
                                                                alignment: center;
                                                                spacing: 2px;
                                                                horizontal-stretch: 1;
                                                                Text {
                                                                    height: 14px;
                                                                    text: stat.key;
                                                                    color: Theme.text-3;
                                                                    font-size: 10.5px;
                                                                    font-weight: 700;
                                                                    letter-spacing: 1px;
                                                                    vertical-alignment: center;
                                                                }
                                                                if !root.loading: Text {
                                                                    height: 18px;
                                                                    text: stat.value;
                                                                    color: Theme.text;
                                                                    font-family: Theme.display;
                                                                    font-size: 15px;
                                                                    font-weight: 600;
                                                                    vertical-alignment: center;
                                                                    overflow: elide;
                                                                }
                                                                if root.loading: Skeleton {
                                                                    width: 56px;
                                                                    height: 14px;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // A clip copied while this device was away. Offered, never
                                    // written unasked, because that would overwrite whatever was
                                    // copied here since.
                                    if root.has-retained: VerticalLayout {
                                        padding-top: 14px;
                                        Banner {
                                            kind: BannerKind.info;
                                            icon: Icons.download;
                                            title: "The Relay is Holding a Clip";
                                            body: "Something was copied while this device was away. It isn't written automatically, because that would overwrite what you copied here since.";
                                            VerticalLayout {
                                                alignment: center;
                                                Button {
                                                    text: "Paste It Here";
                                                    small: true;
                                                    clicked => { root.request-retained(); }
                                                }
                                            }
                                        }
                                    }

                                    Rectangle { height: 14px; }

                                    // Files dropped on the window, ready to go to any device, as many
                                    // times as wanted, until Done.
                                    if root.ready-files.length > 0: VerticalLayout {
                                        padding-top: 16px;
                                        Rectangle {
                                            height: ready-body.preferred-height;
                                            Glow {
                                                tint: #4FE3C140;
                                                radius: 18px;
                                                blur: 28px;
                                                lift: 8px;
                                                inset: 10px;
                                            }
                                            Rectangle {
                                                border-radius: 18px;
                                                background: @linear-gradient(135deg, #4FE3C11A 0%, #6D7CFF12 100%);
                                                border-width: 1px;
                                                border-color: #4FE3C152;
                                                ready-body := VerticalLayout {
                                                    padding: 16px;
                                                    spacing: 12px;
                                                    HorizontalLayout {
                                                        spacing: 12px;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Tile {
                                                                icon: Icons.send;
                                                                on: true;
                                                                size: 40px;
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            alignment: center;
                                                            spacing: 2px;
                                                            horizontal-stretch: 1;
                                                            Text {
                                                                height: 20px;
                                                                text: "Ready to Send";
                                                                color: Theme.text;
                                                                font-family: Theme.display;
                                                                font-size: 17px;
                                                                font-weight: 600;
                                                                vertical-alignment: center;
                                                            }
                                                            Text {
                                                                height: 16px;
                                                                text: root.ready-summary;
                                                                color: Theme.text-2;
                                                                font-size: 12px;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Button {
                                                                text: "Done";
                                                                small: true;
                                                                icon: Icons.check;
                                                                show-icon: true;
                                                                clicked => { root.ready-done(); }
                                                            }
                                                        }
                                                    }

                                                    // The files, each removable.
                                                    VerticalLayout {
                                                        spacing: 4px;
                                                        for file[f] in root.ready-files: Rectangle {
                                                            height: 34px;
                                                            border-radius: 10px;
                                                            background: file-touch.has-hover ? #FFFFFF0D : #FFFFFF06;
                                                            animate background { duration: 140ms; }
                                                            file-touch := TouchArea { }
                                                            HorizontalLayout {
                                                                padding-left: 10px;
                                                                padding-right: 4px;
                                                                spacing: 9px;
                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Icon {
                                                                        source: Icons.text;
                                                                        size: 14px;
                                                                        tint: Theme.text-3;
                                                                    }
                                                                }
                                                                Text {
                                                                    text: file.name;
                                                                    color: Theme.text;
                                                                    font-size: 12.5px;
                                                                    vertical-alignment: center;
                                                                    horizontal-stretch: 1;
                                                                    overflow: elide;
                                                                }
                                                                Text {
                                                                    text: file.size;
                                                                    color: Theme.text-3;
                                                                    font-family: Theme.display;
                                                                    font-size: 12px;
                                                                    vertical-alignment: center;
                                                                }
                                                                VerticalLayout {
                                                                    alignment: center;
                                                                    Rectangle {
                                                                        width: 26px;
                                                                        height: 26px;
                                                                        border-radius: 7px;
                                                                        background: remove-touch.has-hover ? #FF4D5E26 : transparent;
                                                                        opacity: file-touch.has-hover || remove-touch.has-hover ? 1 : 0.5;
                                                                        animate background, opacity { duration: 140ms; }
                                                                        Icon {
                                                                            source: Icons.win-close;
                                                                            size: 9px;
                                                                            tint: remove-touch.has-hover ? Theme.danger-soft : Theme.text-2;
                                                                        }
                                                                        remove-touch := TouchArea {
                                                                            mouse-cursor: pointer;
                                                                            clicked => { root.ready-remove(f); }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }

                                                    if root.ready-targets.length > 0: VerticalLayout {
                                                        spacing: 8px;
                                                        Text {
                                                            text: "SEND TO";
                                                            color: Theme.text-3;
                                                            font-size: 10.5px;
                                                            font-weight: 700;
                                                            letter-spacing: 1.2px;
                                                        }
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            alignment: start;
                                                            for target[t] in root.ready-targets: Button {
                                                                text: target.sent ? "Sent to " + target.name : target.name;
                                                                kind: target.sent ? ButtonKind.secondary : ButtonKind.primary;
                                                                icon: target.sent ? Icons.check : Icons.send;
                                                                show-icon: true;
                                                                small: true;
                                                                clicked => { root.ready-send(t); }
                                                            }
                                                            if root.ready-targets.length > 1: Button {
                                                                text: "All Devices";
                                                                small: true;
                                                                icon: Icons.send;
                                                                show-icon: true;
                                                                clicked => { root.ready-send-all(); }
                                                            }
                                                        }
                                                    }
                                                    if root.ready-note != "": Caption {
                                                        text: root.ready-note;
                                                        color: Theme.text-2;
                                                    }
                                                }
                                            }
                                        }
                                    }


                                    Rectangle { height: 22px; }
                                    Overline { text: "PAIRED DEVICES"; }
                                    Rectangle { height: 10px; }
                                    Card {
                                        height: device-list.preferred-height;
                                        device-list := VerticalLayout {
                                            // Inside the card's border, so a row's first pixel is not under it.
                                            padding-top: 1px;
                                            padding-bottom: 1px;
                                            // Whole pixels throughout: a fixed row height, and lines of a fixed
                                            // height inside it, so every centred item lands on a pixel.
                                            for device[i] in root.devices: Rectangle {
                                                // 60 for the row, and a pixel below it for the line between rows.
                                                height: i < root.devices.length - 1 ? 61px : 60px;
                                                accessible-role: list-item;
                                                accessible-label: device.name;
                                                accessible-description: device.os + ", " + device.seen;

                                                device-touch := TouchArea { }

                                                // A row with something on its way to it glows a little.
                                                Rectangle {
                                                    y: 0px;
                                                    height: 60px;
                                                    background: device.send-state == 1 || device.send-state == 2
                                                        ? #6D7CFF12 : device-touch.has-hover ? #FFFFFF06 : transparent;
                                                    animate background { duration: 300ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                                                }

                                                device-row := HorizontalLayout {
                                                    y: 0px;
                                                    height: 60px;
                                                    padding-left: 14px;
                                                    padding-right: 14px;
                                                    spacing: 12px;

                                                    VerticalLayout {
                                                        alignment: center;
                                                        Rectangle {
                                                            width: 36px;
                                                            height: 36px;
                                                            Tile {
                                                                icon: Icons.device;
                                                                on: device.this-device;
                                                                size: 36px;
                                                                tint: Theme.text-2;
                                                            }
                                                            // Online, as a dot on the tile's corner with a cut-out ring.
                                                            Rectangle {
                                                                x: parent.width - 11px;
                                                                y: parent.height - 11px;
                                                                width: 14px;
                                                                height: 14px;
                                                                border-radius: 7px;
                                                                background: #1A1922;
                                                                Rectangle {
                                                                    width: 8px;
                                                                    height: 8px;
                                                                    border-radius: 4px;
                                                                    background: device.online ? Theme.success : Theme.text-4;
                                                                    drop-shadow-color: device.online ? #3DDC97AA : transparent;
                                                                    drop-shadow-blur: 6px;
                                                                }
                                                            }
                                                        }
                                                    }

                                                    VerticalLayout {
                                                        horizontal-stretch: 1;
                                                        min-width: 0px;
                                                        alignment: center;
                                                        spacing: 2px;
                                                        HorizontalLayout {
                                                            height: 20px;
                                                            spacing: 8px;
                                                            alignment: start;
                                                            Text {
                                                                text: device.name;
                                                                color: Theme.text;
                                                                font-size: 13.5px;
                                                                font-weight: 700;
                                                                overflow: elide;
                                                                vertical-alignment: center;
                                                            }
                                                            if device.this-device: VerticalLayout {
                                                                alignment: center;
                                                                Pill {
                                                                    text: "THIS DEVICE";
                                                                }
                                                            }
                                                        }
                                                        HorizontalLayout {
                                                            height: 16px;
                                                            spacing: 0px;
                                                            alignment: start;
                                                            Text {
                                                                text: (device.os != "" ? device.os + "  ·  " : "") + device.seen + "  ·  ";
                                                                color: Theme.text-3;
                                                                font-size: 11.5px;
                                                                vertical-alignment: center;
                                                            }
                                                            Text {
                                                                text: device.version;
                                                                color: device.outdated ? Theme.warning : Theme.text-3;
                                                                font-size: 11.5px;
                                                                vertical-alignment: center;
                                                                overflow: elide;
                                                            }
                                                        }
                                                    }

                                                    if !device.this-device: VerticalLayout {
                                                        alignment: center;
                                                        SendControl {
                                                            state: device.send-state;
                                                            label: device.send-label;
                                                            progress: device.send-progress;
                                                            can-send: device.can-send;
                                                            send => { root.send-file(i); }
                                                            cancel => { root.cancel-device-send(i); }
                                                        }
                                                    }
                                                    if device.removable && device.send-state == 0: VerticalLayout {
                                                        alignment: center;
                                                        IconButton {
                                                            icon: Icons.trash;
                                                            destructive: true;
                                                            label: "Remove " + device.name;
                                                            clicked => { root.ask-remove(i); }
                                                        }
                                                    }
                                                    if device.forgettable: VerticalLayout {
                                                        alignment: center;
                                                        Button {
                                                            text: "Forget";
                                                            small: true;
                                                            kind: ButtonKind.ghost;
                                                            clicked => { root.forget-device(i); }
                                                        }
                                                    }
                                                }

                                                if i < root.devices.length - 1: Rectangle {
                                                    y: parent.height - 1px;
                                                    height: 1px;
                                                    background: Theme.border-subtle;
                                                }
                                            }
                                        }
                                    }


                                    // Files that came to this device.
                                    if root.files.length > 0: VerticalLayout {
                                        padding-top: 22px;
                                        HorizontalLayout {
                                            Overline {
                                                text: "RECEIVED FILES";
                                                vertical-alignment: center;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Button {
                                                text: "Clear";
                                                small: true;
                                                kind: ButtonKind.ghost;
                                                clicked => { root.clear-files(); }
                                            }
                                        }
                                        Rectangle { height: 8px; }
                                        Card {
                                            height: files-list.preferred-height;
                                            files-list := VerticalLayout {
                                                padding-top: 1px;
                                                padding-bottom: 1px;
                                                for file[f] in root.files: Rectangle {
                                                    height: f < root.files.length - 1 ? 57px : 56px;
                                                    file-row := HorizontalLayout {
                                                        y: 0px;
                                                        height: 56px;
                                                        padding-left: 14px;
                                                        padding-right: 14px;
                                                        spacing: 12px;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            Tile {
                                                                icon: Icons.download;
                                                                size: 32px;
                                                                tint: file.good ? Theme.success : file.live ? Theme.accent-2 : Theme.error;
                                                            }
                                                        }
                                                        VerticalLayout {
                                                            horizontal-stretch: 1;
                                                            min-width: 0px;
                                                            alignment: center;
                                                            spacing: 2px;
                                                            Text {
                                                                height: 20px;
                                                                vertical-alignment: center;
                                                                text: file.name;
                                                                color: Theme.text;
                                                                font-size: 13px;
                                                                font-weight: 600;
                                                                overflow: elide;
                                                            }
                                                            Text {
                                                                height: 16px;
                                                                vertical-alignment: center;
                                                                text: file.peer + "  ·  " + file.detail;
                                                                color: file.live || file.good ? Theme.text-3 : Theme.error;
                                                                font-size: 11.5px;
                                                                overflow: elide;
                                                            }
                                                            if file.live: ProgressBar {
                                                                progress: file.progress;
                                                                thickness: 4px;
                                                            }
                                                        }
                                                        if file.live: VerticalLayout {
                                                            alignment: center;
                                                            Button {
                                                                text: "Cancel";
                                                                small: true;
                                                                kind: ButtonKind.ghost;
                                                                clicked => { root.cancel-file(f); }
                                                            }
                                                        }
                                                        if file.can-show: VerticalLayout {
                                                            alignment: center;
                                                            Button {
                                                                text: "Show in Folder";
                                                                small: true;
                                                                clicked => { root.show-file(f); }
                                                            }
                                                        }
                                                    }
                                                    if f < root.files.length - 1: Rectangle {
                                                        y: parent.height - 1px;
                                                        height: 1px;
                                                        background: Theme.border-subtle;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    Rectangle { height: 22px; }

                                    Overline { text: "CONNECTION"; }
                                    Rectangle { height: 8px; }
                                    Card {
                                        height: connection.preferred-height;
                                        connection := VerticalLayout {
                                            padding-top: 14px;
                                            padding-bottom: 14px;
                                            padding-left: 16px;
                                            padding-right: 16px;

                                            DetailRow { key: "Relay"; value: root.relay-url-live; }
                                            DetailRow { key: "Room"; value: root.room-id; }
                                            DetailRow { key: "Device"; value: root.device-id; }
                                            DetailRow { key: "Clipboard"; value: root.clipboard-backend; }
                                            Rectangle { height: 12px; }
                                            HorizontalLayout {
                                                alignment: start;
                                                Button {
                                                    text: "Copy Diagnostics";
                                                    icon: Icons.copy;
                                                    show-icon: true;
                                                    kind: ButtonKind.ghost;
                                                    small: true;
                                                    clicked => { root.copy-diagnostics(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }


                        // ─────────────────────────── Settings ────────────────────────────
                        if root.screen == Screen.Settings: ScreenFrame {
                            Scroller {
                                content-height: settings-screen.preferred-height;

                                settings-screen := VerticalLayout {
                                    padding-top: 20px;
                                    padding-bottom: 24px;
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    spacing: 0px;
                                    alignment: start;

                                    Title { text: "Settings"; }
                                    Rectangle { height: 14px; }

                                    Overline { text: "RELAY"; }
                                    Rectangle { height: 8px; }
                                    Card {
                                        height: relay-card.preferred-height;
                                        relay-card := VerticalLayout {
                                            padding-top: 14px;
                                            padding-bottom: 14px;
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 0px;

                                            Label { text: "Relay Address"; }
                                            Rectangle { height: 6px; }
                                            TextField {
                                                placeholder: "wss://asli.vnat.dev/v1";
                                                monospace: true;
                                                invalid: root.relay-invalid;
                                                text <=> root.relay-url;
                                            }
                                            Rectangle { height: 6px; }
                                            if !root.relay-invalid: Caption {
                                                text: "Passes sealed bytes between your devices. It cannot read them.";
                                            }
                                            if root.relay-invalid: HorizontalLayout {
                                                spacing: 6px;
                                                Icon {
                                                    source: Icons.alert;
                                                    size: 14px;
                                                    tint: Theme.error;
                                                    y: 1px;
                                                }
                                                Caption {
                                                    text: "Must start with wss:// or ws://";
                                                    color: Theme.error;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                            Rectangle { height: 14px; }
                                            Label { text: "Largest Clip to Sync"; }
                                            Rectangle { height: 6px; }
                                            Select {
                                                options: ["1 MB", "4 MB", "16 MB", "32 MB"];
                                                current <=> root.size-cap-index;
                                            }
                                            Rectangle { height: 6px; }
                                            Caption {
                                                text: "Images up to this size sync, full screen captures included; anything bigger is skipped. Text syncs up to 700 KB, the relay's limit for one message.";
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    Rectangle { height: 16px; }
                                    Overline { text: "THIS DEVICE"; }
                                    Rectangle { height: 8px; }
                                    Card {
                                        height: device-card.preferred-height;
                                        device-card := VerticalLayout {
                                            VerticalLayout {
                                                padding-top: 13px;
                                                padding-bottom: 13px;
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                spacing: 0px;
                                                Text {
                                                    text: "Device Name";
                                                    color: Theme.text;
                                                    font-size: 13px;
                                                    font-weight: 500;
                                                }
                                                Rectangle { height: 6px; }
                                                TextField {
                                                    placeholder: "This Computer";
                                                    text <=> root.device-name;
                                                }
                                                Rectangle { height: 6px; }
                                                Caption { text: "How your other devices list this one. Sent to them sealed, like a clip."; }
                                            }
                                            Divider { }
                                            SettingRow {
                                                title: "Notifications";
                                                detail: "A short message when a clip arrives or something goes wrong.";
                                                checked <=> root.notifications;
                                                toggled(on) => { root.set-notifications(on); }
                                            }
                                            SettingRow {
                                                title: "Start at Login";
                                                detail: root.autostart-detail;
                                                mono-detail: true;
                                                checked <=> root.autostart;
                                                toggled(on) => { root.set-autostart(on); }
                                            }
                                            SettingRow {
                                                title: "Same Network Only";
                                                detail: "Approve a new device, and send or receive a file, only when the other device is on this network. Clips still sync from anywhere.";
                                                checked <=> root.same-network-only;
                                                toggled(on) => { root.set-same-network-only(on); }
                                            }
                                            SettingRow {
                                                title: "Keep History";
                                                detail: "Stored on this device only, encrypted with your account key. Anything marked as a password is never recorded.";
                                                checked <=> root.keep-history;
                                                toggled(on) => { root.set-keep-history(on); }
                                            }
                                            VerticalLayout {
                                                padding-top: 13px;
                                                padding-bottom: 13px;
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                spacing: 0px;
                                                Text {
                                                    text: "Keep at Most";
                                                    color: root.keep-history ? Theme.text : Theme.text-4;
                                                    font-size: 13px;
                                                    font-weight: 500;
                                                }
                                                Rectangle { height: 6px; }
                                                Select {
                                                    options: ["25 entries", "50 entries", "100 entries", "250 entries"];
                                                    enabled: root.keep-history;
                                                    current <=> root.retention-index;
                                                }
                                                Rectangle { height: 6px; }
                                                Caption { text: "Older entries are dropped first."; }
                                            }
                                        }
                                    }

                                    Rectangle { height: 14px; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Button {
                                            text: root.settings-saving ? "Saving…" : "Save";
                                            kind: ButtonKind.primary;
                                            pad-x: 18px;
                                            busy: root.settings-saving;
                                            enabled: root.settings-dirty && !root.relay-invalid;
                                            clicked => { root.save-settings(); }
                                        }
                                        Button {
                                            text: "Revert";
                                            kind: ButtonKind.ghost;
                                            pad-x: 16px;
                                            enabled: root.settings-dirty && !root.settings-saving;
                                            clicked => { root.revert-settings(); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        HorizontalLayout {
                                            spacing: 5px;
                                            if root.settings-saved-flash && !root.settings-dirty: VerticalLayout {
                                                alignment: center;
                                                Icon {
                                                    source: Icons.check;
                                                    size: 13px;
                                                    tint: Theme.success;
                                                }
                                            }
                                            Text {
                                                text: root.settings-dirty ? "Unsaved Changes"
                                                    : root.settings-saved-flash ? "Saved" : "All Changes Saved";
                                                color: root.settings-dirty ? Theme.warning
                                                    : root.settings-saved-flash ? Theme.success : Theme.text-4;
                                                font-size: 11.5px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    if root.settings-note != "": VerticalLayout {
                                        padding-top: 10px;
                                        Caption { text: root.settings-note; }
                                    }

                                    Rectangle { height: 20px; }
                                    Overline {
                                        text: "DANGER";
                                        danger: true;
                                    }
                                    Rectangle { height: 8px; }
                                    Rectangle {
                                        border-radius: 14px;
                                        border-width: 1px;
                                        background: #F2555A0D;
                                        border-color: Theme.error-border;
                                        height: danger-card.preferred-height;

                                        danger-card := VerticalLayout {
                                            padding-top: 14px;
                                            padding-bottom: 14px;
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 12px;
                                            Text {
                                                text: root.confirm-leave
                                                    ? "Leave the account on this device? Its account key, device list and history are deleted here. Your other devices take it off their lists and keep working."
                                                    : "Leave This Account signs this device out: its account key, device list and history are deleted here, and your other devices take it off their lists. Joining another account does the same, then joins the new one.";
                                                color: root.confirm-leave ? Theme.text : Theme.text-2;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                            }
                                            if !root.confirm-leave: HorizontalLayout {
                                                alignment: start;
                                                spacing: 8px;
                                                Button {
                                                    text: "Leave This Account";
                                                    kind: ButtonKind.danger;
                                                    clicked => { root.confirm-leave = true; }
                                                }
                                                Button {
                                                    text: "Join Another Account";
                                                    kind: ButtonKind.destructive;
                                                    clicked => { root.confirm-join-other = true; }
                                                }
                                            }
                                            if root.confirm-leave: HorizontalLayout {
                                                alignment: start;
                                                spacing: 8px;
                                                Button {
                                                    text: "Leave";
                                                    kind: ButtonKind.danger;
                                                    clicked => {
                                                        root.confirm-leave = false;
                                                        root.leave-account();
                                                    }
                                                }
                                                Button {
                                                    text: "Cancel";
                                                    kind: ButtonKind.ghost;
                                                    clicked => { root.confirm-leave = false; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // A file dragged over the window: drop it to choose a device.
                        if root.drop-hover: Rectangle {
                            background: #0B0E14E6;
                            Rectangle {
                                x: 16px;
                                y: 16px;
                                width: parent.width - 32px;
                                height: parent.height - 32px;
                                border-radius: 14px;
                                border-width: 2px;
                                border-color: Theme.link;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 10px;
                                    HorizontalLayout {
                                        alignment: center;
                                        Icon {
                                            source: Icons.send;
                                            size: 28px;
                                            tint: Theme.link;
                                        }
                                    }
                                    Text {
                                        text: "Drop to Get It Ready to Send";
                                        color: Theme.text;
                                        font-size: 15px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        // The toast, 16 px above the bottom edge, centred.
                        Toast {
                            x: (parent.width - self.width) / 2;
                            y: parent.height - self.height - (root.toast-shown ? 16px : 8px);
                            text: root.toast-text;
                            good: root.toast-good;
                            shown: root.toast-shown;
                            animate y { duration: 180ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
                        }
                    }
                }
            }

            // Confirmation before leaving this account, over a scrim.
            if root.confirm-join-other: Rectangle {
                background: #00000099;

                TouchArea {
                    clicked => { root.confirm-join-other = false; }
                }

                SoftShadow {
                    x: (parent.width - 420px) / 2;
                    y: (parent.height - dialog.preferred-height) / 2;
                    width: 420px;
                    height: dialog.preferred-height;
                    radius: 14px;
                    offset-y: 12px;
                    blur: 32px;
                    spread: -6px;
                    strength: 0.6;
                    steps: 14;
                }

                Rectangle {
                    width: 420px;
                    height: dialog.preferred-height;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 14px;
                    border-width: 1px;
                    background: Theme.raised-2;
                    border-color: Theme.border;

                    TouchArea { }

                    dialog := VerticalLayout {
                        padding: 20px;
                        spacing: 0px;
                        Text {
                            text: "Join Another Account?";
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 620;
                            letter-spacing: -0.1px;
                        }
                        Rectangle { height: 6px; }
                        Text {
                            text: "This device leaves its current account. Your other devices keep syncing with each other, and the current account can only be rejoined with its join string.";
                            color: Theme.text-2;
                            font-size: 12.5px;
                            wrap: word-wrap;
                        }
                        Rectangle { height: 18px; }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            Button {
                                text: "Cancel";
                                kind: ButtonKind.ghost;
                                clicked => { root.confirm-join-other = false; }
                            }
                            Button {
                                text: "Continue";
                                kind: ButtonKind.danger;
                                clicked => {
                                    root.confirm-join-other = false;
                                    root.open-screen(Screen.Join);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
